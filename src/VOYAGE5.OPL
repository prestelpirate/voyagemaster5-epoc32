    REM' gAt 0,0
	REM' gBox gWidth, gHeight

endp
 
REM' ==============================================================================================================
proc cmdSaveAs:
	REM' ***************************************************************
	REM'              Save Program File As....
	REM'
	REM' ENTERED WITH: NIL
	REM' RETURNS: NIL
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    Local f$(255)         REM' Filename to use for save
    Local CurFile$(255)   REM' Current Filename in use  
    Local offset%(6)      REM' Offsets for Parsing
	REM'
    EXTERNAL ProgFile$    REM' Global Name for current file 


	REM' Set Error Trapping
    ONERR ErrorTrap::

    
	REM' Get the current Filename
	CurFile$=getDoc$

	REM' Get the current Filename
	f$=getDoc$
	f$=parse$(f$,"",offset%())
    REM' Extract just the drive and path
	f$=left$(f$,offset%(4)-1)


	REM' Get the Filename from the User
	f$=SaveAsFileDialog$:(f$,#0)
	if len(f$)>0
	  REM' Copy the existing file to the new filename
      COPY CurFile$,f$
      REM' Set the current file as the new filename
	  setDoc f$
      REM' Set the Global Filename as the new filename
      ProgFile$=f$
      REM' Update the toolbar title
	  UpdateTBarTitle:
	endif	

	RETURN
	REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    ALERT("CmdSaveAs Error "+GEN$(err,10),err$(err))

endp

REM' ==============================================================================================================
proc cmdToolbar:
	REM' ***************************************************************
	REM'                        Show/Hide Toolbar      
	REM'
	REM' ENTERED WITH: NIL
	REM' RETURNS: NIL
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    EXTERNAL TbVis%
    
	REM' Show or Hide the Toolbar according to the current state
	if TbVis%
		TBarHide:
	else
		TBarShow:
	endif

endp

REM' ==============================================================================================================
proc cmdExit:
	REM' ***************************************************************
	REM'                  Exit the Program
	REM'
	REM' ENTERED WITH: NIL
	REM' RETURNS: NIL
	REM' ***************************************************************
	EXTERNAL ExitHK% REM' Global Exit Key


    
    REM' Set the last used fuilename in the INI file
	SetLastUsedFile%:(getdoc$,KUidOplDolphinApp&)
    REM' End the program
	if ExitHK%=%e
		stop
	endif

endp


REM' ==============================================================================================================
proc offrCmd%:(key&,modif&)
	REM' ***************************************************************
	REM'    Offer a Keyboard or Pointer event for evaluation as Menu command etc
	REM'
	REM' ENTERED WITH: key&   -	Key value
    REM'               modif& - Key Modifier value e.g 4 for CTRL hotkey
    REM'
	REM' RETURNS: -1 if command (menu or hot-key) also -1 if menu-key and cancelled
    REM'
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	Local m%				REM' Menu Choice Index
    Local k%				REM' Copy of keypress value
    Local cmdProc$(20)      REM' Name of procedure to call
	Local mod%              REM' Hot Key modifier key 
	Local hotK%			    REM' Menu Item Hot Key
    EXTERNAL MenuPos%       REM' Global Menu Last Position
    EXTERNAL HotKMod%       REM' Global Hot Key Modifier
    EXTERNAL KShiftMod%     REM' Global Shift Key Modifier
	EXTERNAL ExitHK%        REM' Global Exit Key
	EXTERNAL TbMenuSym%	    REM' Toolbar Global Public "Show Toolbar" symbol provided by Psion TBARLINK:
    EXTERNAL gCurrentPage%	REM' Global Current scrren page displayed Index
    EXTERNAL Debug%         REM' Global Debug Flag
	REM'
    EXTERNAL DFLAG%         REM' Global Flag for Update main screen data if true
	EXTERNAL CurrentPage%   REM' Global current Page - governs Menu actions and updating
	EXTERNAL MenuChoice%    REM' Global Menu Item hotkey return code e.g %a

	REM' DEFINE VARIABLES:
	mod%=modif&
	k%=key&
    REM' Set Menu Item chosen to default null
    MenuChoice%=0

	REM' Debug
    REM' ALERT("Offrcmd mod%=",GEN$(mod%,10))
    REM' ALERT("Offrcmd k%=",GEN$(k%,10))
    

	REM' If the current page has no Menu then return -1 but don't show a Menu
    if CurrentPage%=KNullPage%		
 	  return-1
    endif  

	REM' If Menu Key and the Page has a Menu then Show Menu
	if (k%=KKeyMenu%) or (k%=KKeySidebarMenu%)
	  mInit
      REM'
      REM' Main Page Menu
      if CurrentPage%=KMainPage%
	    REM'
        REM' Define Printing cascade first
        mCASC "Printing","Page setup",%U,"Print setup",%P,"Print preview",%V,"Print",%p
        REM'
        REM' File Menu
	    mCard "File","New File",%n,"Open File",%o,"Printing>",16,"Save as"+chr$(KScreenEllipsis%),%S,"Close",ExitHK%
	    REM'
        REM' Data menu
        mCard "Data","Date & Time Zone",%d,"Port & Date",%D,"Nearest Port",%N,"Own Ports",%O,"Output Units",%u,"Courses & Variation",%C,"Draught",%R
        REM'
        REM' Tide Functions
        mCard "Tides","Graphic Tide",%g,"Tide Table",%t,"Single Height",%s,"Angles & Factors",%f
        REM'
        REM' Sailings
        mCard "Sailings","Find Position",%F,"Course & Distance",%c,"Speed & Course mg",%G
        REM'
        REM' Waypoints - Inspect,Enter,Delete
        mCard "Waypoints","Waypoints",%w,"Route",%r
        REM'
        REM' Special - Mode
        mCard "Tools","Mode",%m
	    REM'
        REM' Help Menu (or Debug Menu for program maintenance)
        If Debug%=0
          mCard "Help","Help on Program",%H,"About Program",%A
        ELSE
          mCard "Debug","Help on Program",%H,"Make Help File",%A,"Import OPORTS Text File",%I
        Endif  
	    REM'
      endif
      REM'
      REM' Graphic Page (graphic screen) Menus
      if CurrentPage%=KGraphPage%
	    REM'
        REM' Define Printing cascade first
        mCASC "Printing","Page setup",%U,"Print setup",%P,"Print preview",%V,"Print",%p
        REM'
        REM' File Menu
	    mCard "File","Printing>",16,"Close",ExitHK%
	    REM'
        REM' Data menu
        mCard "Port & Date","Date & Time Zone",%d,"Port & Date",%D,"Next Day",%n,"Previous Day",%b
        REM'
        REM' Tools
        mCard "Tools","Mode",%m,"Nearest Port",%N,"Own Ports",%O,"Output Units",%u
	    REM'
        REM' Help Menu
        mCard "Help","Help on Program",%H,"About Program",%A
        REM'
      endif
      REM'
      REM' Tide Table Page Menus
      if CurrentPage%=KTideTablePage%
	    REM'
        REM' Define Printing cascade first
        mCASC "Printing","Page setup",%U,"Print setup",%P,"Print preview",%V,"Print",%p
        REM'
        REM' File Menu
	    mCard "File","Printing>",16,"Close",ExitHK%
	    REM'
        REM' Data menu
        mCard "Port & Date","Date & Time Zone",%d,"Port & Date",%D,"Next Day",%n,"Previous Day",%b
        REM'
        REM' Tools
        mCard "Tools","Mode",%m,"Nearest Port",%N,"Own Ports",%O,"Output Units",%u
	    REM'
        REM' Help Menu
        mCard "Help","Help on Program",%H,"About Program",%A
        REM'
      endif  
      REM'
      REM' Own Ports Page
      if CurrentPage%=KOwnPortPage%
        REM' Ports Menu
        mCARD "File","New Port",%n,"Edit Port",%E,"Delete Port",%d,"Close",ExitHK%
        REM' Tools Menu
        mCARD "Tools","Find Number",%f,"Find Text",%t
	    REM'
        REM' Help Menu
        mCard "Help","Help on Program",%H,"About Program",%A
      endif
      REM'
      REM'Select Port Page
      if CurrentPage%=KSelectPortPage%
        REM' Ports Menu
        mCARD "File","Close",ExitHK%
        REM' Tools Menu
        mCARD "Tools","Search Ports",%f
	    REM'
        REM' Help Menu
        mCard "Help","Help on Program",%H,"About Program",%A
      endif
      REM'
      REM' Waypoint Page Menus
      if CurrentPage%=KWaypointPage%
	    REM'
        REM' Define Printing cascade first
        mCASC "Printing","Page setup",%U,"Print setup",%P,"Print preview",%V,"Print",%p
        REM' File Menu
	    mCard "File","Printing>",16,"Close",ExitHK%
        REM'Waypoints menu
        mCARD "Waypoints","Add Waypoint",%n,"Edit Waypoint",%E,"Delete Waypoint",%d,"Insert Waypoint",%i
        REM' Tools menu
        mCARD "Tools","Find Number",%f,"Find Text",%t
      endif  
      REM'
      REM' Waypoint Choose Menus
      if CurrentPage%=KWaypChoosePage%
        REM'Waypoints menu
        mCARD "Tools","Find Number",%f,"Find Text",%t,"Close",ExitHK%
	  endif
      REM'
      REM' Route Menu
      if CurrentPage%=KRoutePage%
        REM'
        REM' Define Printing cascade first
        mCASC "Printing","Page setup",%U,"Print setup",%P,"Print preview",%V,"Print",%p
        REM'
        REM' File Menu
	    mCard "File","Printing>",16,"Close",ExitHK%
	  endif
      REM'
      REM' Show the Menu and select the last menu option used (if any)    
	  m%=menu(MenuPos%)
      REM' If a Menu Item was chosen then set the hotkey and modifier key
	  if m%
	    hotK%=m%
        REM' convert to accelerator
	    mod%=HotKMod%
	    if hotK%<=%Z
   	      REM' Shift
	      mod%=mod% or 2
	    endif
      REM' Else User Cancelled the Menu so Return OK
	  else
	    return -1
	  endif
    REM'  
    REM' Else If it was not a menu key then try and convert the keypress into a hot key
    else
      REM' Control+a/A -> 1
      hotK%=k%-1+%a
      REM' If Shift was pressed then put the key into upper case
      if mod% and KShiftMod%
      	hotK%=hotK%-32
      endif 
      REM' ALERT("mod%=",GEN$(mod%,10))
      REM' ALERT("hotk%=",GEN$(hotK%,10))
    endif


    REM' Return the hot key selected
    if mod% and HotKMod%
      REM' Get the choice selected
      MenuChoice%=hotK%
      REM' Command was valid so Return OK
      return -1
    endif
        
REM' Command was not valid so Return failed
return 0


endp

REM' ==============================================================================================================
proc OpenIniFile%:(AppUid&)
	REM' ***************************************************************
	REM'              Open the Program's INI File
	REM'
	REM' ENTERED WITH:  AppUid&    - The APP's Unique ID
    REM'
	REM' RETURNS: handle% or ret% - Handle to opened file or Error code
    REM'
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	Local IniFile$(255)
    Local IniExt$(4)
    Local offset%(6)
	Local handle%
    Local ret%
    Local uidType$(16)

	REM' DEFINE VARIABLES:
    REM' File extension
	IniExt$=".ini"
    REM' Try for INI Filename
	IniFile$=parse$(IniExt$,Cmd$(1),offset%())

	
    if exist(IniFile$)
		ret%=ioopen(handle%,IniFile$,$0300)
		if ret%
			if ret%=-39 REM' Access denied
				return ret%
			else
				goto replace::
			endif
		endif
		ret%=ioread(handle%,addr(uidType$)+1,16)
		if ret%<>16 :goto replace:: :endif
		pokeb addr(uidType$),16
		if (uidType$<>CheckUid$:(0,0,AppUid&))
			goto replace::
		endif
		return handle%
        replace::
		ioclose(handle%)
	endif
    
	ret%=ioopen(handle%,IniFile$,$0302)
	if ret%
      return ret%
    endif
	
    uidType$=CheckUid$:(0,0,AppUid&)
	ret%=iowrite(handle%,addr(uidType$)+1,16)
	if ret%
		ioclose(handle%)
		return ret%
	endif
	return handle%

endp

REM' ==============================================================================================================
proc SetLastUsedFile%:(FileName$,AppUid&)
	REM' ***************************************************************
	REM'        Save the Name of the last used File to the INI file
	REM'
	REM' ENTERED WITH:
    REM'               FileName$  - The last used Filename
    REM'               AppUid&    - The APP's Unique ID
    REM'
	REM' RETURNS: ret% - Return code
    REM'
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	Local f$(255)
	Local handle%
	Local ret%


	REM' DEFINE VARIABLES:
	f$=FileName$


    REM' Open the program INI file
	handle%=OpenIniFile%:(AppUid&)
	if handle%<0
		return handle%
	endif
	ret%=iowrite(handle%,addr(f$),256)
	ioclose(handle%)
	return ret%

endp	

REM' ==============================================================================================================
proc GetLastUsedFile$:(AppUid&)
	REM' ***************************************************************
	REM'      Get the Name of the last used File from the INI file
	REM'
	REM' ENTERED WITH:  AppUid& - The APP's Unique ID
    REM'
	REM' RETURNS: f$ - The last used Filename or "" if none available
    REM'
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	Local f$(255)
	Local handle%
	Local ret%


    REM' Open the program INI file
	handle%=OpenIniFile%:(AppUid&)
	if handle%<0
		return ""
	endif
	ret%=ioread(handle%,addr(f$),256)
	ioclose(handle%)
	if ret%<>256
		return ""
	endif
	return f$

endp
REM' ==============================================================================================================
Proc MidText:(Ycoord%,Text$,Font&,Style%)
	REM' ***************************************************************
	REM'            Show Text centred on the screen
	REM'
	REM' ENTERED WITH:
    REM'				  Ycoord% - Y coordinate in pixels to display at
    REM'				  Text$ - Text to display
    REM'				  Font& - Font to use
    REM'				  Style% - Style to use (0=Normal,1=Bold,2=Underlined,4=Inverse,8=Double Height,32=Italic)
	REM' RETURNS: NIL
    REM'
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    Local Xcoord%      REM' X coord to use
	Local TextWidth%   REM' Width of Text in Pixels

	REM' Set the Font to use
	gfont Font&

	REM' Set the Text Style (Bold, Underlined etc)
    gStyle Style%
    
	REM' Get Width of Text in this Font
    TextWidth%=gTWIDTH(Text$)

	REM' Calculate X coord to place Text in centre of screen
	Xcoord%=(gWidth-TextWidth%)/2
    

	REM' Show text
    gAT Xcoord%,Ycoord%
    gPRINT Text$
    
endp
REM' ==============================================================================================================
Proc cmdHelp:
	REM' ***************************************************************
	REM'	         Show Program Help
    REM'
    REM'
    REM' ENTERED WITH:NIL
    REM'
    REM' RETURNS: NIL
    REM'  
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    EXTERNAL event&()
	REM'
    Local drv$(255)         REM' Current Disk Drive e.g C:
	Local ThreadId&         REM' ID of Thread started for Data App
    Local StatusWord&       REM' Status Word

	REM' Set Error Trapping
    ONERR ErrorTrap::

	REM' Get Name of current disk drive program is being run off
	drv$=LEFT$(CMD$(1),2)
    

    REM' Run the Data Program and Open the Help file
	ThreadId&=RUNAPP&:("Data",drv$+KHelpFile$,"",0)

    REM' Wait until this program gets back into foreground
    DO
	  getEvent32 event&()
    UNTIL event&(1)=&401
	REM' ALERT("Program came to foreground")

    REM'Close down the Help file in the Data Program
    ENDTASK&:(ThreadId&,0)
	REM' ALERT("Help Closed")

    REM' Return
    RETURN
    
   	REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    REM' If the error was -33 then the user used CLOSE on the Database instead of the Back button - so just exit
    if err=-33
      RETURN
    REM' Else show any unexpected errors  
    else  
      ALERT("CmdHelp Error "+GEN$(err,10),err$(err))
    endif  


endp

REM' ==============================================================================================================
Proc cmdAbout:
	REM' ***************************************************************
	REM'	         Show Program About Text
    REM'
    REM'
    REM' ENTERED WITH:NIL
    REM'
    REM' RETURNS: NIL
    REM'  
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	Local About$(255)
    
	REM' Make up the text string
	About$=""
    About$=About$+"VoyageMaster 5"+CHR$(10)
    About$=About$+"Version "+KAppVersion$+CHR$(10)
    About$=About$+kCountryVer$+CHR$(10)
	About$=About$+"(c)Dolphin M.Software Ltd"+CHR$(10)
    
	REM' Show it in a alert box
	ALERT(About$)


endp

