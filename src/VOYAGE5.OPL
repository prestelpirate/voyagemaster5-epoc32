EXTERNAL SearchPorts:
EXTERNAL Route:
EXTERNAL PrintRoute:(OP%,TotalDist)
EXTERNAL PrintWayp:(OP%)
EXTERNAL WaypInsert:
EXTERNAL STimer%:
EXTERNAL EnTimer%:
EXTERNAL SOpenTimChan:
EXTERNAL SCloseTimChan:
EXTERNAL cleanup%:(er1%)
EXTERNAL FindPos:
EXTERNAL CoDist:
EXTERNAL SpeedCoMg:
EXTERNAL Check$:
EXTERNAL LoadToolBitMaps:
EXTERNAL ReadTextPortFile:


REM' Define constants
REM' Unique Application UID Number (Hex) - change for each application using list of Dolphin UIDs
const KUidOplDolphinApp&=&100001B0
REM' Application Name
const KAppName$="Voyage5"
REM' Application Icon (Picture)
REM' const KDolphinIcon$="z:\System\Opl\SkelOpl.mbm"
const KDolphinIcon$="y:\work\icon\Voyage5.mbm"  REM' EPOC port: icon used at translate time
REM' Set Program Version
const KAppVersion$="1.08"
REM' Set Directory for program Documents to be created in 
const KDocDirectory$="c:\Documents"
REM' User Data file - This file should be placed in \APPS\Voyage5
const KUserFile$="C:\SYSTEM\Apps\voyage5\user"
REM' Set Directory for User Data Files e.g Tidal Heights Data etc
const KFileDirectory$="C:\SYSTEM\Apps\voyage5"
REM'
REM' Development Help Data file Name - stored in development directory so it is backed up
const KDevHelpFile$="\OPL\VOYAGE5\voyhelp"
REM' Proper Help Data file Name - stored in program directory
const KHelpFile$="\SYSTEM\Apps\voyage5\voyage.hlp"
REM'
REM' Start Display x coordinate
const KStartX%=2
REM' Start Display y coordinate
const KStartY%=40
REM' Set Spacing in pixels between lines
const KLineSpace%=23
REM'
REM' Scroll Bar constants
const KScrollArrowHt%=20   REM' Height of Scroll bar Arrows
const KScrollPageHt%=20    REM' Height of Page Up/Down bars on scroll bar
const KScrollStartX%=550   REM' X coord for top left start of body
const KScrollStartY%=0     REM' Y coord for top left start of body
const KScrollHeight%=240   REM' Total Length of scrollbar (including arrows)
const KScrollWidth%=20     REM' Width of scrollbar
REM'
REM' Own Colour constants for SETCOLOR proc
const KBlack%=0
const KGrey%=100
const KWhite%=200
REM'
REM' Printer Text heights in Twips (1 twip=1/20 points or 1/1440 Inches)
const KPrinterNormal%=160
const KPrinterHeading%=330
REM'
REM' Printer Font Names
const KCourier$="Courier"
const KTime$="Times"
const KArial$="Arial"
REM'
REM' Screen page constants
const KMainPage%=1
const KGraphPage%=2
const KTideTablePage%=3
const KOwnPortPage%=4
const KWaypointPage%=5
const KWaypChoosePage%=6
const KSelectPortPage%=7
const KRoutePage%=8
const KNullPage%=100      REM'For pages which do not have a Menu and Buttons
REM'
REM' Port Constants - Number of internal port records & Ports filename
REM' Europe
REM const kPORTF$="PORTS"
REM const kIPORT%=638
REM const kCountryVer$="EUROPEAN Version"
REM' USA
const kPORTF$="USPORTS"
const kIPORT%=267
const kCountryVer$="U.S.A Version"


REM' Initialise the APP
APP SkelOpl,KUidOplDolphinApp&
	REM' Specify the Icon for the APP
	ICON KDolphinIcon$
	REM' Specify the Title and Language for the APP
	CAPTION KAppName$,KLangEnglish%
	REM' Specify the APP as File-based (1) or (unusually) not shown on extras bar (2)
	FLAGS 1
ENDA


REM' ==============================================================================================================
proc main:
	REM' ***************************************************************
	REM' Define Global Variables, create the toolbar and start the Application
	REM'
	REM' ENTERED WITH: NIL
	REM'
	REM'	RETURNS: NIL
	REM'
	REM' ***************************************************************

	REM' DECLARE GLOBAL VARIABLES
	global ScrWid%		                                    REM' Screen width in pixels
	global ScrHght%		                                    REM' Screen height in pixels
	global MenuPos%		                                    REM' last menu position
    global GCurrentWin%								        REM' ID of Current Window in use
	global HasBord%		                                    REM' -1 if has border
	                                                        REM' For portability with Sibo
	global HotKMod%                                         REM' modifier for hot-key; Psion-key on sibo, Control-key on era
    global KShiftMod%                                       REM' Global Shift Key Modifier
	global ExitHK%	                                        REM' Hot-key for exit command
    global evType&				                            REM' Event type
	global event&(16)                                       REM' Event	data
    global GButtontext$(4,20)                               REM' Button Titles
    global GButtonkey%(4)                                   REM' Button Hot Key ASCII codes
    global gCurrentPage%							        REM' Number of current Page displayed - 1 or 2
    global gUser$(50)								        REM' Global Name of current User of program
    REM'
	global Debug%                                           REM' Debug Flag - set to -1 (True) for Debug mode 
    REM'
    global ProgFile$(255)                                	REM' Global Filename for current Program File
	REM' VOYAGEMASTER 5 GLOBALS
    global dx,dy
    global CANG,CRNG
    global VY(21)							   REM' Global Array for True/Magnetic etc
    global am2,fm2,as2,fs2,ak1,fk1,ao1,fo1     REM' Global Tidal Angles & Factors
    global DN,GHA,ST,HO,HA,RV,OB,RA,NL         REM' Global Variables for Sun & Moon prediction
    global AZ,DT,IA,IO                         REM' Global Variables for Waypoints: and cd:    
    global MF%                                 REM' Global Tide height output units - set to 0 for Metres or 1 for feet
	global CurrentPage%                        REM' Global current Page - governs Menu actions and updating
	global MenuChoice%                         REM' Global Menu Item hotkey return code e.g %a or Zero
	global GButChoice%                         REM' Global Button number chosen or Zero
    global DFLAG%                              REM' Global Flag for Update main screen data if true
    global GEventStat%                         REM' Global Asynchronous Event request status word 
    global GEventReqFlag%                      REM' Global Flag set to KTrue% if request for event has been made
    global GTimerStat%                         REM' Global Asynchronous Timer request status word 
    global GTimerReqFlag%                      REM' Global Flag set to KTrue% if request for Timer has been made
    global GTimerChan%                         REM' Global Timer Channel ID
	global GTimerComp%                         REM' Global Timer completed Flag - set to KTrue% if Timer completed
	REM'
	global GBarBit&(8)       REM' Toolbar Icon IDs
    global GBarMask&(8)      REM' Toolbar Mask IDs


REM'''''''''''''''''''''''''''ANTI - REVTRAN Code '''''''''''''''''''''''''''''
GOTO START
REM'
PRINT "ANTIREVTRAN START"
PRINT "RUBBISH"
PRINT "RUBBISH"
PRINT "RUBBISH"
PRINT "ANTIREVTRAN END"
REM'
START::
REM' REM'''''''''''''''END OF ANTI - REVTRAN Code '''''''''''''''''''''''''''''



    REM' DEFINE GLOBAL VARIABLES
    REM' Set Debug ON
    Debug%=-1
    REM' Set Debug OFF
    REM' Debug%=0
    REM
	REM' Set the current Window ID (1=Console)
	HasBord%=-1
	REM' Set the CTRL key to be the Hot key
	HotKMod%=4
	REM' Set the SHIFT key to be exactly that!
    KShiftMod%=2
   	REM' Set the Close Hot key as "e" on Series 5
	ExitHK%=%e

	REM' Get the Screen Width and Height - must be done before TBarInit:
	ScrWid%=gWidth
	ScrHght%=gHeight

	REM'Load the Bitmaps to use on the Toolbar into memory
    LoadToolBitMaps:


	REM' Load the Toolbar module
	loadm "z:\system\opl\Toolbar"

	REM' Create and 'link' toolbar globals and then call AppCont
	TBarLink:("AppCont")

endp

REM' ==============================================================================================================
proc AppCont:
	REM' ***************************************************************
	REM' Continue from MAIN and start the application
	REM'
	REM' ENTERED WITH: NIL
	REM'
	REM'	RETURNS: NIL
	REM'
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    Local xCoord%               REM' X coordinate of pen Click
    Local yCoord%               REM' Y coordinate of pen Click
    Local Keycode%              REM' Key Code of any key pressed
    Local AutoFlag%             REM' Set to KTrue% in AUTO mode
    REM'
	EXTERNAL event&()           REM' Global Event Value
	EXTERNAL evtype&            REM' Global Event Value
	EXTERNAL GCurrentWin%       REM' Current Window ID
	REM'
    EXTERNAL DFLAG%             REM' Global Flag for Update main screen data if true
	EXTERNAL CurrentPage%       REM' Global current Page - governs Menu actions and updating
	EXTERNAL MenuChoice%        REM' Global Menu Item hotkey return code e.g %a
	EXTERNAL ExitHK%            REM' Global Exit Key
    EXTERNAL Debug%             REM' Global Debug Flag
    EXTERNAL GButChoice%        REM' Global Button number chosen or Zero
    EXTERNAL GTimerComp%        REM' Global Timer completed Flag - set to KTrue% if Timer completed
	EXTERNAL VY()               REM' GLobal array of settings
     

	REM' DEFINE VARIABLES:
    REM' Set Menu page to Main screen
    CurrentPage%=KMainPage%

	REM' Set Error Trapping
    ONERR ErrorTrap::


	REM' Set Screen Updating Off
	gUpdate off

	REM' Set the Drawing Pen Width
 	gSetPenWidth  2

	REM' Create the toolbar
	initTBar:

    
    REM' Set Flags so all Database files are automatically compressed
    SETFLAGS KAutoCompact&

	REM' Show the start up (Title) screen
	startScreen:

	REM' Wait for an Event - either a key press or pointer tap
	getEvent32 event&()


	REM' Set the current Window to be the default (console) Window
    GCurrentWin%=1

	REM' Get the User's Name from File or ask him for it
    ReadUser:

	REM' Process the Command Line argument (New File etc) and show Toolbar
	ProcessCmdLine:

	REM' Load values from file into VY() array
    OF:(1,0)
      VY(1)=A.TMAG%
      VY(17)=A.VARN
      REM' Leave position decimal places set to 2
      VY(10)=2
    CLOSE

    REM' Show current Data on screen
    DS:

    REM' Set the Toolbar buttons
    ToolBarButt:(KMainPage%)

    REM' Main Continuous Loop
	do
      REM' Set Menu page to Main screen
      CurrentPage%=KMainPage%
	  REM' Set the Pointer Filter to discard Drag and Enter/Exit events as these are not wanted in this application
      REM' N.B This MUST be initialised each time
      POINTERFILTER (KPointerFilterDrag%+KPointerFilterEnterExit%),(KPointerFilterDrag%+KPointerFilterEnterExit%)
      REM'
	  REM' Read the AUTO and other values from file
      OF:(1,0)
        AutoFlag%=A.X
      CLOSE
      REM'  
      REM' Calculate Tides and set redraw flag as required
      If CalcTide:(AutoFlag%)
		DFLAG%=-1
      endif
      REM'
	  REM' If flag set then refresh current Main Screen User data and reset Flag
      IF DFLAG%=-1
        DS:
        DFLAG%=0
        REM' Set the Toolbar buttons
        ToolBarButt:(KMainPage%)
      ENDIF
	  REM'
  	  REM' Wait for the next Event or for the timer to expire in AUTO mode
	  Retevent:(AutoFlag%)
      REM'
	  REM' Use the current screen for graphics output
	  gUse GCurrentWin%
	  REM'
      REM' Set the appropriate Menu choice if a button was pressed
      if GButChoice%<>0
        REM' ALERT("Button pressed=",GEN$(GButChoice%,10))	
	    REM'
        REM'Graph
        if GButChoice%=1
          MenuChoice%=%g
        REM'Tide Table
        elseif GButChoice%=2
          MenuChoice%=%t
        REM'Save As
        elseif GButChoice%=3
          MenuChoice%=%S
        REM' Close
        elseif GButChoice%=4
          MenuChoice%=ExitHK%
        Endif  	
      endif
      REM'
      REM' If it was a valid Menu Choice then select proc to call for required menu option
      if MenuChoice%<>0
        REM'
        REM'
        REM' Files Menu
        REM' New File
        If MenuChoice%=%n
          cmdNewFile:
        REM'
		REM' Open File
        ElseIf MenuChoice%=%o
          cmdOpenFile:
        REM'
        REM' Save File As  
        ElseIf MenuChoice%=%S
          cmdSaveAs:
        REM'
        REM' Exit  
        ElseIf MenuChoice%=ExitHK%
          cmdExit:
        REM'
        REM' Page setup
        ElseIf MenuChoice%=%U
          cmdPageSetup:
        REM'
        REM' Print setup
        ElseIf MenuChoice%=%P
          cmdPrintSetup:
        REM'
        REM' Print preview
        ElseIf MenuChoice%=%V
          PrintWayp:(2)
	    REM'
        REM' Print File       
        ElseIf MenuChoice%=%p
          PrintWayp:(1)
 		REM'
        REM' Help Menu  
        REM' Help
        ElseIf MenuChoice%=%H
          cmdHelp:
        REM' About/Debug Make Help File
        ElseIf MenuChoice%=%A
          if Debug%=0
            cmdAbout:
          else
            MakeHelp:
          endif    
        REM'
		REM'Import OPORTS Text File
        ElseIf MenuChoice%=%I
          if Debug%
            ReadTextPortFile:
		  endif
        REM' Data - Date & Time Zone
        ElseIf MenuChoice%=%d
          DA:(1)
          DFLAG%=-1
        REM'
        REM' Data - Output Units
        ElseIf MenuChoice%=%u
          DA:(3)
          DFLAG%=-1
        REM'
        REM' Data - Port & Date
        ElseIf MenuChoice%=%D
          REM' Show Port Selector
          ti:("Select Port & Date")
          SPORT:(0)
          REM' Show Date & Time Zone
          DA:(1)
          DFLAG%=-1
       REM'
       REM' Data - Nearest Port
       ElseIf MenuChoice%=%N
         REM' Get Lat & Long & Calculate nearest Port
         NPORT:
         DFLAG%=-1
       REM'  
       REM' Data - Own Ports Database
       ElseIf MenuChoice%=%O
         OPORT:
         DFLAG%=-1
       REM'
       REM' Data - Course Mode & Variation
       ElseIf MenuChoice%=%C
         DA:(5)
         DFLAG%=-1
       REM'
       REM'
       REM' Data - Draught
       ElseIf MenuChoice%=%R
         DA:(6)
         DFLAG%=-1
       REM'
       REM' Waypoints
       ElseIf MenuChoice%=%w
         Waypoints:
         DFLAG%=-1
       REM'
       REM'
       REM' Route
       ElseIf MenuChoice%=%r
         Route:
         DFLAG%=-1
       REM'
       REM' Show Angles & Factors
       ElseIf MenuChoice%=%f
         SHOWTAF:
         DFLAG%=-1
       REM'  
       REM' Calculate Single Tide Height
       ElseIf MenuChoice%=%s
         SNGHT:
         REM' Show OK button and wait for Click or Enter key
         WaitForOK:
         DFLAG%=-1
         REM'
       REM'
       REM' Calculate Low waters & High Waters & Display in Text
       ElseIf MenuChoice%=%t
         TTABLE:
         DFLAG%=-1
       REM'   
       REM' Display Graphic Tidal curve
       ElseIf MenuChoice%=%g
         GTIDE:
         DFLAG%=-1
       REM'
       REM' Sailings - Find Posn
       ElseIf MenuChoice%=%F
         FindPos:
         DFLAG%=-1
       REM'
       REM' Sailings - Course & Distance
       ElseIf MenuChoice%=%c
         CoDist:
         DFLAG%=-1
       REM'
       REM' Sailings - Speed & Course Made Good
       ElseIf MenuChoice%=%G
         SpeedCoMg:
         DFLAG%=-1
       REM'  
       REM' Mode - Manual/AUTO
       ElseIf MenuChoice%=%m
         DA:(2)
         DFLAG%=-1
       REM'
       Endif            
       REM'
	   REM' If flag set then show current Main Screen User data
       IF DFLAG%=-1
       	 DS:
         DFLAG%=0
         REM' Set the Toolbar buttons
         ToolBarButt:(KMainPage%)
       ENDIF
       REM'
	 endif
	 REM'
     REM' If the Event was a Pointer Event on the current screen then evaluate it
	 if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
	 	REM' Ignore immediately repeated Pen events
        REM' NOTE:Can also trap pen touching (evType&=KEvPtrEnter&) or leaving screen (evType&=KEvPtrExit&) but these DO NOT return x,y coords 
        REM'
        REM' Get the Pen coords
	    xCoord%=event&(KEvAPtrScreenPosX%)
        yCoord%=event&(KEvAPtrScreenPosY%)
		REM' xCoord%=event&(KEvAPtrPositionX%)
        REM' yCoord%=event&(KEvAPtrPositionY%)
      endif  
      REM'
      REM'
      REM' If the Event was a Keypress then evaluate it
      if ((evType& AND &400)=0)
        KeyCode%=event&(1)	
        REM' ALERT("You pressed a key","Code="+GEN$(KeyCode%,10))
        REM' Carry out any actions required for a valid key
	  endif
	  REM'
      REM' Debug
      REM' GIPRINT GEN$(evType&,10)
      REM'if evType&=1033
      REM'  BEEP 5,300
      REM'endif  
    REM' End of main loop
	until 0

	RETURN
	REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    ALERT("AppCont Error "+GEN$(err,10),err$(err))

endp


REM' ==============================================================================================================
proc startScreen:
	REM' ***************************************************************
