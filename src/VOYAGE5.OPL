REM' ==============================================================================================================
REM'                    VoyageMaster 5 for Psion Series 5 (based on Voyagemaster 3 for Psion Series3)
REM'                              Copyright Waypoint Maritime Software Ltd. UK
REM'
REM' Version 1.0 Started 21/11/97. Finished 12/12/97  
REM' UPDATES:
REM' Version 1.01  14/12/97 
REM' BugFix - correct date not being shown on startup in AUTO mode until a Menu item was used
REM' BugFix - Tide Ht in Feet not working
REM' BugFix - NPORT not working when waypoint used
REM' BugFix - Not able to scroll thro' Ports in SPORT after NPORT used
REM' Added True/Magnetic course mode and Variation Input
REM' STimer - Reduced Timer to 5 seconds so update acts quickly when computer switched back on
REM' Gtide - put Time and height in large text on graphic tide screen using Spoint proc
REM' Improved Main screen DS - now shows Metres/Feet, True/Mag and Variation, DayName
REM' Added extra fields to user Data in OF(1), including spares!
REM' Added filename when printing Waypoints/Route
REM'
REM' Version 1.02 18/12/97
REM' BugFix - GTIDE not retrieving Port Lat,Long for Sunrise/Set prediction
REM' BugFix - CTRL Hot keys not working in OffrCmd
REM' BugFix - CalcTide; not saving updated date properly
REM' BugFix - Page Setup and Print Setup not working in main page
REM' BugFix - Select Port not working in Graphics page
REM' DA() - Added entry of Draft (always stored in metres)
REM' GTIDE - Displayed Draft on curve
REM' 23/12/97 - Trial Version made for Colin Jones - limited by Date - see StartScreen proc
REM'
REM' Version 1.03 30/12/97
REM' BugFix - CTRL+Shift Hot keys not working in OffrCmd
REM' BugFix - OPORT - no response to CANCEL button
REM' SNGHT -  Date now shown in better format rather than D/M/Y
REM'
REM' Version 1.04 16/01/98
REM' Added Icons to Toolbar buttons as follows:
REM' Icons added to Toolbar in ToolbarButt proc
REM' LoadToolBitMaps proc added and BMP.OXH header loaded
REM' Defined global values for Bitmap IDs in MAIN
REM' Made file VOY5BAR.MBM containing bitmaps
REM' Added Nearest Port button to Graphic Tide & Tide Table toolbars
REM'
REM' Version 1.05 02/05/98
REM' Added support for Long filenames in OF: proc
REM'
REM' Version 1.06 10/08/98
REM' BugFix - Changed constant for European Ports to 638 - was missing out Puerto Arrecif!
REM' BugFix - NPORT - Alerted User if No Port found (previously showed "null" Port)
REM' BugFix - SPORT - Not saving properly if User defined Port selected!
REM'
REM' Version 1.07 10/08/98
REM' Added ReadPortTextFile proc to read Own Ports ex Voyagemaster 3 in Text Form
REM' (Set Debug% to ON to run Proc)
REM'
REM' Version 1.07 10/08/98
REM' Added USPORTS data file and made USA version Manual
REM'
REM'
REM'
REM' NOTES: 
REM' DECLARE EXTERNAL is used to ensure variables and procs are properly declared
REM' Series 5 screen is 640 pixels wide by 240 pixels high
REM' The width of the Toolbar in pixels is available in the public global TbWidth%
REM' Create a directory C:\OPL\ProgramName for development and store ALL files in there:-
REM' This avoids problems when creating/loading the default file as this will be c:\documents\ProgramName
REM'
REM' CHANGING BETWEEN UK & USA Versions
REM' 1) Set the constants kIPORT% & kPORTF$ to change between USA & EUROPE
REM'
REM'
REM' CREATING/CHANGING the HELP File
REM' 1) Create/Edit a Text file (e.g SITEHELP.TXT) with help in the format "Title","Explanation.",  on each line
REM' e.g  "Printing","Select the Print button to Print",
REM' 2) Change the Help file name constants if required
REM' 3) Set Debug% to TRUE in MAIN proc and translate program
REM' 4) Select "Make/Edit Help File" in Debug Menu to create the help file using the Data application
REM' 5) In the Data application delete all labels and create two new ones: "Title:" and Explanation"
REM' 6) Merge the Text file created in (1) into this data file.
REM' 7) Delete the empty record at the head of the file
REM' 8) Continue with the proc; the file should now be stored in the application's folder with the filename extension .hlp.
REM' 9) Set Debug% to FALSE in MAIN proc
REM' 10) Copy the help file back from the System\Apps\xxx directory to the source directory
REM'
REM'
REM' PROGRAM PROTECTION
REM' TO ANTI-REVTRAN PROTECT
REM' Use NORTON editor on REVTRAN text in MAIN,OF,WAFCALC - overwrite text with FF 
REM'
REM'
REM' CREATING/CHANGING THE PORTS Files
REM' Port Data Files are : PORTS.DAT (Europe) and USPORTS.DAT (USA)
REM' To create/change the files
REM' Run VOYAGE5.BAS (in this directory) under MS BC7 with the appropriate switch set
REM' This will produce VOYPORT1.OPL, VOYPORT2.OPL or USPORT1.OPL,USPORT2.OPL etc....
REM' Import ..PORTx.OPL as text into the emulator and run each one to produce a new PORTS.DAT file
REM'
REM'
REM' INSTALLING
REM' The program needs the following files in order to run
REM' (They are listed in INSTALL.CTL if on floppy disk or in MAKVOY.OPL for use on CF disk) 
REM'[C:\SYSTEM\Apps\Voyage5\]Voyage5.aif
REM'[C:\SYSTEM\Apps\Voyage5\]Voyage5.app
REM'[C:\SYSTEM\Apps\Voyage5\]Ports.dat   (EUROPEAN Version)
REM'[C:\SYSTEM\Apps\Voyage5\]USPorts.dat (USA Version)
REM'[C:\SYSTEM\Apps\Voyage5\]Voyage.hlp
REM'[C:\SYSTEM\Apps\Voyage5\]Voy5Bar.mbm
REM'[C:\SYSTEM\OPX\]SysRam1.opx	(Make sure this is the ARM version and not the WINS version)
REM'[C:\SYSTEM\Apps\Voyage5\]Voyage5.art (copy protection file)
REM' AND:
REM'[C:\SYSTEM\OPL\]SysRam1.oxh (only required if the program is going to be TRANSLATED on the Series 5)
REM'
REM' TAKING A SCREENSHOT OF THE PROGRAM
REM' Run the program on a Series 5 and press Shift+Ctrl+Fn+S and enter a filename when prompted to save
REM' Copy the file directly from the series 5 to a PC 
REM' Shell out to DOS on the PC
REM' Convert the file to a .BMP file using the BMCONV.EXE utility with the following syntax:
REM' BMCONV /u psifile myfile.bmp
REM' E.g if the Psion file is Voyage5 then you cann convert it using BMCONV /u Voyage5 Temp.bmp
REM'
REM'
REM' ==============================================================================================================

REM' Define Files to include
INCLUDE "system.oxh"
INCLUDE "printer.oxh"
INCLUDE "date.oxh"
INCLUDE "const.oph"
INCLUDE "toolbar.oph"
INCLUDE "sysram1.oxh"
INCLUDE "Bmp.oxh"


REM' Trap any use of variables before they are declared and any invalid calls to procedures
DECLARE EXTERNAL

REM' Declare procedures used in this module
EXTERNAL main:
EXTERNAL AppCont:
EXTERNAL startScreen:
EXTERNAL initTBar:
EXTERNAL Retevent:(X%)
EXTERNAL UpdateTBarTitle:
EXTERNAL border:
EXTERNAL processCmdLine:
