REM' ==============================================================================================================
Proc cmdNewFile:
	REM' ***************************************************************
	REM'	         Create a New program File (Report)
    REM'
    REM'
    REM' ENTERED WITH:NIL
    REM'
    REM' RETURNS: NIL
    REM'  
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    Local cFile$(255) REM' Current path and Filename
    Local f$(255)     REM' New Filename
    Local offset%(6)  REM' Offsets for Parsing


	REM' Make up a suggested filename??

    
	REM' Get the current Filename
	cFile$=getDoc$
	cFile$=parse$(cFile$,"",offset%())
    REM' Extract just the drive and path    
	cFile$=left$(cFile$,offset%(4)-1)


	REM' Get the New Filename from the User
	f$=CreateFileDialog$:(cFile$)
    REM' If the user did not press Esc then create new File
	if len(f$)>0
      REM' Create the New Report
      CreateFile:(f$)
	  REM'
      REM' Load the New Report into global arrays
      OpenFile:(f$)
      REM'
	endif	


    REM' ALERT("cmdNewFile completed")
    

endp

REM' ==============================================================================================================
Proc cmdOpenFile:
	REM' ***************************************************************
	REM'	         Open a program File (Report)
    REM'
    REM'
    REM' ENTERED WITH:NIL
    REM'
    REM' RETURNS: NIL
    REM'  
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    Local cFile$(255) REM' Current path and Filename
    Local f$(255)     REM' New Filename
    Local offset%(6)  REM' Offsets for Parsing

	REM' Get the current Filename
	cFile$=getDoc$
	cFile$=parse$(cFile$,"",offset%())
	cFile$=left$(cFile$,offset%(4)-1) REM' Just the drive and path


	REM' Get the New Filename from the User
	f$=OpenFileDialog$:(cFile$,0,KuidOplDoc&,KUidOplDolphinApp&)
    REM' If the user did not press Esc then open the chosen File
	if len(f$)>0
	  REM' Load the chosen File
      OpenFile:(f$)
	endif	


    REM' ALERT("cmdOpenFile completed")



endp

REM' ==============================================================================================================
Proc cmdPrintFile:
	REM' ***************************************************************
	REM'	         Print a program File (Report)
    REM'
    REM'
    REM' ENTERED WITH:NIL
    REM'
    REM' RETURNS: NIL
    REM'  
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    

	REM' Set Error Trapping
    ONERR ErrorTrap::


	REM' Send current Report Data to Printer object
    PrintReport:

	REM' Show Print Dialog
    PRINTDIALOG:

    REM' Delete anything in the Print buffer - in case the User did not Print
    RESETPRINTING:

	REM' ALERT("cmdPrintFile completed")

    RETURN
    REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    if err=-1
	  ALERT("ERROR - Please check that Print Setup is correct and Remote Link is OFF")
    else	
      ALERT("cmdPrintFile Error "+GEN$(err,10),err$(err))
	endif
	REM' Delete anything in the Print buffer - in case the User did not Print
    RESETPRINTING:

endp

REM' ==============================================================================================================
Proc cmdUser:
	REM' ***************************************************************
	REM'	         Get User Name
    REM'
    REM'
    REM' ENTERED WITH: Globals as defined in EXTERNAL(s)
    REM'
    REM' RETURNS: NIL
    REM'  
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    EXTERNAL gUser$          REM' Global Name of current User of program
    EXTERNAL gCurrentPage%	 REM' Number of current Page displayed - 1 or 2
    REM'
    Local Temp$(50)          REM' Temporary String


	REM' DEFINE VARIABLES:
    REM' User Name
	Temp$=gUser$


	REM' Show Update Dialog
	dINIT "User Name",KDlgFillScreen%
    REM' Position the Dialog
    dPOSITION -1,-1
    REM' User Name
    dEDIT Temp$,"Enter your Name:",50
    REM'
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
    REM'
	REM' If user pressed Enter then update values and save to file
    If DIALOG=KDButtonEnter%
      REM' Update Values
      REM' User Name
	  gUser$=Temp$
      REM'
      REM' Save Values to file
      SaveUserFile:
	  REM'
	  REM' Update Page2 if it is currently shown
      if gCurrentPage%=2
      endif
      REM'  
	endif


	REM' ALERT("CmdUser completed")
    

endp

REM' ==============================================================================================================
Proc OpenFile:(file$)
	REM' ***************************************************************
	REM' Load Program File Data
    REM'
    REM'
    REM' ENTERED WITH: file$ - Full name of file to open
    REM'
    REM' RETURNS: NIL
    REM'  
	REM' NOTES:
    REM'
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    REM'
	Local Index%                 REM' Index
	REM'
    EXTERNAL ProgFile$			 REM' Global Filename for current Program File

	REM'Set Error Trap
    ONERR ErrorTrap::



	REM' Debug
	REM' ALERT("Openfile="+file$)

	REM' Set File$ as the current document
	setdoc file$
    
	
    REM' Set the Global Filename
    ProgFile$=file$
    REM' Open the File as A
    OF:(5,0)
    REM' Close the File
    CLOSE
    
    
	REM' Update the Toolbar Title with the New Filename
	UpdateTBarTitle:


    REM' ALERT("Openfile - File Read OK")

	RETURN

    REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    ALERT("OpenFile Error "+GEN$(err,10),err$(err))
	REM' Try and close the file
    TRAP CLOSE
    
endp

REM' ==============================================================================================================
Proc CreateFile:(file$)
	REM' ***************************************************************
	REM'	                   Create a Waypoints File
    REM'
    REM'
    REM' ENTERED WITH: file$ - Full name of file to create
    REM'
    REM' RETURNS: NIL
    REM'  
	REM' NOTES:
	REM' Record Fields are: iYesNo%,sComment$,sSpare1$,iSpare2%,lSpare3& 
    REM'
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    REM'
    EXTERNAL ProgFile$		REM' Global Filename for current Program Waypoints File
    

	REM' Make sure the required documents directory is present
    TRAP MKDIR KDocDirectory$

	REM' Delete the file if it exists (the user will already have confirmed replacing the file)
    TRAP DELETE FILE$ 

	
	REM' Tell the User what is going on
	BUSY "Creating File"

	REM' Set Document Name so new file incorporates the program UID
    setDoc file$

    REM' Set the filename to create
    ProgFile$=File$
    
	REM' Create and Open the File
    OF:(5,0)
    REM' Close the File
    CLOSE

    REM' Update the toolbar title with the new filename
    UpdateTBarTitle:
   
    REM' Turn the message off
    BUSY OFF

    
   REM' ALERT("CreateFile Created File="+file$)

endp
