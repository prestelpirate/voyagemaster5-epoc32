REM' ==============================================================================================================
Proc MakeWin:
	REM' ***********************************************************************************
	REM'              Make a Screen Window for the Program
    REM'
    REM' ENTERED WITH: NIL
    REM'
    REM'
    REM' RETURNS: WinId% - ID of Window Created
    REM'
    REM'
   	REM' **********************************************************************************
    REM' DECLARE VARIABLES:
	Local WinId%              REM' ID of Window created
	EXTERNAL ScrWid%          REM' Global pixel width initially
	EXTERNAL ScrHght%         REM' Global pixel height initially
    

    
    REM' Create a standard Window in 2 colour mode
    REM' WinId%=gCREATE(0,0,ScrWid%,ScrHght%,KgCreateVisible%,KgCreate2ColourMode%)
    
    REM' Create a standard Window in 4 colour mode
    WinId%=gCREATE(0,0,ScrWid%,ScrHght%,KgCreateVisible%,KgCreate4ColourMode%)

	REM' Debug
    REM' ALERT("Window Created=",GEN$(WinId%,10))

	REM' Return ID of Window
    RETURN WinId%
    
    
    
endp

REM' ==============================================================================================================
Proc ShowScrollBar:
	REM' ***********************************************************************************
	REM'              Show Scroll Bar with Position Indicator
    REM'
    REM' ENTERED WITH: NIL
    REM'
    REM'
    REM' RETURNS: NIL
    REM'
    REM'
   	REM' **********************************************************************************
    REM' DECLARE VARIABLES:
    Local PenWidth%  REM'Width of pen
    
    REM' DEFINE VARIABLES:
	PenWidth%=2

	REM' Set the Drawing Pen Width
 	gSetPenWidth PenWidth%

	REM'Draw a rectangle for the scroll bar body
    REM'
	REM' Draw the rectangle
	REM' Set the pen to the box start coords
    gAT KScrollStartX%,(KScrollStartY%)
    REM' Draw the Box
    gBOX KScrollWidth%,(KScrollHeight%)
    REM'
	REM' Fill the Rectangle
    REM' Set the Pen Drawing Colour to grey
	SetColor:(KGrey%)
	REM' Set the pen to the box start coords, allowing for penwidth
    gAT (KScrollStartX%+PenWidth%),(KScrollStartY%+PenWidth%)
    REM' Fill the Box, allowing for penwidth
    gFILL KScrollWidth%,(KScrollHeight%-PenWidth%*2),0


    REM'Draw the Arrows at Top and Bottom of the scroll bar
    REM' Set the Pen Drawing Colour to black
	SetColor:(KBlack%)
    REM' Top Arrow
    gAT KScrollStartX%,(KScrollStartY%+KScrollArrowHt%)
    gLINEBY (KScrollWidth%/2),(-1*KScrollArrowHt%)
    gLINEBY (KScrollWidth%/2),(KScrollArrowHt%)
    gLINEBY (-1*KScrollWidth%),(0)
    REM' Bottom Arrow
    gAT KScrollStartX%,(KScrollStartY%+KScrollHeight%-KScrollArrowHt%)
    gLINEBY (KScrollWidth%/2),(KScrollArrowHt%)
    gLINEBY (KScrollWidth%/2),(-1*KScrollArrowHt%)
    gLINEBY (-1*KScrollWidth%),(0)
    

    REM'Draw Page Up and Page Down rectangles at Top and Bottom of the scroll bar
    REM' Set the Pen Drawing Colour to black
	SetColor:(KBlack%)
    REM' Top Rectangle
    gAT KScrollStartX%,(KScrollStartY%+KScrollArrowHt%+KScrollPageHt%)
    gLINEBY KScrollWidth%,0
    REM' Bottom Rectangle
    gAT KScrollStartX%,(KScrollStartY%+KScrollHeight%-KScrollArrowHt%-KScrollPageHt%)
    gLINEBY KScrollWidth%,0


    REM'Show the position indicator for position in list


   

endp
REM' ==============================================================================================================
Proc SetColor:(Color%)
	REM' ***********************************************************************************
	REM'            Set Pen Colours fopr Drawing and Filling etc
    REM'
    REM' ENTERED WITH: Color% - Colour to use, defined in constants e.g KBlack%
    REM'
    REM'
    REM' RETURNS: NIL
    REM'
    REM'
   	REM' **********************************************************************************
    REM' DECLARE VARIABLES:
    Local PenWidth%  REM'Width of pen
    
    REM' DEFINE VARIABLES:


    REM' Set the Pen Drawing Colour to Black
	If Color%=KBlack%
      gCOLOR 0,0,0
    REM'  
    REM' Set the Pen Drawing Colour to Grey
	ElseIf Color%=KGrey%
      gCOLOR 198,198,198
    REM'  
    REM' Set the Pen Drawing Colour to White
	ElseIf Color%=KWhite%
      gCOLOR 255,255,255
    endif  


endp
REM' ==============================================================================================================
proc FindDate$:(DateDays&)
	REM' ***************************************************************
	REM'  Convert Integer Date in Days since 1900 to Date String
	REM'
	REM'
	REM'
	REM' ENTERED WITH: DateDays& - Date in Days since 1/1/1900
    REM'
    REM'
	REM' RETURNS: FullDate$ - Date in string from e.g "12th September 1997"
    REM'
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    Local FullDate$(255)     REM'Date in string form e.g "12th September 1997"
    Local AMonth$(56)        REM'Month in string form e.g "September"
	Local Year%				 REM'Year
	Local Month%             REM'Month
	Local Day%               REM'Day 
    Local DayofWeek%         REm' Day Number in Week
    

	REM' Convert Date to Day,Month,Year
    DAYSTODATE DateDays&,Year%,Month%,Day%
    
	REM' Find Day of Week for Date
    REM' Trap Psion DOW limit of 2155
    if Year%<2156
      DayofWeek%=DOW(Day%,Month%,Year%)
    endif
    
    
    REM' Convert Day
	if DayOfWeek%=1
	   FullDate$="Monday"
    elseif DayOfWeek%=2   
	   FullDate$="Tuesday"
    elseif DayOfWeek%=3   
	   FullDate$="Wednesday"
    elseif DayOfWeek%=4   
	   FullDate$="Thursday"
    elseif DayOfWeek%=5   
	   FullDate$="Friday"
    elseif DayOfWeek%=6   
	   FullDate$="Saturday"
    elseif DayOfWeek%=7   
	   FullDate$="Sunday"
    endif   	

	REM' Add Day of Month
	FullDate$=FullDate$+" "+GEN$(Day%,10)

    
    REM' Convert Month
    if Month%=1
       AMonth$="January"
    elseif Month%=2
       AMonth$="February"
    elseif Month%=3
       AMonth$="March"
    elseif Month%=4
       AMonth$="April"
    elseif Month%=5
       AMonth$="May"
    elseif Month%=6
       AMonth$="June"
    elseif Month%=7
       AMonth$="July"
    elseif Month%=8
       AMonth$="August"
    elseif Month%=9
       AMonth$="September"
    elseif Month%=10
       AMonth$="October"
    elseif Month%=11
       AMonth$="November"
    elseif Month%=12
       AMonth$="December"
    endif
	FullDate$=FullDate$+" "+AMonth$
    
    REM' Convert Year
	FullDate$=FullDate$+" "+GEN$(Year%,10)


	REM' Debug
    REM' ALERT ("DateDays&=",GEN$(DateDays&,10))    
    
    REM' Return Date in string form
    RETURN FullDate$    


endp

REM' ==============================================================================================================
Proc SaveUserFile:
	REM' *********************************************************************************************
	REM'                         Save the User Name to file
    REM'
    REM' ENTERED WITH: NIL
    REM'
    REM' RETURNS: NIL
    REM'
    REM'
    REM' NOTES:
    REM'
    REM'
   	REM' *********************************************************************************************
    REM' DECLARE VARIABLES:
	EXTERNAL gUSer$     REM' Global User Name


	REM' Set Error Trapping
    ONERR ErrorTrap::

    REM' Delete any existing file
    TRAP DELETE KUserFile$


    REM' Create and Open the New File
    CREATE KUserFile$,A,User$,Spare1$,Spare2%,Spare3&
      REM' Begin Transaction
      BEGINTRANS
      REM
      REM' Append Records to the file
      A.User$=gUser$
      REM'
      REM' Append Record
      APPEND
      REM' Commit the changes to the file
      COMMITTRANS
    REM' Close the New File
    CLOSE

	RETURN
	REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    ALERT("SaveUserFile Error "+GEN$(err,10),err$(err))

  
endp
REM' ==============================================================================================================
Proc ReadUser:
	REM' *********************************************************************************************
	REM'                         Read the User Name from file (or input it if no name is stored)
    REM'
    REM' ENTERED WITH: NIL
    REM'
    REM' RETURNS: NIL
    REM'
    REM'
   	REM' *********************************************************************************************
    REM' DECLARE VARIABLES:
	EXTERNAL gUSer$     REM' Global User Name


	REM' If a User file exists then read the User's Name
    If EXIST(KUserFile$)
      REM' Open the User File
      OPEN KUserFile$,A,User$,Spare1$,Spare2%,Spare3&
        FIRST
        REM'
        REM' Get User Name
        gUser$=A.User$
        REM'
      REM' Close theFile
      CLOSE
    REM' Else get and save the User's Name
    ELSE
      cmdUser:
    ENDIF  	
        


endp
REM' ==============================================================================================================
Proc SendLine:(Text$)
	REM' ***************************************************************
	REM'	     Send a line of Text to the Printer object
    REM'
    REM'
    REM' ENTERED WITH: Text$ - Text to send
    REM'
    REM' RETURNS: NIL
    REM'  
	REM' NOTES:
    REM'
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
    Local Temp$(255)
    
    REM' DEFINE VARIABLES:
    Temp$=Text$
    
    
	REM' NEVER send a null string as this will cause a GENERAL FAILURE
    REM' If it is a null string then change it to a fex space characters
    if LEN(Temp$)<1
       Temp$="    "
    endif   	

	REM' Send text string to Printer
    SENDSTRINGTOPRINTER:(Temp$)
        
    
	REM' Send New Line character to Printer
    SENDSPECIALCHARTOPRINTER:(KLineBreak%)
    

endp
REM' ==============================================================================================================
Proc SetParagraph:(Font$,Alignment%,Style%,Underline%,Italic%,Height%)
	REM' ***************************************************************
	REM'	     Send Paragraph Settings to the Printer
    REM'
    REM'
    REM' ENTERED WITH:
	REm'                Font$       - Font Name to use on printer e.g "Courier"
    REM'               Alignment%   - Paragraph Alignment e.g left aligned
    REM'                  Style%    - Normal or Bold
    REM'			   Underline%   - Underline ON/OFF
    REM'			   Italic%      - Italic ON/OFF
    REM'			   Height%      - Height of Text in twips (1 twip=1/20 points or 1/1440 inches)
    REM'
    REM' RETURNS: NIL
    REM'  
	REM' NOTES:
    REM'
   	REM' ***************************************************************


	REM' Send a paragraph delimiter character
    SENDSPECIALCHARTOPRINTER:(KParagraphDelimiter%)

	REM' Set the Printer Font to use
	SETFONTNAME:(Font$)

	REM' Set the paragraph alignment
    SETALIGNMENT:(Alignment%)

	REM' Set the Font Height
    SETFONTHEIGHT:(Height%) 

	REM' Set the style
    SETFONTWEIGHT:(Style%)
    
    REM' Set Underline ON/OFF
    SETFONTUNDERLINE:(Underline%)
    
    REM' Set Italic ON/OFF
    SETFONTPOSTURE:(Italic%)

    
    REM' Put the paragraph settings into action
    SETLOCALPARAFORMAT:

endp


REM' ==============================================================================================================
Proc PrintReport:
	REM' ***************************************************************
	REM'    Sends Page 1 of the current Report file to the Printer object
    REM'
    REM'
    REM' ENTERED WITH: Global Values as listed under EXTERNALs below
    REM'
    REM' RETURNS: NIL
    REM'  
	REM' NOTES:
    REM'
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	REM'
	Local Temp$(255)             REM' Temporary string
	REM' DEFINE VARIABLES:
    

	REM' Set Error Trapping
    ONERR ErrorTrap::


	REM' Tell the User what is happening
    BUSY "Arranging Pages"
    

    REM' Delete anything already in the Print buffer
    RESETPRINTING:


	REM' Send the headings to the Printer
    REM' Set Heading Text
    SetParagraph:(KArial$,KPrintCenterAlign%,KStrokeWeightBold%,KUnderlineOff%,KPostureUpright%,KPrinterHeading%)
    SendLine:("VoyageMaster 5")


	REM' Turn Busy off
    BUSY OFF

	REM' Debug
    REM' ALERT("Chars in Print Buffer=",GEN$(PRINTERDOCLENGTH&:,10))

    REM' Exit sub
    RETURN


	REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    ALERT("PrintReport Error "+GEN$(err,10),err$(err))

    
endp
REM' ==============================================================================================================
Proc MakeHelp:
	REM' ***************************************************************
	REM'    Make/Edit a Help File for this Program
    REM'
    REM'
    REM' ENTERED WITH: NIL
    REM'
    REM' RETURNS: NIL
    REM'  
	REM'
   	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	Local drv$(255)         REM' Current Disk Drive e.g C:
	Local ThreadId&         REM' ID of Thread started for Data App


	REM' DEFINE VARIABLES:
	REM' Get Name of current disk drive
	drv$=LEFT$(CMD$(1),2)
    

	REM' Set Error Trapping
    ONERR ErrorTrap::


	REM' Create the File if it does not exist
    If NOT EXIST(drv$+KDevHelpFile$)
	  REM' Alert the user
      ALERT("Creating new Help File")
      REM' Run the Data App and create the file
	  ThreadId&=RUNAPP&:("Data",drv$+KDevHelpFile$,"",1)
      ALERT("FINISHED - Creating new Help File")
	endif
    
	
    REM' Edit the Help file in the development directory
	ThreadId&=RUNAPP&:("Data",drv$+KDevHelpFile$,"",0)
    ALERT("FINISHED - Editing Help File")
    
	REM' Copy the Help File to the program's  APP directory, with the extension .hlp
    COPY (drv$+KDevHelpFile$),(drv$+KHelpFile$)
    
    REM' ALERT("Help file copied to",(drv$+KHelpFile$))

	RETURN

	REM' Error Trapping
    ErrorTrap::
    ONERR OFF
    ALERT("MakeHelp Error "+GEN$(err,10),err$(err))


endp
REM' ==============================================================================================================
PROC WAFCALC:(JD)
REM'=====================================================================
REM'    Program to Calculate Admiralty Harmonic Angles & Factors
REM'         Copyright Waypoint Maritime Software Ltd. April 1994.
REM'
REM'ENTERED WITH: JD- Julian Days since 1900
REM
REM'RETURNS: Angles and Factors for date in Global variables as follows:
REM'am2=M2 Angle
REM'fm2=M2 Factor
REM'as2=S2 Angle
REM'fs2=S2 Factor
REM'ak1=K1 Angle
REM'fk1=K1 Factor
REM'ao1=O1 Angle
REM'fo1=O1 Factor
REM
REM'NOTES:
REM'Algorithms from Admiralty Manual of Tides page 50.
REM'Admiralty Tidal Handbooks NP122(3) Paras 4 & 9 and NP122(1) Table 1. 
REM'Meeus Astronomical Algorithms
REM'And fine tuning by Mike Harrison!
REM'October 1994.
REM'=====================================================================
REM' DECLARE VARIABLES:
Local A,B                                   REM'Temporary variables to solve simultaneous equations
Local N,L,Z,P,T,JT,PP                       REM'Astronomical arguments
Local C,D,E,F,G,H                           REM'Stores for repeated SIN & COS values.
Local Ou,Of,Ku,Kf,Ju,Jf,M2u,M2f,M2v
Local L2u,L2f,K2u,K2f
Local AO,FO,AK,FK,AM,FM,AS,FS
Local w1,w2,w3,w4
REM'
EXTERNAL am2,fm2,as2,fs2,ak1,fk1,ao1,fo1     REM' Global Tidal Angles & Factors


REM'''''''''''''''''''''''''''ANTI - REVTRAN Code '''''''''''''''''''''''''''''
GOTO START
REM'
PRINT "ANTIREVTRAN START"
PRINT "RUBBISH"
PRINT "RUBBISH"
PRINT "RUBBISH"
PRINT "ANTIREVTRAN END"
REM'
START::
REM' REM'''''''''''''''END OF ANTI - REVTRAN Code '''''''''''''''''''''''''''''




REM'Find julian centuries from 1900
JT=JD/36525

REM'Calculate astronomical arguments
REM'Mean Longitude of Moons ascending node
N=259.183275-1934.142*JT+0.002078*JT*JT+0.0000022*JT*JT*JT
REM'Calculate mean long of sun
L=279.6967+36000.7689*JT+303E-6*(JT*JT)
REM'Calculate mean long of moon
Z=270.4342+481267.8831*JT-1133E-6*(JT*JT)
REM'Find T=Julian centuries from 2000
T=JT-1
REM'Calculate mean long of lunar perigee P
P=83.3532430+4069.0137111*T-0.0103238*(T*T)-(T*T*T)/80053+(T*T*T*T)/18999000
REM'Calculate M2v
M2v=(2*L)-(2*Z)
REM'Reduce to 0-360 degrees
M2v=M2v-(INT(M2v/360))*360
M2v=360-M2v
REM'Set PP=282
PP=RAD(282)

REM'Store Sine,Cos etc if repeated for quick calculations
C=SIN(RAD(N))
D=SIN(RAD(2*N))
E=SIN(RAD(3*N))
F=COS(RAD(N))
G=COS(RAD(2*N))
H=COS(RAD(3*N))
w1=RAD(L-Z)
w2=RAD(Z)
w3=RAD(L)
w4=RAD(P)


REM'Calculate u & f for L2
REM'L2 f and u are derived by simultaneous equations (see p52 AMT)
A=-0.2505*SIN(RAD(2*P))-0.1102*SIN(RAD(2*P-N))-0.0156*SIN(RAD(2*P-2*N))-0.0037*C
B=1.00-0.2505*COS(RAD(2*P))-0.1102*COS(RAD(2*P-N))-0.0156*COS(RAD(2*P-2*N))-0.037*F
REM'Find u
L2u=ATAN(A/B)
IF B<0
  L2u=L2u+PI
ENDIF
REM'Find f
L2f=SQR((A*A)+(B*B))

REM'Calculate Angle & Factor for M2
REM
REM'Calculate u & f for M2
REM'Find u
M2u=RAD(-2.14*C)
REM'Find f
m2f=1.0004-0.0373*F+0.0002*G
REM
REM'Total M2,N2,L2,v2,u2,2N2 vectors to find M2 Angle and Factor
REM'Each factor (f) is multiplied by the appropriate magnitude ratio
REM'See NP122(3) Para 4 & 9
REM'Sine vector arguments
REM'M2
A=m2F*sin(2*w1+m2U)
REM'N2
A=A+m2F*0.19146*sin(2*w1-w2+w4+M2u+RAD(15))
REM'2 * N2
A=A+m2f*0.02534*sin(2*w1-2*w2+2*w4+M2u+RAD(30))
REM'U2
A=A+m2f*0.03057*sin(2*w1-2*w2+2*w3+M2u+RAD(30))
REM'V2
A=A+m2f*0.03636*sin(2*w1-w2+2*w3-w4+M2u+RAD(15))
REM'Lamda 2
A=A+m2f*0.00738*sin(2*w1+w2-2*w3+w4+M2u+RAD(165))
REM'L2
A=A+l2f*0.02827*sin(2*w1+w2-w4+l2u+RAD(165))
REM'Cosine vector Arguments
B=m2f*cos(2*w1+M2u)
B=B+m2f*0.19146*cos(2*w1-w2+w4+M2u+RAD(15))
B=B+m2f*0.02534*cos(2*w1-2*w2+2*w4+M2u+RAD(30))
B=B+m2f*0.03057*cos(2*w1-2*w2+2*w3+M2u+RAD(30))
B=B+m2f*0.03636*cos(2*w1-w2+2*w3-w4+M2u+RAD(15))
B=B+m2f*0.00738*cos(2*w1+w2-2*w3+w4+M2u+RAD(165))
B=B+l2f*0.02827*cos(2*w1+w2-w4+l2u+RAD(165))
REM
REM'Find M2 Angle & Factor AM & FM 
AM=ATAN(A/B)
FM=SQR((A*A)+(B*B))
REM'Correct AM to get quadrant & convert to degrees
IF B<0
  AM=AM+PI
ENDIF
AM=360-DEG(AM)
REM'Reduce to 0-360 degrees
IF AM<0
  AM=AM+360
ENDIF
IF AM>360
  AM=AM-360
ENDIF
IF ((M2v-AM)>180) AND ((AM+360-M2v)>70)
  AM=AM+180
ENDIF

REM'Calculate u & f for K2
REM'Find u
K2u=RAD(-17.74*C+0.68*D-0.04*E)
REM'Find f
K2f=1.0246+0.2863*F+0.0083*G-0.0015*H

REM'Calculate angle and factor AS & FS for S2
REM'Total S2,K2,T2 vectors to find S2 Angle and Factor for ATT
REM'Each factor (f) is multiplied by the appropriate magnitude ratio
REM'See NP122(3) Para 4 & 9
REM'Sum Sine vector arguments
REM'T2
A=0.05861*SIN(PP-RAD(L))
REM'K2
A=A+0.27215*K2f*SIN(RAD(2*L)+K2u)
REM'Sum Cosine vector arguments
REM'T2
B=1+0.05861*COS(PP-RAD(L))
REM'K2
B=B+0.27215*K2f*COS(RAD(2*L)+K2u)
AS=ATAN(A/B)
FS=SQR((A*A)+(B*B))
REM'Correct AS for quadrant
IF B<0
  AS=AS+PI
ENDIF
AS=360-DEG(AS)
REM'Reduce to 0-360 degrees
IF AS<0
  AS=AS+360
ENDIF
IF AS>360
  AS=AS-360
ENDIF

REM'Calculate Angle & Factor AO & FO for O1
REM'Find u for O1
Ou=RAD(10.8*C-1.34*D+0.19*E)
REM'Find f for O1
Of=1.0089+0.1871*F-0.0147*G+0.0014*H
REM'Sum Sine vectors for O1
REM'O1
A=Of*sin(w1-w2+Ou-1.5707963)
REM'Q1
A=A+Of*0.19146*sin(w1-2*w2+w4-1.5707963+Ou)
REM'2 Q1
A=A+Of*0.02534*sin(w1-3*w2+2*w4-1.5707963+Ou)
REM'Rho1 
A=A+Of*0.03637*sin(w1-2*w2+2*w3-w4-1.5707963+Ou)
REM'Sigma
A=A+Of*0.03056*sin(w1-3*w2+2*w3-1.5707963+Ou)
REM'Sum Cosine vectors for O1
B=Of*cos(w1-w2+Ou-1.5707963)
B=B+Of*0.19146*cos(w1-2*w2+w4-1.5707963+Ou)
B=B+Of*0.03637*cos(w1-2*w2+2*w3-w4-1.5707963+Ou)
B=B+Of*0.02534*cos(w1-3*w2+2*w4-1.5707963+Ou)
B=B+Of*0.03056*cos(w1-3*w2+2*w3-1.5707963+Ou)
REM
AO=ATAN(A/B)
IF B<0
  AO=AO+PI
ENDIF
AO=DEG(AO)
AO=360-AO
FO=SQR((A*A)+(B*B))

REM'Find u & f for J1
Ju=RAD(-12.94*C+1.34*D-0.19*E)
Jf=1.0129+0.1676*F-0.017*G+0.016*H

REM'Calculate angle and factor AK & FK for K1
REM'Find u
Ku=RAD(-8.86*C+0.68*D-0.07*E)
REM'Find f
Kf=1.006+0.115*F-0.0088*G+0.0006*H
REM'Total K1,P1,J1,M1 vectors to find K1 Angle and Factor for ATT
REM'Each factor (f) is multiplied by the appropriate magnitude ratio
REM'See NP122(3) Para 4
REM'Total sine vector values
REM'K1
A=kf*sin(w1+w2+1.5707963+ku)
REM'P1
A=A+0.01939*sin(w1+w2-3*w3+pp-1.5707963)
A=A+0.33093*sin(w1+w2-2*w3-1.5707963)
A=A+0.01424*sin(w1+w2+2*w3+1.5707963)
REM'J1
A=A+jf*0.05591*sin(w1+2*w2-w4+1.5707963+ju)
REM'Total Cosine vector values
B=kf*cos(w1+w2+1.5707963+ku)
B=B+0.01939*cos(w1+w2-3*w3+pp-1.5707963)
B=B+0.33093*cos(w1+w2-2*w3-1.5707963)
B=B+0.01424*cos(w1+w2+2*w3+1.5707963)
B=B+jf*0.05591*cos(w1+2*w2-w4+1.5707963+ju)
REM
AK=ATAN(A/B)
IF B<0
  AK=AK+PI
ENDIF
AK=360-DEG(AK)
FK=SQR((A*A)+(B*B))

REM'Set return values for TAFs
am2=AM
fm2=FM
as2=AS
fs2=FS
ak1=AK
fk1=FK
ao1=AO
fo1=FO

ENDP
REM' ==============================================================================================================
PROC JDAY:(T,D,M,Y)
REM'==================================================================
REM'       JulDay - Calculate Julian & Siderial Times
REM
REM'Entered with: T - UTC time, D - Day, M -Month, Y -Year
REM
REM'Returns: JT - Julian Days since 1900
REM'         Global ST - GHA Aries
REM
REM'NOTES: 
REM'Divide JT by 36525 i.e JT=JT/36525 for Julian Centuries since 1900
REM'==================================================================
REM' DECLARE VARIABLES:
Local W%,X%,Y%,JT
Local B        REM' Time
Local X
REM'
EXTERNAL ST    REM' Siderial Time


REM'DEFINE VARIABLES:
W%=D
X%=M
Y%=Y
REM'T holds UTC
B=T

IF X%<3 :Y%=Y%-1 :X%=X%+12 :ENDIF
X%=X%+1
JT=INT(Y%/100.0)
JT=2-JT+INT(JT/4.0)
JT=JT+INTF(365.25*Y%)+INT(30.6001*X%)+W%-694025.5
JT=JT+B/24

REM'Calc Siderial Time ST for 0hrs.
X=JT/36525.0
ST=0.276919398+100.0021359*X+1075E-9*(X*X)
ST=ST-INT(ST)
REM'Calc Siderial Time for B Hrs.
ST=360*ST+15.04106862*B

RETURN JT

ENDP
REM' ==============================================================================================================
PROC POLREC:(ANG, RNG)
REM'==================================================================
REM'   Convert Polar to rectangular co-ordinates in nominal VGA screen
REM'
REM'ENTERED WITH:  ANG - Angle in degrees true (0-360)
REM'               RNG - Range of point from datum (+ or - for intercepts)
REM'
REM'RETURNS:  GLOBALS:
REM'          dx - Horizontal graph coordinate about start point
REM'          dy - Vertical graph coordinate about start point
REM'==================================================================
REM'VARIABLES:
Local R   REM'Angle in radians
REM'
EXTERNAL dx REM' Horizontal graph coordinate about start point
EXTERNAL dy REM' Vertical graph coordinate about start point

REM'Define variables
R = RAD(ANG)

REM'Calculate X coordinate
dx = SIN(R) * RNG
REM'Calculate Y coordinate
dy = COS(R) * RNG

REM'Alter sign of Y as it increases DOWNWARDS
dy = -dy

ENDP
REM' ==============================================================================================================
PROC RECPOL:(x, y, tx, ty)
REM'==================================================================
REM'    Convert rectangular to Polar co-ordinates
REM'
REM'ENTERED WITH:
REM'               x% - Start Horizontal graph coordinate
REM'               y% - Start Vertical graph coordinate about start point
REM'              tx% - End Horizontal graph coordinate
REM'              ty% - End Vertical graph coordinate about start point
REM'
REM'RETURNS:       GLOBALS:
REM'               CANG - Angle in degrees true (0-360)
REM'               CRNG - Range of point from datum
REM'==================================================================
REM'VARIABLES:
Local cx
Local cy
REM'cx - Change in x coord
REM'cy - Change in y coord
REM'
EXTERNAL CANG  REM' Angle in degrees true (0-360)
EXTERNAL CRNG  REM' Range of point from datum


REM'Define variables
cx = x - tx
cy = y - ty

REM'Only calculate if the two positions are different - to prevent overflow
IF (cy <> 0) AND (cx <> 0)
  REM'Calculate Angle in 0-360 degrees
  CANG = ATAN(cy / cx)
  REM'Convert to degrees
  CANG = DEG(CANG)
  REM'Put Angle in correct quadrant
  REM'0-180 Quadrant
  IF (cx < 0)
    CANG = CANG + 90
  ENDIF
  REM'180-270 quadrant
  IF cx > 0
    CANG = CANG + 270
  ENDIF
ENDIF

REM'Calculate distance using pythagoras' theorem
CRNG = SQR(cx*cx + cy*cy)

ENDP 
REM' ==============================================================================================================
PROC CALCHT:(TT,PZ,z0,hm2,gm2,hs2,gs2,hk1,gk1,ho1,go1,hf4,gf4,hf6,gf6)
REM'====================================================================================
REM'     Calculate a Single Tidal Height for a given time and Port
REM
REM'ENTERED WITH: 
REM'             TT - UTC Decimal Hour of Time Ht reqd for
REM'             PZ - Port's Time Zone 
REM' z0,hm2,gm2,hs2,gs2,hk1,gk1,ho1,go1,hf4,gf4,hf6,gf6 - Port constants
REM
REM'RETURNS: Height of tide in metres * 100.
REM
REM NOTES: Improved for Series 5, with better interpolation of Angles & Factors
REM'====================================================================================
REM' DECLARE VARIABLES:
Local t                                      REM' Port Zone time for prediction required
Local M2a,R,theta,snM2,snS2,S2,sh4,sh6,K1,O1 REM' TAF values read from file
Local RAF%,NRAF%                             REM' First Day and Second Day Record index to use for angles and factors
Local xam2(2),xfm2(2),xas2(2),xfs2(2),xao1(2),xfo1(2),xak1(2),xfk1(2)  REM' Angles and Factors Arrays
Local pfm2,pfs2,pfo1,pfk1					 REM' Hourly change in Tidal Factors
Local wm2,ws2,wo1,wk1					     REM' Hourly change in Tidal Angles
Local X                                      REM' Temporary variable
REM'
EXTERNAL am2,fm2,as2,fs2,ao1,fo1,ak1,fk1     REM' Global Angles and Factors



REM'DEFINE VARIABLES:    
REM'Calculate Time IN PORT's TIME ZONE for height required - Time = UTC time - Port Time Zone
t=TT-PZ


REM'Choose which 2 sets of Angles & Factors to use for the Day and the next Day
REM'And put t in range 0-24 hours
REM'Default current (Middle) day
RAF%=2
NRAF%=3
REM'
REM'Previous Day
IF t<0
  RAF%=1
  NRAF%=2
  t=t+24
ENDIF  
REM'
REM'Next Day
IF t>24
  RAF%=3
  NRAF%=4
  t=t-24
ENDIF

REM'Read Angles and Factors for the 2 Days required
OF:(3,0)
  REM' For First Day
  POSITION RAF%
  REM'Read values
  xam2(1)=A.am2
  xfm2(1)=A.fm2
  xas2(1)=A.as2
  xfs2(1)=A.fs2
  xao1(1)=A.ao1
  xfo1(1)=A.fo1
  xak1(1)=A.ak1
  xfk1(1)=A.fk1
  REM'
  REM' For Second Day
  POSITION NRAF%
  REM'Read values
  xam2(2)=A.am2
  xfm2(2)=A.fm2
  xas2(2)=A.as2
  xfs2(2)=A.fs2
  xao1(2)=A.ao1
  xfo1(2)=A.fo1
  xak1(2)=A.ak1
  xfk1(2)=A.fk1
REM'Close file
CLOSE


REM' Find Hourly Changes in Angles
REM'Find hourly change in Moon angle
X=xam2(1)-xam2(2)
REM'Add 360 until X>600 (see ATT description)
While X<600
  X=X+360
EndWh
wm2=RAD(X/24)
REM'
REM'Find hourly change in Sun angle
X=xas2(1)-xas2(2)
REM'Add 360 until X>600 (see ATT description)
While X<600
  X=X+360
EndWh
ws2=RAD(X/24)
REM'
REM'Find hourly change in K1 angle
X=xak1(1)-xak1(2)
REM'Add 360 until X>300 (see ATT description)
While X < 300
  X=X+360
EndWh
wk1=RAD(X/24)
REM'
REM'Find hourly change in O1 angle
X=xao1(1)-xao1(2)
REM'Add 360 until X>300 (see ATT description)
While X<300
  X=X+360
EndWh
wo1=RAD(X/24)


REM' Find Hourly changes in Factors
pfm2=(xfm2(2)-xfm2(1))/24
pfs2=(xfs2(2)-xfs2(1))/24
pfo1=(xfo1(2)-xfo1(1))/24
pfk1=(xfk1(2)-xfk1(1))/24


REM' Convert base Day Angles into Radians
am2=RAD(xam2(1))
as2=RAD(xas2(1))
ao1=RAD(xao1(1))
ak1=RAD(xak1(1))



REM' Calculate Factors for this Time
fm2=xfm2(1)+pfm2*t
fs2=xfs2(1)+pfs2*t
fo1=xfo1(1)+pfo1*t
fk1=xfk1(1)+pfk1*t


REM'Calculate Height M2a
M2a=hm2*fm2*cos(am2+gm2-wm2*t)
snM2=hm2*fm2*sin(am2+gm2-wm2*t)
S2=hs2*fs2*cos(as2+gs2-ws2*t)
snS2=hs2*fs2*sin(as2+gs2-ws2*t)
M2a=M2a+S2

snM2=snM2+snS2
REM'Stop divide by zero error
IF M2a=0
  theta=atan(0)
ELSE
  theta=atan(snM2/M2a)
ENDIF
REM' Put value in correct quadrant
IF (M2a<0)
  theta= theta+pi
ENDIF
IF (theta<0)
  theta=theta+(2*pi)
ENDIF
  
REM'Calculate shallow water corrections
REM'Stop divide by zero error
IF theta=0
  R=0
ELSE
  R=snM2/sin(theta)
ENDIF
sh4=hf4*R*R*cos(2*theta+gf4)
sh6=hf6*R*R*R*cos(3*theta+gf6)
REM' Add Shallow Water corrections to the Height
M2a=M2a+sh6+sh4

REM' Calculate K1 and O1 values
K1=hk1*fk1*cos(ak1+gk1-wk1*t)
O1=ho1*fo1*cos(ao1+go1-wo1*t)

REM' Find total Height
M2a=(z0+M2a+K1+O1)*100 


REM' Debug
REM' Show Angles and Factors used
REM' ALERT ("am2=",GEN$(DEG(am2),10))
REM' ALERT ("as2=",GEN$(DEG(as2),10))
REM' ALERT ("ao1=",GEN$(DEG(ao1),10))
REM' ALERT ("ak1=",GEN$(DEG(ak1),10))
REM' ALERT ("fm2=",GEN$(fm2,10))
REM' ALERT ("fs2=",GEN$(fs2,10))
REM' ALERT ("fo1=",GEN$(fo1,10))
REM' ALERT ("fk1=",GEN$(fk1,10))
REM' Show Hourly Angle Changes
REM' ALERT ("wm2=",GEN$(wm2,10))
REM' ALERT ("ws2=",GEN$(ws2,10))
REM' ALERT ("wo1=",GEN$(wo1,10))
REM' ALERT ("wk1=",GEN$(wk1,10))
REM' Show other values
REM' ALERT("z0=",GEN$(z0,10))
REM' ALERT("K1=",GEN$(K1,10))
REM' ALERT("O1=",GEN$(O1,10))
REM' ALERT("M2a=",GEN$(M2a,10))


REM'Return Height * 100
RETURN M2a

ENDP
REM' ==============================================================================================================
PROC O$:(N,V%)
REM'=====================================================================
REM'       Convert Various Numbers/Strings to output A$
REM
REM'ENTERED WITH:
REM'N - Number
REM'V% - Index to type
REM'V%=1 converts number N in decimal degrees to deg.mmm
REM'V%=2 converts number N in decimal hours to hh.mmss
REM'V%=3 converts number N in decimal degrees to Latitude deg.mmm
REM'V%=4 converts number N in decimal degrees to Longtitude deg.mmm
REM'V%=5 converts number N into course/bearing - either T or M
REM'V%=6 converts distances etc to 1 decimal point format
REM'V%=7 converts number N in decimal degrees to Variation decimal degrees E/W
REM'V%=8 converts number N in decimal hours to hh.mm (no seconds).
REM'V%=9 converts number N in decimal metres to string
REM'V%=10 converts number N in decimal metres to decimal feet string
REM
REM'RETURNS:
REM'String A$ at end of procedure
REM'=====================================================================
REM'VARIABLES:
Local A$(16),B,C$(1),D,D$(5),E,F(3),P%,S%,X
REM'P% - Number of decimal places for Lat/Long output
REM'
EXTERNAL VY()   REM' Array of User Values

REM'DEFINE VARIABLES:
P%=VY(10)
B=N
A$=""

REM'Empty keyboard buffer to prevent GET reading excess keystrokes
DO
S%=KEY
UNTIL KEY=0

REM'UT decimal hours to hh.mmss
IF V%=2
  REM'Add zone correction to convert to Zone Time
  B=B-VY(16)
  REM'Reduce into 0-24 hours range
  IF B>24
    B=B-24
  ELSEIF B<0
    B=B+24
  ENDIF
  REM'Xtract minutes D
  D=B-INT(B) :D=D*60 :F(1)=INT(B)
  REM'Xtract seconds E
  E=D-INT(D) :E=E*60 :D=INT(D)
  REM'For times input as 01:02 for instance; round up minutes & seconds
  X=INT(E)
  IF (E-X)>0.9 :E=X+1
    IF E=60 :E=0 :D=D+1 :ENDIF
  ENDIF
  F(2)=D
  F(3)=INT(E)
  REM'Pad out numbers with zeros
  S%=1
  DO
    C$="" :IF F(S%)<10 :C$="0" :ELSEIF F(S%)=0 :C$="00" :ENDIF
    A$=A$+C$+NUM$(F(S%),4)
    IF S%<3 :A$=A$+":" :ENDIF
    S%=S%+1
  UNTIL S%=4
  REM'Add zone indication to time
  REM'Z$=ZT$:
  REM'A$=A$+Z$
ENDIF

REM'decimal deg>dd mm.m
IF V%=1
  IF B>360 :B=B-360 :ENDIF
  IF B<0 :A$="-" :ENDIF
  REM'Xtract degrees
  D=ABS(B) :B=INTF(D)
  REM'Xtract minutes
  D=D-B :D=D*60
  REM'Pad minutes out with zeros
  D$=FIX$(D,1,4) :IF LEN(D$)<4 :D$="0"+D$ :ENDIF
  A$=A$+FIX$(B,0,3)+" "+D$
ENDIF

REM'Decimal deg to Lat or Long
IF V%=3 OR V%=4
  REM'Latitude
  IF V%=3
    C$="N"
    IF B<0 :C$="S" :ENDIF
  ENDIF
  REM'Longitude
  IF V%=4
    C$="E"
    IF B<0 :C$="W" :ENDIF
  ENDIF
  REM'Xtract degrees
  D=ABS(B) :B=INTF(D)
  REM'Xtract minutes
  D=D-B :D=D*60
  REM'Pad minutes out with zeros
  D$=FIX$(D,P%,(3+P%)) :IF LEN(D$)<(3+P%) :D$="0"+D$ :ENDIF
  REM'Make final string
  A$=A$+FIX$(B,0,3)+" "+D$+C$
ENDIF

REM'Course or bearing to 1 decimal place;True or Magnetic
REM'(All courses/Bearings stored/calculated as TRUE)
IF V%=5
C$="T"
REM'If Magnetic selected,apply variation
IF VY(1)=0
  C$="M"
  B=B-VY(17)
ENDIF
REM'Make sure value is in the range 0-360
IF B<0
  B=B+360
ELSEIF B>360
  B=B-360
ENDIF
REM'Convert to string
A$=FIX$(B,1,5)+C$
ENDIF

REM'Output distances
IF V%=6 
  A$=FIX$(N,1,7)+"'" 
ENDIF

REM'Decimal deg>Variation
IF V%=7
  REM'Select E/W
  C$="E"
  IF B<0 :C$="W" :ENDIF
  REM'Xtract degrees
  D=ABS(B)
  REM'Convert into string
  A$=FIX$(D,1,10)+C$
ENDIF

REM'Decimal hours to hh.mm (no seconds)
IF V%=8
  REM'Add zone correction to convert to Zone Time
  REM'B=B-VY(16)
  REM'Reduce into 0-24 hours range
  IF B>24
    B=B-24
  ELSEIF B<0
    B=B+24
  ENDIF
  REM'Xtract minutes D
  D=B-INT(B) :D=D*60 :F(1)=INT(B)
  REM'Xtract seconds E
  E=D-INT(D) :E=E*60 :D=INT(D)
  REM'For times input as 01:02 for instance; round up minutes & seconds
  X=INT(E)
  IF (E-X)>0.9 :E=X+1
    IF E=60 :E=0 :D=D+1 :ENDIF
  ENDIF
  F(2)=D
  F(3)=INT(E)
  REM'Pad out numbers with zeros
  S%=1
  DO
    C$="" :IF F(S%)<10 :C$="0" :ELSEIF F(S%)=0 :C$="00" :ENDIF
    A$=A$+C$+NUM$(F(S%),4)
    IF S%<2 :A$=A$+":" :ENDIF
    S%=S%+1
  UNTIL S%=3
  REM'Add zone indication to time
  REM'Z$=ZT$:
  REM'A$=A$+Z$
ENDIF

REM'Output Heights in Metres to 2 decimal places
IF V%=9 
  A$=FIX$(N,2,8)+"m" 
ENDIF

REM'Output Heights in Metres converted to FEET to 2 decimal places
IF V%=10 
  A$=FIX$((N*3.281),2,8)+"ft" 
ENDIF


REM'Return value in string form
RETURN A$

ENDP
REM' ==============================================================================================================
PROC ZT$:
REM'===================================================================
REM'                   Calculate Zone Time indicator
REM
REM'Entered with: Global variable VY(16); zone time.
REM
REM'Returns: A$ - String for zone time.
REM
REM'===================================================================
REM' DECLARE VARIABLES:
Local A$(7)
REM'
EXTERNAL VY()   REM' Array of User Values



REM'If zone 0 then return "UT"
IF VY(16)=0
  A$=" (UT)"
REM'Else return zone
ELSE
  A$=" (Z"+GEN$(VY(16),3)+")"
ENDIF


RETURN A$

ENDP

REM' ==============================================================================================================
PROC CALCDAY:
REM'================================================================
REM'   Calculate and store to file a full day of heights at fixed intervals.
REM'   (Height calculation used as in CALCHT - for speed)
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM NOTES: Improved for Series 5, with better interpolation of Angles & Factors
REM'================================================================
REM'DECLARE VARIABLES:
Local PZ,z0,hm2,gm2,hs2,gs2,hk1,gk1,ho1,go1,hf4,gf4,hf6,gf6 REM' Port constants ex file
Local I%	 REM' Index
Local PR%    REM' Record number for current port
Local TT     REM' UTC time for prediction
Local ZZ     REM' User Time Zone
REM'Variables as used in CALCHT
Local X,Y                                    REM' Temporary variables
Local t                                      REM' Port Zone time for prediction required
Local xam2(2),xfm2(2),xas2(2),xfs2(2),xao1(2),xfo1(2),xak1(2),xfk1(2)  REM' Angles and Factors Arrays
Local wm2,ws2,wo1,wk1					     REM' Hourly change in Tidal Angles
Local pfm2,pfs2,pfo1,pfk1					 REM' Hourly change in Tidal Factors
Local RAF%,NRAF%                             REM' First Day and Second Day Record index to use for angles and factors
Local M2a,R,theta,snM2,snS2,S2,sh4,sh6,K1,O1 REM' Calculated values
REM'
EXTERNAL am2,fm2,as2,fs2,ak1,fk1,ao1,fo1     REM' Global Tidal Angles & Factors



REM'Show busy
BUSY "Calculating hts"

REM'Retrieve Current Port record number and User Time Zone
OF:(1,0)
  ZZ=A.Z
  PR%=A.PR%
CLOSE


REM'Retrieve Data for Port - all angle in radians
IF PR%<=kIPORT%
  OF:(2,0)
  POSITION PR%
ELSEIF PR%>kIPORT%
  OF:(6,0)
  POSITION (PR%-kIPORT%)
ENDIF
  REM' Debug
  REM' ALERT("Port=",B.N$)
  REM'
  PZ=B.TZ
  z0=B.A%/100.0
  gm2=RAD(B.B%)
  hm2=B.C%/100.0
  gs2=RAD(B.D%)
  hs2=B.E%/100.0
  gk1=RAD(B.F%)
  hk1=B.G%/100.0
  go1=RAD(B.H%)
  ho1=B.I%/100.0
  gf4=RAD(B.J%)
  hf4=B.K%/1000.0
  gf6=RAD(B.L%)
  hf6=B.M%/1000.0
CLOSE

REM'Debug
REM'ALERT("Port Number=",GEN$(PR%,10))
REM'ALERT("Z0=",GEN$(z0,10))
REM'ALERT("go1=",GEN$(go1,10))
REM'ALERT("ho1=",GEN$(ho1,10))


REM'Choose which 2 sets of Angles & Factors to use for the Day and the next Day
REM'Default current (Middle) day
RAF%=2
NRAF%=3

REM'Read Angles and Factors for the 2 Days required
OF:(3,0)
  REM' For First Day
  POSITION RAF%
  REM'Read values
  xam2(1)=A.am2
  xfm2(1)=A.fm2
  xas2(1)=A.as2
  xfs2(1)=A.fs2
  xao1(1)=A.ao1
  xfo1(1)=A.fo1
  xak1(1)=A.ak1
  xfk1(1)=A.fk1
  REM'
  REM' For Second Day
  POSITION NRAF%
  REM'Read values
  xam2(2)=A.am2
  xfm2(2)=A.fm2
  xas2(2)=A.as2
  xfs2(2)=A.fs2
  xao1(2)=A.ao1
  xfo1(2)=A.fo1
  xak1(2)=A.ak1
  xfk1(2)=A.fk1
REM'Close file
CLOSE


REM' Find Hourly Changes in Angles
REM'Find hourly change in Moon angle
X=xam2(1)-xam2(2)
REM'Add 360 until X>600 (see ATT description)
While X<600
  X=X+360
EndWh
wm2=RAD(X/24)
REM'
REM'Find hourly change in Sun angle
X=xas2(1)-xas2(2)
REM'Add 360 until X>600 (see ATT description)
While X<600
  X=X+360
EndWh
ws2=RAD(X/24)
REM'
REM'Find hourly change in K1 angle
X=xak1(1)-xak1(2)
REM'Add 360 until X>300 (see ATT description)
While X < 300
  X=X+360
EndWh
wk1=RAD(X/24)
REM'
REM'Find hourly change in O1 angle
X=xao1(1)-xao1(2)
REM'Add 360 until X>300 (see ATT description)
While X<300
  X=X+360
EndWh
wo1=RAD(X/24)


REM' Find Hourly changes in Factors
pfm2=(xfm2(2)-xfm2(1))/24
pfs2=(xfs2(2)-xfs2(1))/24
pfo1=(xfo1(2)-xfo1(1))/24
pfk1=(xfk1(2)-xfk1(1))/24


REM' Convert base Day Angles into Radians
am2=RAD(xam2(1))
as2=RAD(xas2(1))
ao1=RAD(xao1(1))
ak1=RAD(xak1(1))


REM'Calculate Height of Tide at intervals thro day at 10 minute intervals = 144 records
REM'Open Height Storage File as B
OF:(4,0)
  REM' Select the First record
  FIRST
  REM' Begin Transaction
  BEGINTRANS
  REM'
  REM'Convert User Time to UTC decimal hours
  TT=ZZ
  REM'Calculate Height for 24 hours from midnight
  REM'145 records made as record 1 is 0000 and record 145 is 2400
  I%=0
  REM'Calculate Start Time IN PORT's TIME ZONE for height required - Time = UTC time - Port Time Zone
  t=TT-PZ
  REM' Loop until the required period has been calculated
  DO
    REM'
    REM' Calculate Factors for this Time
    fm2=xfm2(1)+pfm2*t
    fs2=xfs2(1)+pfs2*t
    fo1=xfo1(1)+pfo1*t
    fk1=xfk1(1)+pfk1*t
    REM'
    REM'Calculate Height M2a
    X=am2+gm2-wm2*t
    Y=as2+gs2-ws2*t
    REM'
    M2a=hm2*fm2*cos(X)+hs2*fs2*cos(Y)
	REM' 
    snM2=hm2*fm2*sin(X)+hs2*fs2*sin(Y)
    REM'Stop divide by zero error
    theta=0
    IF M2a<>0
      theta=atan(snM2/M2a)
    ENDIF
    REM'put theta in correct quadrant
    IF (M2a<0)
      theta= theta+pi
    ENDIF
    IF (theta<0)
      theta=theta+(2*pi)
    ENDIF
    REM'Calculate & Apply shallow water corrections
    REM'Stop divide by zero error
    R=0
    IF theta<>0
      R=snM2/sin(theta)
    ENDIF
    REM' Calculate Shallow Water corrections
    sh4=hf4*R*R*cos(2*theta+gf4)
    sh6=hf6*R*R*R*cos(3*theta+gf6)
    REM' Add shallow water corrections to height
    M2a=M2a+sh6+sh4
	REM'
    REM' Calculate K1 and O1 values
    K1=hk1*fk1*cos(ak1+gk1-wk1*t)
    O1=ho1*fo1*cos(ao1+go1-wo1*t)
    REM'
    REM'
    REM'Save Height to file as integer
	REM' Set the mode to modify so the current record is not moved
    MODIFY
    REM' Total the Height and write it to the record
    M2a=z0+M2a+K1+O1
    B.HT%=M2a*100 
    REM' Update the record
    PUT
    REM' Select the next record
    NEXT
    REM'Increment Index
    I%=I%+1
    REM'Increment Time
    t=t+10/60.0
    REM' Debug
    REM'If I%=1 :ALERT("0000 Ht=",GEN$(M2a,10))  :ENDIF
    REM'If I%=145 :ALERT("2400 Ht=",GEN$(M2a,10))  :ENDIF
	REM'
  UNTIL I%=145
REM' Commit the changes to the file
COMMITTRANS
REM' Close the File
CLOSE

REM'Switch busy off
BUSY OFF

REM'Set Flag to show Heights calculated
OF:(1,0)
  A.HOK%=-1
  UPDATE
CLOSE

ENDP
REM' ==============================================================================================================
PROC mp:(A)
REM'=====================================================================
REM'            Find meridianol parts for a given Latitude
REM
REM'ENTERED WITH:
REM'A -  Latitude in degrees
REM
REM'RETURNS:
REM'E - Meridianol parts
REM
REM'=====================================================================
REM'DECLARE VARIABLES:
Local E    REM'Meridianol Parts Value to return

E=RAD(ABS(A))
E=7915.7045*LOG(TAN((PI/4)+E/2))-23.4285*SIN(E)+0.0133*SIN(3*E)

RETURN E

ENDP
REM' ==============================================================================================================
PROC SU:(JT)
REM'================================================================
REM'                 Calculate Sun co-ords
REM
REM'Entered with:
REM'JT - Julian Centuries since 1900
REM
REM'RETURNS: GLobals HA & HO
REM
REM'Sun Co-ords-HA&HO
REM'================================================================
REM' DECLARE VARIABLES:
Local L,M,e,S,v,T,U
EXTERNAL HO,HA    REM' Global Variables for Sun & Moon prediction
REM'
EXTERNAL RV		  REM' Global Radius Vector
EXTERNAL NL       REM' Global Nutation in Longitude


T=JT
U=T*T
L=279.69668+36000.76892*T+3025E-7*U
M=358.47583+35999.04975*T-15E-5*U-33E-7*T*U
e=0.01675104-418E-7*T-126E-9*U
S=1.0000002


REM' Solve Kepler's Equation - returns v=true anom and RV=Global radius vector
v=KP:(M,e,S)
HO=L+v-M

REM'Correct Long for nutation & abberation
HO=HO+NL-0.00569
HA=0

ENDP
REM' ==============================================================================================================
PROC ca:
REM'================================================================
REM'       Calculate coordinates: GHA,Decln,True Az,True Alt of body
REM
REM'Entered with: All data in global values
REM
REM'RETURNS:
REM
REM'================================================================
REM' DECLARE VARIABLES:
Local A,B,C,D,E,X,Y
REM'
EXTERNAL DN,GHA,ST,HO,HA,RV,OB,RA,NL  REM' Global Variables for Sun & Moon prediction

REM'ALL Bodies - Convert HA & HO to DECLN & RA
X=RAD(HO)
Y=RAD(HA)
B=SIN(OB)
C=COS(OB)
D=COS(Y)
E=SIN(Y)
A=COS(X)
X=SIN(X)

IF ABS(D)<1E-20 
  D=1E-20 
ENDIF
DN=ASIN(E*C+D*B*X)
DN=DEG(DN)
RA=X*C-((E/D)*B)
RA=ATAN(RA/A)
IF A<0 
  RA=RA+PI 
ENDIF
RA=DEG(RA)
REM'Find GHA and reduce into 0-360 range
GHA=ST-RA
IF GHA<0
  GHA=GHA+360
ENDIF


ENDP
REM' ==============================================================================================================
PROC KP:(M,Y,S)
REM'================================================================
REM'Solve Keplers equation using Meeus 2nd method
REM
REM'ENTERED WITH:
REM'              M - Mean anomaly
REM'              Y - Eccentricity of body
REM'              S - Semi-major axis
REM
REM'RETURNS: RV=Radius Vector (in Global)
REM'         T=True Anomaly
REM'
REM'================================================================
REM' DECLARE VARIABLES:
Local A,B,E,W,X,Z,T
REM'
EXTERNAL RV

X=DEG(Y)
DO
  Z=E
  W=RAD(Z)
  A=M+X*SIN(W)-Z
  B=1-Y*COS(W)
  E=E+A/B
UNTIL ABS(E-Z)<1E-6

E=RAD(E)

REM'Calc anomaly T
X=(1+Y)/(1-Y)
X=SQR(X)
X=X*TAN(E/2)
T=ATAN(X)
T=DEG(2*T)

REM'Calc radius vector RV
RV=S*(1-Y*COS(E))

RETURN T 

ENDP
REM' ==============================================================================================================
PROC nu:(JT)
REM'================================================================
REM'Calculate Nutation correction for Longtitude=NL
REM'And Obliquity of ecliptic=OB (RADS)
REM
REM'ENTERED WITH: JT - Julian Centuries from 1900
REM
REM'RETURNS: 
REM'         NL - Global Nutation correction for Longtitude
REM'         OB - Global Obliquity of ecliptic in RADIANS
REM
REM'NOTES: Smaller terms neglected
REM'================================================================
REM' DECLARE VARIABLES:
Local A,C,F,G,H,I,J,L,T,U
REM'L&A=2*Sun mean long and anomaly
REM'F&G=2*Moon long,anomaly
REM'H&I=long moon asc node,2*H
REM'J=Nutation of obliquity
REM'
EXTERNAL NL   REM'Global Nutation correction for Longtitude
EXTERNAL OB   REM'Global Obliquity of ecliptic in RADIANS


REM' DEFINE VARIABLES:
T=JT
U=T*T

L=279.6967+36000.7689*T+303E-6*U
L=RAD(2*L)
A=RAD(358.4758+3599.0498*T-15E-5*U)
F=270.4342+481267.8831*T-1133E-6*U
F=RAD(2*F)
G=RAD(296.1046+477198.8491*T+9192E-6*U)
H=259.1833-1934.142*T+2078E-6*U
I=RAD(2*H)
H=RAD(H)


REM'Calculate NL(All numbers*10,000)
NL=-(172327+173.7*T)*SIN(H)-(12729+1.3*T)*SIN(L)
NL=NL+2088*SIN(I)-2037*SIN(F)+(1261-3.1*T)*SIN(A)+675*SIN(G)


REM'Calculate J(All numbers *10,000)
J=(92100+9.1*T)*COS(H)+(5522-2.9*T)*COS(L)
J=J-904*COS(I)+884*COS(F)+216*COS(L+A)+183*COS(F-H)


REM'Convert to degrees
NL=NL/36E+6
J=J/36E+6


REM'Calculate OB in RADS
C=46.845*T+0.00593*U-181E-5*T*U
OB=23.45229444-(C/3600.0)+J
OB=RAD(OB)

ENDP
REM' ==============================================================================================================
PROC OF:(T%,S%)
REM'===================================================================
REM'           Open & Create files for VOYAGEMASTER 3
REM'    It is up to the calling procedure to CLOSE THEM!
REM
REM'ENTERED WITH:
REM'             T% - Type of file to open/create:
REM'              1 - TDATA.DAT  - Current data (Port name etc) file.
REM'              2 - PORTS.DAT or USPORTS.DAT - Port Harmonic data file
REM'              3 - TAFS.DAT   - 3 days of Tidal Angles & Factors
REM'              4 - DAYHT.DAT  - Present day tidal heights at intervals 
REM'              5 - Waypoints File - Name as in ProgFile$
REM'              6 - OPORTS.DAT - Own (User) Port Harmonic Constants
REM'              7 - HWLW.DAT   - 5 sets of Time,Height,Change Type  
REM'             S% - Unused  
REM'             GLOBAL ProgFile$ - Global Filename for current Program Waypoints File
REM'
REM'NOTES:
REM'All User Files and Data Files are stored in the program directory on the internal disk
REM'
REM'===================================================================
REM' DECLARE VARIABLES:
Local A$(255)  	        REM'FileName
Local E%		        REM' 
Local I%                REM'Index
REM'
EXTERNAL ProgFile$		REM' Global Filename for current Program Waypoints File


REM'Set Error Trap
ONERR ERTRAP

REM'''''''''''''''''''''''''''ANTI - REVTRAN Code '''''''''''''''''''''''''''''
GOTO START
REM'
PRINT "ANTIREVTRAN START"
PRINT "RUBBISH"
PRINT "RUBBISH"
PRINT "RUBBISH"
PRINT "ANTIREVTRAN END"
REM'
START::
REM' REM'''''''''''''''END OF ANTI - REVTRAN Code '''''''''''''''''''''''''''''



REM' Make sure that the Files directory is present
TRAP MKDIR KFileDirectory$

REM' Make sure that the Documents directory is present
TRAP MKDIR KDocDirectory$


REM'Current Data as File A (W$ is filename for special UK+US program)
IF T%=1
   REM'TDATA file
   A$=KFileDirectory$+"\TDATA.DAT"
   REM'IF file does not exist then create it  
   IF NOT EXIST(A$)  
     CREATE (""""+A$+""""),A,D,M,Y,TAF%,HOK%,Z,P$,PN$,PR%,V$,W$,X,W,MF%,TMAG%,VARN,DRAFT,SP2,SP3,SP4%,SP5$
   	 REM' Begin Transaction
     BEGINTRANS
     REM'
     REM'Ports filename for UK+US version
     A.W$="PORTS"
     REM
     REM'Day of Month
     A.D=DAY
     REM'Month
     A.M=MONTH
     REM'Year
     A.Y=YEAR
     REM'TAF data calculated for present date +/- 1 day
     A.TAF%=0
     REM'Heights data calculated for present port & day
     A.HOK%=0
     REM'Current User Time zone
     A.Z=0
     REM
     REM'For European Ports
     REM'Current Port Name
     A.P$="ST MARYS"
     REM'Port Number in string form
     A.PN$="0001"
     REM'Port Record number in file
     A.PR%=1
     REM
     REM'For USA Ports
     IF kPORTF$="USPORTS"
       REM'Current Port Name
       A.P$="Port Isabel"
       REM'Port Number in string form
       A.PN$="2585"
       REM'Port Record number in file
       A.PR%=1
     ENDIF
     REM
     REM'Moon phase "Full" etc
     A.V$=""
     REM'Manual (0) or AUTO (Time to switch off in minutes) mode 
     A.X=0
     REM'Moonphase (1-6) Indicator
     A.W=1
     REM'Metres(0) or Feet(1)
     A.MF%=0
     REM'IF USA Ports then set to feet initially
     IF kPORTF$="USPORTS"
       A.MF%=1
     ENDIF
     REM' True(1) or Magnetic(0) course mode
     A.TMAG%=1
     REM' Magnetic Variation
     A.VARN=0
     REM'
     REM' Draft (always stored in metres)
     A.DRAFT=0
     REM'
     APPEND
     REM' Commit the changes to the file
     COMMITTRANS
    CLOSE
  ENDIF
  REM'Open file
  OPEN (""""+A$+""""),A,D,M,Y,TAF%,HOK%,Z,P$,PN$,PR%,V$,W$,X,W,MF%,TMAG%,VARN,DRAFT,SP2,SP3,SP4%,SP5$
  REM'Make sure only first record is selected
  FIRST
ENDIF

REM'PORTS.DAT(Europe) or USPORTS.DAT (USA) as File B
IF T%=2
  REM' File is always on Internal Drive
  A$=KFileDirectory$+"\"+kPORTF$+".DAT"
  REM'ATT Number,Name,Timezone,Lat,Long,Harmonic constants.
  OPEN (""""+A$+""""),B,PN$,N$,TZ,LAT,LON,A%,B%,C%,D%,E%,F%,G%,H%,I%,J%,K%,L%,M%
  FIRST
  REM'
  REM'DEBUG - how many records in File
  REM'ALERT("Record=",GEN$(POS,10))
  REM'LAST
  REM'ALERT("Record=",GEN$(POS,10))
  REM'
  REM'***********************************************
  REM'Check Space on drive - for protection
  REM'For USA Ports
  IF kPORTF$="USPORTS"
    REM'Last value=67233 on 05/06/97
    REM'If wrong space stop program.
    REM'(SPACE< 8000000 allows PC emulator debug with minimum 8MB hard disk free).
    REM' IF SPACE<67100 OR (SPACE>67400 AND SPACE<8000000)
    REM'   E%=ALERT("Program Damaged!","Contact Dolphin","")
    REM'   STOP
    REM' ENDIF
  ENDIF
  REM
  REM'For European Ports
  IF kPORTF$="PORTS"
    REM'Last value=42678 on 05/06/97
    REM'If wrong space stop program.
    REM'(SPACE< 8000000 allows PC emulator debug with minimum 8MB hard disk free).
    REM' IF SPACE<42500 OR (SPACE>42800 AND SPACE<8000000)
    REM'  E%=ALERT("Program Damaged!","Contact Dolphin","")
    REM'   STOP
    REM' ENDIF
  ENDIF
  REM
  REM'***********************************************
ENDIF

REM'Tidal Angles & Factors file - 4 days of records
IF T%=3
  REM'TAFS file
  A$=KFileDirectory$+"\TAFS.DAT"
  REM'IF file does not exist then create it  
  IF NOT EXIST(A$)  
    CREATE (""""+A$+""""),A,AM2,FM2,AS2,FS2,AK1,FK1,AO1,FO1
   	  REM' Begin Transaction
      BEGINTRANS
      REM'am2=M2 Angle
      REM'fm2=M2 Factor
      REM'as2=S2 Angle
      REM'fs2=S2 Factor
      REM'ak1=K1 Angle
      REM'fk1=K1 Factor
      REM'ao1=O1 Angle
      REM'fo1=O1 Factor
      REM'Make 2 records
      A.AM2=1
      APPEND
      A.AM2=2
      APPEND
      A.AM2=3
      APPEND
      A.AM2=4
      APPEND
      REM' Commit the changes to the file
      COMMITTRANS
    CLOSE
  ENDIF
  REM'Open file
  OPEN (""""+A$+""""),A,AM2,FM2,AS2,FS2,AK1,FK1,AO1,FO1
  REM'Make sure first record is selected
  FIRST
ENDIF

REM'Tidal Heights through day at intervals as file B
IF T%=4
  REM'TAFS file
  A$=KFileDirectory$+"\DAYHT.DAT"
  REM'IF file does not exist then create it  
  IF NOT EXIST(A$)  
    CREATE (""""+A$+""""),B,HT%
      REM' Begin Transaction
      BEGINTRANS
      REM'HT%=Height * 100
      REM'Make required number of records -145
      I%=0
      DO 
        B.HT%=1
        APPEND
        I%=I%+1
      UNTIL I%=145
      REM' Commit the changes to the file
      COMMITTRANS
    CLOSE
  ENDIF
  REM'Open file
  OPEN (""""+A$+""""),B,HT%
  REM'Make sure first record is selected
  FIRST
ENDIF


REM' Waypoints File (default program type) as A
IF T%=5
  REm' These files are stored in the Documents directory	
  REM' A$=KDocDirectory$+"\"+ProgFile$
  REM' ALERT("ProgFile$=",ProgFile$)
  A$=ProgFile$
  REM'Create File if not existant
  IF NOT EXIST (A$)
  	REM' Debug
    REM' ALERT("OF - Creating File",ProgFile$)
	REM' Set Document Name so new file incorporates the program UID
    setDoc ProgFile$
	REM' Create the File as A
    REM'Fields in WYPTS=Number,Name,Latitude,Longtitude,Extra name string
    CREATE (""""+A$+""""),A,A%,B$,C,D,E$
    REM' Close the File
    CLOSE
  ENDIF
  REM' Open the File
  OPEN (""""+A$+""""),A,A%,B$,C,D,E$
  FIRST
ENDIF



REM'OPORTS.DBF (Users own entered Ports) as File B
REM'File contains same fields as PORTS.DAT
IF T%=6
  A$=KFileDirectory$+"\OPORTS.DAT"
  REM'Create File if not existant
  IF NOT EXIST (A$)
    REM'ATT Number,Name,Timezone,Lat,Long,Harmonic constants.
    CREATE (""""+A$+""""),B,PN$,N$,TZ,LAT,LON,A%,B%,C%,D%,E%,F%,G%,H%,I%,J%,K%,L%,M%
   	  REM' Begin Transaction
      BEGINTRANS
      B.M%=0
      APPEND
      ERASE
      REM' Commit the changes to the file
      COMMITTRANS
    CLOSE
  ENDIF
  REM' Open the File
  OPEN (""""+A$+""""),B,PN$,N$,TZ,LAT,LON,A%,B%,C%,D%,E%,F%,G%,H%,I%,J%,K%,L%,M%
  FIRST
ENDIF

REM'HW/LW file - 5 records - Opened as A
IF T%=7
  REM'HWLW file
  A$=KFileDirectory$+"\HWLW.DAT"
  REM'IF file does not exist then create it  
  IF NOT EXIST(A$)  
    CREATE (""""+A$+""""),A,CH,HT,TM
      REM' Begin Transaction
      BEGINTRANS
      REM'CH = Change type (0=LW, 1=HW)
      REM'HT = Height at time
      REM'TM = Zone time of change
      REM'Make 5 records
      A.TM=1.0
      APPEND
      A.TM=2.0
      APPEND
      A.TM=3.0
      APPEND
      A.TM=4.0
      APPEND
      A.TM=5.0
      APPEND
      REM' Commit the changes to the file
      COMMITTRANS
    CLOSE
  ENDIF
  REM'Open file
  OPEN (""""+A$+""""),A,CH,HT,TM
  REM'Make sure first record is selected
  FIRST
ENDIF


ONERR OFF
RETURN

REM'''''''''''''''''''''''''
REM'Error Trap
ERTRAP::
ONERR OFF
REM'Inform user of error
ALERT(("OF Error "+GEN$(ERR,4)),ERR$(ERR))

ENDP
REM' ==============================================================================================================
PROC SHOWTAF:
REM'=================================================================
REM'          Show Calculated Angles & Factors
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'=================================================================
REM'DECLARE VARIABLES:
Local JD                    REM' Julian Days since 1900
Local DD,MM,YY	            REM' Date as Day,Month,Year
Local dDate$(255)           REM' Date to Display
Local dDays&                REM' Date in Days from 1/1/1900
REM'
EXTERNAL am2,fm2,as2,fs2,ak1,fk1,ao1,fo1     REM' Global Tidal Angles & Factors


REM' DEFINE VARIABLES:
REM' Get Prediction Date
OF:(1,0)
  DD=A.D
  MM=A.M
  YY=A.Y
CLOSE


REM' Show Title
Ti:("Angles and Factors")


REM' Find Date in Days since 1/1/1900
dDays&=DAYS(DD*1,MM*1,YY*1)
REM' Find Date as a string
dDate$=FindDate$:(dDays&)

REM'Show Date and Time Zone on top line
gAT 10,40
gPRINT dDate$


REM' Calculate the Julian Date
JD=JDAY:(0.0,DD,MM,YY)

REM'Find Angles & Factors
WAFCALC:(JD)
REM'Reduce to 0-360 range
IF am2>360
  am2=am2-360
ENDIF
IF as2>360
  as2=as2-360
ENDIF
IF ak1>360
  ak1=ak1-360
ENDIF
IF ao1>360
  ao1=ao1-360
ENDIF

REM'Show angles & factors for JT
gAT 10,65
gPRINT "M2 Angle=";INT(am2);
gAT 300,65
gPRINT "M2 Factor=";FIX$(fm2,2,10)

gAT 10,90
gPRINT "S2 Angle=";INT(as2);
gAT 300,90
gPRINT "S2 Factor=";FIX$(fs2,2,10)

gAT 10,115
gPRINT "K1 Angle=";INT(ak1);
gAT 300,115
gPRINT "K1 Factor=";FIX$(fk1,2,10)

gAT 10,140
gPRINT "O1 Angle=";INT(ao1);
gAT 300,140
gPRINT "O1 Factor=";FIX$(fo1,2,10)

REM'Wait for Event/Keypress or Click on OK button
WaitForOK:


ENDP
REM' ==============================================================================================================
PROC UPDTAF:(DD,MM,YY)
REM'================================================================
REM'   Update & Store Tidal Angles & Factors for 4 days around chosen Date
REM'        Also Moonphase/Neaps/Springs Indicator.
REM
REM'ENTERED WITH: DD,MM,YY - Day Month and Year for TAFs required.
REM
REM'RETURNS: NIL
REM
REM'================================================================
REM' DECLARE VARIABLES:
Local A,D%,JD,M$(20),MP,X,Y 
REM'A - GP variable
REM'JD - Julian Days since 1900    
REM'D% - Temporary Day increment variable
REM'M$ - Moonphase string
REM'MP - Moonphase
REM'X,Y - AM2 & AS2 for day
REM'
EXTERNAL am2,fm2,as2,fs2,ak1,fk1,ao1,fo1     REM' Global Tidal Angles & Factors

REM'DEFINE VARIABLES:    


REM'Find Julian days from 1900
JD=JDAY:(0.0,DD,MM,YY)

REM'Show busy indication
BUSY "Calculating tafs"

REM'Get TAFs for Day-1,Day,Day+1,Day+2
D%=-1
REM'Open TAFs File
OF:(3,0)    
  REM' Begin Transaction
  BEGINTRANS
  REM' Loop until all records are written
  WHILE D%<3
    REM' Calculate TAFS
    WAFCALC:(JD+D%)
    REM'
    REM' Set the mode to modify so the current record is not moved
    MODIFY
    REM'
    A.AM2=AM2
    A.FM2=FM2
    A.AS2=AS2
    A.FS2=FS2
    A.AK1=AK1
    A.FK1=FK1
    A.AO1=AO1
    A.FO1=FO1
    REM' Update the record
    PUT
    REM' Select the next record
    NEXT
    REM'Store AM2 & AS2 for the actual day
    IF D%=0
      X=AM2
      Y=AS2
    ENDIF
    REM'Increment D%
    D%=D%+1
    REM'
  ENDWH
  REM'
  REM' Commit the changes to the file
  COMMITTRANS
REM' Close the File
CLOSE


REM'Calculate age of moon (If AM2=AS2+/-30  it is a spring tide)
IF X>Y
  A=X-Y
ELSE
  A=Y-X
ENDIF
IF A>180
  A=360-A
ENDIF

REM'Find Approximate Moonphase & hence if Neaps/Springs Tide
REM'Increment Moonphase by 1 for every 30 degrees out. 1=Spring, 6=Neap.
MP=1
WHILE A>29.0
  MP=MP+1
  A=A-30
ENDWH
REM'Limit MP
IF MP>6
  MP=6
ENDIF

REM'Find a more accurate moonphase
M$=MPHASE$:(JD)


REM'ALERT("AM2=",GEN$(AM2,10))
REM'ALERT("AS2=",GEN$(AS2,10))
REM'ALERT("A=",GEN$(A,10))
REM'ALERT("MP=",GEN$(MP,10))

REM'Switch busy off
BUSY OFF

REM'Set Flag to show TAFs calculated and store moonphase
OF:(1,0)
  A.TAF%=-1
  A.W=MP
  A.V$=M$
  UPDATE
CLOSE

ENDP
REM' ==============================================================================================================
PROC MPHASE$:(JD)
Local F,I,JT,M$(20),M,ME,MN
REM'=====================================================================
REM'     Calculated Illuminated Percentage of Moon's Disk
REM
REM'ENTERED WITH: JD - Julian Days since 1900
REM'
REM'RETURNS: M$ - Percentage of Moon illuminated as string
REM
REM'NOTES: Uses Meeus short formula from Astro Formulae for Calculators
REM'=====================================================================
REM'VARIABLES USED:
REM'F - Illuminated fraction (1=Full)
REM'I - Variable for formula
REM'M$ - String to return
REM'M - Sun's mean anomaly
REM'MN - Moon's mean anomaly
REM'ME - Moon's mean elongation
REM'JT - Julian centuries from 1900

REM'DEFINE VARIABLES:
REM'Find julian centuries from 1900
JT=JD/36525

REM'Find Sun's Mean anomaly
M=358.475833+35999.0498*JT-0.000150*JT*JT-0.0000033*JT*JT*JT
REM'Reduce into range 0-360 degrees
M=M-((INT(M/360))*360)
REM
REM'Find Moon's Mean anomaly
MN=296.104608+477198.8491*JT+0.009192*JT*JT+0.0000144*JT*JT*JT
REM'Reduce into range 0-360 degrees
MN=MN-((INT(MN/360))*360)
REM
REM'Find Moon's Mean elongation
ME=350.737486+445267.1142*JT-0.001436*JT*JT+0.0000019*JT*JT*JT
REM'Reduce into range 0-360 degrees
ME=ME-((INT(ME/360))*360)

REM'Find I
I=180-ME-6.289*SIN(RAD(MN))+2.100*SIN(RAD(M))
I=I-1.274*SIN(RAD(2*ME-MN))-0.658*SIN(RAD(2*ME))
I=I-0.214*SIN(RAD(2*MN))-0.112*SIN(RAD(ME))

REM'Find F - Illuminated fraction
F=(1+COS(RAD(I)))/2

REM'Convert fraction to string percentage
F=F*100
M$=FIX$(F,0,10)+"%"
REM'Add description string if relevant
IF F>98
  M$=M$+" FULL"
ENDIF
IF F<2
  M$=M$+" NEW"
ENDIF

REM'ALERT("M Sun=",GEN$(M,10))
REM'ALERT("MN Moon=",GEN$(MN,10))
REM'ALERT("ME Elongation=",GEN$(ME,10))
REM'ALERT("F=",GEN$(F,10))
REM'ALERT("M$=",M$)


RETURN M$

ENDP
REM' ==============================================================================================================
PROC SNGHT:
REM'================================================================
REM'   Calculate and Display a Single Tidal Height for a given time
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'================================================================
REM' DECLARE VARIABLES:
Local DD%,MM%,YY% REM' Day,Month,Year
Local dDate$(255) REM' Date to Display
Local dDays& 	  REM' Date in Days since 1/1/1900
Local C$(10)      REM' Spring/Neap indicator
Local HT          REM' Predicted Height in metres
Local DT&	      REM' Dialog Time in seconds past midnight
Local RF$(20)	  REM' "Rising" / "Falling" etc string
Local TT          REM' UTC time for prediction
Local P$(30)      REM' Port Name
Local PR%         REM' Record number for current port
Local ZZ          REM' User Time Zone
Local X           REM' GP variable
Local MP          REM' Moonphase
Local THW         REM' Time in hours to nearest HW
Local I%          REM' Index 
Local PZ,z0,hm2,gm2,hs2,gs2,hk1,gk1,ho1,go1,hf4,gf4,hf6,gf6  REM' Port Harmonic constant values
REM'
EXTERNAL MF%       REM' Global Tide height output units - set to 0 for Metres or 1 for feet


REM'DEFINE VARIABLES:
REM'Set Dialog time to present time in secs since 0000
DT&=HOUR*60
DT&=DT&*60
DT&=DT&+(MINUTE*60)+SECOND


REM'Retrieve Current Port and User Time Zone and Date
OF:(1,0)
  P$=A.P$
  ZZ=A.Z
  PR%=A.PR%
  MP=A.W
  DD%=A.D
  MM%=A.M
  YY%=A.Y
  MF%=A.MF%
CLOSE

REM'Show Springs/Neaps & Port
C$=SPNEAP$:(MP)
REM'Show Port & Indicator
Ti:("Single Height - "+P$+"  "+C$)


REM' Find Date in Days since 1/1/1900
dDays&=DAYS(DD%,MM%,YY%)
REM' Find Date as a string
dDate$=FindDate$:(dDays&)

REM' Show Date
gAT 10,40
gPRINT "Date: ";dDate$

REM' Show Time Zone
gAT 10,65
gPRINT "Your Time Zone: ";GEN$(ZZ,4)


REM'Get Time User wants Height for
dINIT "Prediction Time",KDlgFillScreen%
dTIME DT&,"Time:",KDTime24Hour%,0,86340
REM' Show OK & Cancel buttons
dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%

REM' If user pressed Enter then continue
If DIALOG=KDButtonEnter%
  REM'Retrieve Data for Port - all angle in radians
  IF PR%<=kIPORT%
    OF:(2,0)
    POSITION PR%
  ELSEIF PR%>kIPORT%
    OF:(6,0)
    POSITION (PR%-kIPORT%)
  ENDIF
    PZ=B.TZ
    z0=B.A%/100.0
    gm2=RAD(B.B%)
    hm2=B.C%/100.0
    gs2=RAD(B.D%)
    hs2=B.E%/100.0
    gk1=RAD(B.F%)
    hk1=B.G%/100.0
    go1=RAD(B.H%)
    ho1=B.I%/100.0
    gf4=RAD(B.J%)
    hf4=B.K%/1000.0
    gf6=RAD(B.L%)
    hf6=B.M%/1000.0
  CLOSE
  REM'Convert User's Time to UTC decimal hours
  TT=(DT&/3600.0)+ZZ
  REM'Calculate Height
  HT=CALCHT:(TT,PZ,z0,hm2,gm2,hs2,gs2,hk1,gk1,ho1,go1,hf4,gf4,hf6,gf6)
  HT=HT/100.0
  REM'Calculate Height in 10 mins time for rising/falling/steady
  X=CALCHT:((TT+10.0/60.0),PZ,z0,hm2,gm2,hs2,gs2,hk1,gk1,ho1,go1,hf4,gf4,hf6,gf6)
  X=X/100.0
  REM'Set legend
  RF$="STEADY"
  IF (X>HT)
    RF$="RISING"
  ENDIF
  IF (X<HT)
    RF$="FALLING"
  ENDIF
  REM
  REM'Convert time back to user time zone
  TT=TT-ZZ
  REM
  REM'Display Time & Height & Rising/Falling/Steady
  gAT 10,120
  gPRINT "Time: ";O$:(TT,2)
  gAT 10,145
  gPRINT "Height= ";O$:(HT,(9+MF%))  
  gAT 10,170
  gPRINT RF$
  REM'
  REM'Show time to nearest HW
  OF:(7,0)
    REM'Set initial Time to HW to 24 hours
    THW=24
    I%=0
    REM'Look at each record and find nearest HW
    DO
      REM'If it is a HW record then compare time
      IF A.CH=1
        REM'If absolute time is shortest then store it
        IF (ABS(TT-A.TM))<THW
          THW=TT-A.TM  
        ENDIF
      ENDIF
      I%=I%+1
      NEXT
    UNTIL I%>4
  CLOSE
  REM'Set "Before"/"after"
  C$=" AFTER "
  IF THW<0
    C$=" BEFORE "
  ENDIF
  REM'Display time to HW
  gAT 10,195
  gPRINT O$:(ABS(THW),2);C$;"HW"
  REM'
  REM'Wait for Event/Keypress or Click on OK button
  WaitForOK:
  REM'
ENDIF


ENDP
REM' ==============================================================================================================
PROC DA:(C%)
REM'======================================================================
REM'                     Update Current voyage info
REM'Entered with:
REM'C% -
REM'1 - Time zone & date
REM'2 - Manual/AUTO mode
REM'3 - Metres or Feet
REM'4 - Ports file to Use (For UK+US version ONLY)
REM'5 - Course Mode and Variation
REM'6 - Draught
REm' 
REM'RETURNS: Updated values in VY() array and User Data file
REM
REM'======================================================================
REM'DECLARE VARIABLES:
Local d&,m&,y&,Z      REM' Day,Month,Year,Time Zone
Local dd&,mm&,yy&,zz  REM' Copies of Day,Month,Year,Time Zone
Local M%              REM' Choice Integer
Local Temp            REM' Temporary value
Local Temp$(20)       REM' Temporary String
Local ERFLAG%         REM' Error Flag
REM'
EXTERNAL VY()  REM' Current Data array and settings

REM'DEFINE VARIABLES:




IF C%=1
REM'Local Date & Time Zone at Ship
  REM'Initialise variables
  OF:(1,0)
    d&=A.D
    m&=A.M
    y&=A.Y
    z=A.Z
  CLOSE
  REM'Copy variables for later checking
  dd&=d&
  mm&=m&
  yy&=y&
  zz=z
  REM
  REM'Open Dialog
  dINIT "Date & Time Zone",KDlgFillScreen%
  REM'Day
  dLONG d&,"Day",1,31
  REM'Month
  dLONG m&,"Month",1,12
  REM'Year
  dLONG y&,"Year",1583,2100
  REM'Time zone
  dFLOAT z,"Time Zone",-14,14
  REM' Show OK & Cancel buttons
  dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
  REM' If user pressed Enter then continue
  If DIALOG=KDButtonEnter%
    REM'Save values & set update flags
    OF:(1,0)
      A.D=d&
      A.M=m&
      A.Y=y&
      A.Z=z
      REM'if Date has changed then update both TAFS & Heights
      IF (d&<>dd&) OR (m&<>mm&) OR (y&<>yy&)
        A.TAF%=0
        A.HOK%=0
      ENDIF
      REM'if time zone only has changed then update only Heights
      IF z<>zz
        A.HOK%=0
      ENDIF
      REM' Update the record
      UPDATE
    CLOSE
  ENDIF
ENDIF

IF C%=2
REM'Manual/AUTO mode
  REM'Initialise variables
  OF:(1,0)
    d&=A.D
    m&=A.M
    y&=A.Y
    z=A.Z
    zz=z
    M%=1
    IF A.X<>0
      M%=2
    ENDIF
  CLOSE
  REM
  REM'Open Dialog
  dINIT "Operation Mode",KDlgFillScreen%
  dCHOICE M%,"Mode:","Manual,AUTO"
  REM' Show OK & Cancel buttons
  dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
  REM' If user pressed Enter then continue
  If DIALOG=KDButtonEnter%
    REM'Save value in A.X (Manual=0,AUTO=KTrue%)
    OF:(1,0)
    A.X=0
    REM'If auto mode selected then reset date if necessary from intnl clock
    IF M%=2
      REM'Set auto mode
      A.X=KTrue%
      REM'Set date to internal clock values
      A.D=DAY
      A.M=MONTH
      A.Y=YEAR
      A.Z=z
      REM'if Date has changed then update both TAFS & Heights
      IF (d&<>DAY) OR (m&<>MONTH) OR (y&<>YEAR)
        A.TAF%=0
        A.HOK%=0
      ENDIF
      REM'if time zone only has changed then update only Heights
      IF z<>zz
        A.HOK%=0
      ENDIF
    ENDIF
    UPDATE
    CLOSE
  ENDIF
ENDIF

IF C%=3
REM'Metres or Feet
  REM'Initialise variables
  OF:(1,0)
    M%=1
    IF A.MF%<>0
      M%=2
    ENDIF
  CLOSE
  REM
  REM'Open Dialog
  dINIT "Tide Height Units",KDlgFillScreen%
  dCHOICE M%,"Units:","METRES,FEET"
  REM' Show OK & Cancel buttons
  dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
  REM' If user pressed Enter then continue
  If DIALOG=KDButtonEnter%
  REM'Save value in A.MF% (Metres=0,Feet=1)
    OF:(1,0)
      A.MF%=0
      REM'If Feet selected then set value to 1
      IF M%=2
        A.MF%=1
      ENDIF
      UPDATE
    CLOSE
  ENDIF
ENDIF

    
    
REM'UK+US version only - Change Between Ports Files
IF C%=4
  REM'Initialise variables
  OF:(1,0)
    M%=1
    IF A.W$="USPORTS"
      M%=2
    ENDIF
  CLOSE
  REM
  REM'Open Dialog
  dINIT "Ports File to Use",KDlgFillScreen%
  dCHOICE M%,"File for:","EUROPE,USA"
  REM' Show OK & Cancel buttons
  dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
  REM' If user pressed Enter then continue
  If DIALOG=KDButtonEnter%
    OF:(1,0)
      A.W$="PORTS"
      REM'If USA selected then change filename
      IF M%=2
        A.W$="USPORTS"
      ENDIF
      UPDATE
    CLOSE
  ENDIF
ENDIF


REM' True/Magnetic mode and Magnetic Variation
IF C%=5
  REM' Loop until valid input or User cancels dialog	
  DO
    REM' Initialise variables
    ERFLAG%=KFalse%
    REM' True/Magnetic Mode
    M%=VY(1)+1
    REM' Variation
    TEMP$=O$:(VY(17),7)
    REM'
    REM' Open Dialog
    dINIT "Courses & Variation",KDlgFillScreen%
    REM' Magnetic (VY(1)=0) or  True ((VY(1)=1) bearings & courses choice
    dCHOICE M%,"Course mode","Magnetic,True"
    REM' Magnetic variation
    dEDIT TEMP$,"Magnetic Variation",10
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
    REM' If user pressed Enter then continue and save values
    If DIALOG=KDButtonEnter%
      VY(1)=M%-1
      REM' Convert LON$ to variation
      Z=in:(TEMP$,4)
      REM' If error code of -999 returned then alert user & set flag
      IF Z=-999
        ERFLAG%=KTrue%
        ALERT("Your value of "+TEMP$,"Is not correct.")
      ELSE
	    VY(17)=Z
        REM'Save values to file
        OF:(1,0)
          A.TMAG%=VY(1)
          A.VARN=VY(17)
          REM' Update File
          UPDATE
        CLOSE
      ENDIF
      REM'
    ENDIF
  UNTIL ERFLAG%=KFalse%  
ENDIF


REM'Draught
IF C%=6
  REM'Initialise variables
  OF:(1,0)
  	REM' Read Draught
  	Temp=A.DRAFT
    REM' Read Metres/Feet
    M%=1
    Temp$="Draught(m)"
    REM' If feet then set Index and convert Draught into feet
    IF A.MF%<>0
      M%=2
      Temp=Temp*3.281
      Temp$="Draught(ft)"
    ENDIF
  CLOSE
  REM
  REM'Open Dialog
  dINIT "Vessel's Draught",KDlgFillScreen%
  dFLOAT Temp,Temp$,0,99
  REM' Show OK & Cancel buttons
  dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
  REM' If user pressed Enter then continue
  If DIALOG=KDButtonEnter%
  REM'Save value in A.DRAFT (ALWAYS stored in metres)
    OF:(1,0)
      REM' Convert Draft to metres if required
      IF M%=2
        Temp=Temp/3.281
      ENDIF
  	  A.DRAFT=Temp
      UPDATE
    CLOSE
  ENDIF
ENDIF



ENDP
REM' ==============================================================================================================
PROC CHIGHLOW:
REM'================================================================
REM'   Find and store Low & High Water times and heights
REM'
REM'ENTERED WITH: NIL
REM'
REM'RETURNS: NIL
REM'
REM'NOTES: Uses pre-computed heights for day
REM'================================================================
REM'DECLARE VARIABLES:
Local I%           REM' Index
Local HT1%,HT2%    REM' Read heights
Local TI%          REM' Test time index to find steady state of flood/ebb
Local X%           REM' GP Index
Local FLOOD%,EBB%  REM' Ebb & Flood flags
Local C%           REM' Change Index
Local CHANGE%(5)   REM' Change type array - 0=LW, 1=HW
Local CT(5),CHT(5) REM' Change Times and Heights ( 1 extra to flag unreliability)

REM'DEFINE VARIABLES:


REM'Open pre-computed heights (144* 10 minute intervals) & find HWs & LWs
OF:(4,0)
REM'Get initial State of tide - ebbing/flooding
FIRST
HT1%=B.HT%
NEXT
HT2%=B.HT%
EBB%=1
FLOOD%=0
IF HT2%>HT1%
  EBB%=0
  FLOOD%=1
ENDIF

REM'Read all records for first 2 HWs and LWs AND see if reliable
FIRST
I%=1
C%=1
WHILE I%<146 AND C%<6
  POSITION I%
  REM'Read record
  HT1%=B.HT%
  REM'Read next record
  NEXT
  HT2%=B.HT%
  REM'Evaluate Difference in heights
  REM'If tide was ebbing and is now flooding then low water reached
  IF EBB%
    IF HT2%>HT1%
      REM'Look back max 30 minutes to see if tide steady earlier
      TI%=I%
      X%=0
      POSITION I%
      DO
        BACK
        REM'IF Ht is same then get record position (avoids re-reading 1st record)
        IF B.HT%=HT1%
          TI%=POS
        ENDIF
        X%=X%+1
      UNTIL X%=3
      REM
      REM'Save Low water time & Height
      CHANGE%(C%)=2
      CT(C%)=((TI%-1)*10.0)/60.0
      CHT(C%)=HT1%
      REM'Increment C%
      C%=C%+1
      REM'Set I% on 1 hour to stop "false" HW/LW caused by change of TAFs
      I%=I%+6 :IF I%>145 :I%=145 :ENDIF
      REM'Reset flags
      EBB%=0
      FLOOD%=1
    ENDIF
  ENDIF
  REM
  REM'If tide was flooding and is now ebbing then high water reached
  IF FLOOD%
    IF HT2%<HT1%
      REM'ALERT("HW=",GEN$(I%,4))
      REM'Look back max 30 minutes to see if tide steady earlier
      TI%=I%
      X%=0
      POSITION I%
      DO
        BACK
        REM'IF Ht is same then get record position (avoids re-reading 1st record)
        IF B.HT%=HT1%
          TI%=POS
        ENDIF
        X%=X%+1
      UNTIL X%=3
      REM
      REM'Save High water time
      CHANGE%(C%)=1
      CT(C%)=((TI%-1)*10.0)/60.0
      CHT(C%)=HT1%
      REM'Increment C%
      C%=C%+1
      REM'Set I% on 1 hour to stop "false" HW/LW caused by change of TAFs
      I%=I%+6 :IF I%>145 :I%=145 :ENDIF
      REM'Reset flags
      EBB%=1
      FLOOD%=0
    ENDIF
  ENDIF
  REM
  REM'Increment Index
  I%=I%+1
ENDWH
REM'Close file
CLOSE

REM'Store data to file
I%=1
WHILE I%<6
  OF:(7,0)  
    A.CH=CHANGE%(I%)
    A.HT=CHT(I%)
    A.TM=CT(I%)
    UPDATE
  CLOSE
  I%=I%+1
ENDWH

REM'ALERT("CT5=",GEN$(CT(5),10))
REM'ALERT("CHT5=",GEN$(CHT(5),10))

ENDP
REM' ==============================================================================================================
PROC SPNEAP$:(MP)
Local A$(10),C%,I%
REM'================================================================
REM'        Make up string to show Neap/Spring status
REM
REM'ENTERED WITH: MP - Moonphase (6=Neaps, 1=Springs)
REM
REM'RETURNS: A$ - 10 char string showing status.
REM
REM'================================================================
REM'VARIABLES:
REM'A$ - Made up string
REM'C% - Char code
REM'I% - Index

REM'DEFINE VARIABLES:
I%=1

REM'Make up internal indicator string
DO
  REM'Normal character is space but put indicator at moonphase index
  C%=32
  IF I%=MP
    C%=42
  ENDIF
  A$=A$+CHR$(C%)
  REM'Increment I%
  I%=I%+1
UNTIL I%>6

REM'Make up A$
A$="S"+A$+"N"

RETURN A$

ENDP
REM' ==============================================================================================================
PROC PM:(DD,MM,YY,ZZ)
REM'=======================================================================
REM'                    To find Sun merpass & twilights
REM
REM'ENTERED WITH: DD - Day, MM -Month, YY - Year, ZZ - Time zone
REM'              Globals IA & IO - Lat & Long of Port.
REM
REM'RETURNS: ZONE TIME Sunrise & Sunset Times in Globals HA & HO respectively
REM
REM'Modified from pm proc used in Sightmaster 3
REM'=======================================================================
REM' DECLARE VARIABLES:
Local A,B,C
Local R
Local JT                     REM' Julian centuries since 1900
Local MP                     REM' UT of Sun merpass time
Local X                      REM' LHA Sun
REM'
EXTERNAL IA,IO,DN,GHA,HO,HA  REM' Astronomical values
EXTERNAL VY()                REM' Global Array 


REM'Calculate GHAY etc at 1200
JT=(JDAY:(12.0,DD,MM,YY))/36525

REM'Find Sun's GHA & DN @ 1200 UTC
VY(11)=12.0
REM'Find sun base coords
SU:(JT)
REM'Find nutation & obliquity of ecliptic
NU:(JT)
REM'Convert into GHA & Declination
CA:

IF GHA>=0 AND GHA<90
  GHA=GHA+360
ENDIF
A=360-GHA
A=A/15
A=12+A
REM'Find UT of Local merpass
MP=A-(IO/15)

REM'ALERT ("MP=",GEN$(MP,10))

REM'Calculate times
REM'(Sunset/Rise Alt=-0.833 degrees,Civil Tw=-6,Nautical Tw=-12.)
R=-0.833 
REM'Calculate LHA Sun
A=RAD(DN)
B=RAD(IA)
C=RAD(R)
X=COS(B)*COS(A) :IF X<1E-9 :X=1E-9 :ENDIF
X=(SIN(C)-(SIN(B)*SIN(A)))/X
REM
REM'Show event - If ABS(X)>1 then event does not occur
HA=0
HO=0
IF ABS(X)<=1
  X=ACOS(X)
  X=DEG(X)/15
  REM'Output am phenomenon 
  HA=MP-X-ZZ
  REM'Output pm phenomenon
  HO=MP+X-ZZ
ENDIF

ENDP
REM' ==============================================================================================================
PROC WaitForOK:
REM'========================================================================================
REM'     Show an OK button and wait for a system event or click on the button or Keypress
REM'
REM'ENTERED WITH: NIL
REM'
REM'RETURNS: NIL
REM'
REM'========================================================================================
REM'DECLARE VARIABLES:
Local ExitFlag%          REM' Exit Flag
Local ButWidth%,ButHt%   REM' Button Dimensions
Local Butx%,Buty%        REM' Coordinates to start drawing top left of button at
Local xCoord%            REM' X coordinate of pen Click
Local yCoord%            REM' Y coordinate of pen Click
Local Keycode%           REM' Key Code of any key pressed
REM'
EXTERNAL ScrWid%		 REM' Screen width in pixels
EXTERNAL ScrHght%		 REM' Screen height in pixels
EXTERNAL event&()        REM' Global Event Value
EXTERNAL evtype&         REM' Global Event Value
EXTERNAL GCurrentWin%    REM' Current Window ID
EXTERNAL CurrentPage%    REM' Global current Page - governs Menu actions and updating



REM'DEFINE VARIABLES:
ExitFlag%=KFalse%
ButWidth%=80
ButHt%=30
CurrentPage%=KNullPage%  REM'Set Page so Menu is not shown
REM' Set the Toolbar buttons to nulls
ToolBarButt:(CurrentPage%)


REM' Calculate coordinates for button
Butx%=(ScrWid%-ButWidth%)/2
Buty%=ScrHght%-ButHt%-3


REM' Position button start for drawing (top left corner of button)
gAT Butx%,Buty%


REM' Show OK Button
gBUTTON "OK",KButtS5%,ButWidth%,ButHt%,KButtS5Raised%


REM' Loop and wait for the exit flag to be set
Do
  REM' Set the Pointer Filter to discard Drag and Enter/Exit events as these are not wanted in this application
  REM' N.B This MUST be initialised each time
  POINTERFILTER (KPointerFilterDrag%+KPointerFilterEnterExit%),(KPointerFilterDrag%+KPointerFilterEnterExit%)
  REM'
  REM' Wait for the next Event
  Retevent:(KFalse%)
  REM'
  REM' If the Event was a Pointer Event on the current screen then evaluate it
  if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
    REM' Get the Pen coords
	xCoord%=event&(KEvAPtrScreenPosX%)
    yCoord%=event&(KEvAPtrScreenPosY%)
	REM' If the OK button was clicked then set the Exit Flag
    if ((xCoord%>Butx%) AND (xCoord%<(Butx%+ButWidth%)))
      if ((yCoord%>Buty%) AND (yCoord%<(Butx%+ButHt%)))
        ExitFlag%=KTrue%
      endif
    endif  
  endif  
  REM'
  REM' If the Event was a Keypress then evaluate it
  if ((evType& AND &400)=0)
    KeyCode%=event&(1)	
	REM' If it was the Enter key then set the Exit Flag
    if KeyCode%=KKeyEnter%
      ExitFlag%=KTrue%
    endif  
  endif
  REM'
Until ExitFlag%=KTrue%


ENDP
REM' ==============================================================================================================
Proc Ti:(T$)
	REM' ***********************************************************************************
    REM'           Clear Screen and Show Title & Border
    REM'
    REM' ENTERED WITH: T$ - Title for window
    REM'
	REM'
    REM' RETURNS: NIL
    REM'
    REM'
   	REM' **********************************************************************************
    REM' DECLARE VARIABLES:
    Local Titley%             REM' Title y coordinate
    Local Index%              REM' Index
    Local Temp%               REM' Temporary Integer
    Local xstart%             REM' Left offset for start column of text
    Local page%               REM' Page Number
    REM'
    EXTERNAL ScrWid%		  REM' Global Screen Width
	EXTERNAL TbWidth%         REM' Global Toolbar Width
    
    
	REM' DEFINE VARIABLES:
    xstart%=10
    Titley%=16
    page%=2
    
    
	REM' Set the Font to use
	gfont KFontTimesNormal15&
	REM' Set the Text Style (Bold, Underlined etc)
    gStyle KgStyleBold%


    REM' Clear screen
    gCLS


	REM' Draw a grey background for the text
    REM' Set the Pen Drawing Colour to grey
	SetColor:(KGrey%)
    REM' Fill the box, allowing for toolbar and scrollbar widths 
    REM' Page 1 (with scroll bar)
    if Page%=1
      Temp%=ScrWid%-KScrollWidth%-TbWidth%
    endif  
    REM' Page 2 (no scroll bar)
    if Page%=2
      Temp%=ScrWid%-TbWidth%
    endif
    REM' Fill the box     	
    gAT 1,1
    gFILL Temp%,18,0
    REM' Set the Pen Drawing Colour to black
	SetColor:(KBlack%)


	REM' Draw a Border round the screen
    Border:

    
	REM' Show Title Text
    gAT xStart%,Titley%
    gPRINT T$
    


endp
REM' ==============================================================================================================
PROC DS:
REM'================================================================
REM'    Show current data on screen - read from status file
REM'
REM'ENTERED WITH: NIL
REM'
REM'RETURNS: NIL
REM'================================================================
REM'DECLARE VARIABLES:
Local I%          REM' Index
Local ITEMS%      REM' Number of items to display
Local T$(10,50)    REM' Array of titles
Local D$(10,100)    REM' Array of data strings
Local X%,Y%       REM' Text output coords 
Local Temp%       REM' Temporary Integer
Local DD%,MM%,YY%    REM' Day,Month,Year
Local dDate$(255) REM' Date to Display
Local dDays& 	  REm' Date in Days since 1/1/1900
REM'


REM'DEFINE VARIABLES:
ITEMS%=10


REM'Show Title
ti:("Voyagemaster 5")



REM'Open Main Data file
OF:(1,0)
  REM'
  REM'Allocate data to variables
  REM'Day of Month
  DD%=A.D
  REM'Month
  MM%=A.M
  REM'Year
  YY%=A.Y
  REM' Course mode Magnetic(=0) or True(=1) bearings & courses
  T$(1)="Course Mode:"
  D$(1)="True"
  If A.TMAG%=0
    D$(1)="Magnetic"
  ENDIF
  REM' Allocate date
  T$(2)="Tide prediction Date:"
  REM' Find Date in Days since 1/1/1900
  dDays&=DAYS(DD%,MM%,YY%)
  REM' Find Date as a string
  dDate$=FindDate$:(dDays&)
  D$(2)=dDate$
  REM'
  REM'Current User Time zone
  T$(3)="Your Time Zone: "
  D$(3)=GEN$(A.Z,4)
  REM'Current Port Name
  T$(4)="Tide Port: "
  D$(4)=A.P$
  REM'Port Number
  T$(5)="ATT Tide Port No: "
  D$(5)=A.PN$
  REM'Manual/AUTO mode
  T$(6)="Tide Mode:"
  D$(6)="Manual"
  Temp%=A.X
  IF Temp%=KTrue%
    D$(6)="AUTO"
  ENDIF
  REM' Metres or Feet (Metres=0,Feet=1)
  T$(7)="Tide Height Units:"
  D$(7)="Metres"
  If A.MF%=1
    D$(7)="Feet"
  ENDIF  
  REM'Springs/Neaps Indicator
  T$(8)="Spring/Neap:"
  D$(8)=SPNEAP$:(A.W)
  REM'Moon phase Indicator
  T$(9)="Moonlight:"
  D$(9)=A.V$
  REM' Variation 
  If A.TMAG%=0
    T$(10)="Variation"
    D$(10)=O$:(A.VARN,7)
  endif
  REM
REM'Close data file
CLOSE



REM'Show data
I%=1
X%=10
Y%=40
DO
  REM'Show Title
  gAt X%,Y%
  gSTYLE 1
  gPRINT (T$(I%)+" ");
  gSTYLE 0
  REM'Show Data
  gPRINT D$(I%)
  REM'Increment I% and positions
  I%=I%+1
  Y%=Y%+KLineSpace%
  REM'For greater than 9 items change to right hand column
  IF I%>9
    Y%=40+((I%-10)*KLineSpace%)
    X%=310
  ENDIF
UNTIL I%>ITEMS%


REM' Show the Toolbar
TBarShow:



ENDP
REM' ==============================================================================================================
PROC CalcTide:(AutoFlag%)
REM'==================================================================================
REM'     Check status of TAFs and Heights flags and calculate Tides if required
REM'
REM'
REM'ENTERED WITH: AutoFlag% - Set to KTrue% if AUTO is enabled
REM'
REM'RETURNS: DFLAG% - Flag - Set to -1 if Data was updated
REM'
REM'================================================================
REM'DECLARE VARIABLES:
Local DD,MM,YY			    REM' Prediction Day,Month & Year
Local TOK%                  REM' Flag for Tidal angles & factors already calculated
Local HOK%                  REM' Flag for Heights for Port already calculated
Local NDay%,NMonth%,NYear%  REM' System Day,Month,Year 
Local DFLAG%                REM' Flag for Data updated
REM'


REM' DEFINE VARIABLES:
DFLAG%=0
  
      
REM' Read current user data
OF:(1,0)
  TOK%=A.TAF%
  HOK%=A.HOK%
  DD=A.D
  MM=A.M
  YY=A.Y
CLOSE


REM' If AUTO mode is enabled then compare the saved date with the system date 
If AutoFlag%=KTrue%
  REM' Get system Date
  NDay%=DAY
  NMonth%=MONTH
  NYear%=YEAR
  REM' If any are different then save them and flag re-calculation
  If (NDay%<>DD) OR (NMonth%<>MM) OR (NYear%<>YY)
      DD=NDay%
      MM=NMonth%
      YY=NYear%
    OF:(1,0)
      A.D=DD
      A.M=MM
      A.Y=YY
      A.TAF%=0
      A.HOK%=0
      UPDATE
  	CLOSE
    REM'
	TOK%=0
    HOK%=0
  ENDIF
  REM'
ENDIF


REM' IF TAFs and Moonphase not calculated then calculate them now
IF TOK%=0
  UPDTAF:(DD,MM,YY)
  REM' Set Update Flag to true
  DFLAG%=-1
ENDIF

REM' IF Heights for Port not calculated then calculate now
IF HOK%=0
  CALCDAY:
  REM'Calculate HW & LW data
  CHIGHLOW:
  REM' Set Update Flag to true
  DFLAG%=-1
ENDIF

RETURN DFLAG%


ENDP
REM' ==============================================================================================================
PROC sport:(PortRec%)
REM'====================================================================================
REM'                     Select a Port
REM
REM'Entered with: PortRec% - Record Number of a Port or 0 if current port to be shown
REM
REM'RETURNS: NIL
REM
REM'
REM' NOTES: Use TI:("Title") before running this routine
REM'====================================================================================
REM' DECLARE VARIABLES:
Local CurPort%         REM' Number of current port
Local OldPort%         REM' Number of last port selected
Local UserPorts%       REM' Number of Ports stored in internal user ports file
Local TotalPorts%      REM' Total Number of Ports stored in both ports files
Local Index%           REM' Index
Local PortNumber$(255) REM' Port number string
Local PortName$(255)   REM' Port Name string
Local PortLat          REM' Port Latitude
Local PortLon          REM' Port Longitude
Local ExitFlag%        REM' Flag set to exit proc
Local xCoord%          REM' X coordinate of pen Click
Local yCoord%          REM' Y coordinate of pen Click
Local Keycode%         REM' Key Code of any key pressed
Local Butclick%	       REM' Number of button clicked
Local NewFlag%         REM' Flag set to redraw screen
Local TempPort%        REM' Temporary Port record number returned from search
REM'
EXTERNAL ExitHK%         REM' Global Exit Key
EXTERNAL CurrentPage%    REM' Global current Page - governs Menu actions and updating
EXTERNAL MenuChoice%     REM' Global Menu Item hotkey return code e.g %a
EXTERNAL gCurrentWin%    REM' Global ID of current Screen Window 
EXTERNAL event&()        REM' Global Event Value
EXTERNAL evtype&         REM' Global Event Value
EXTERNAL GButChoice%     REM' Global Button number chosen or Zero


REM' Set Error Trapping
ONERR ErrorTrap::


REM'DEFINE VARIABLES:
REM' Set Exit Flag to default False
ExitFlag%=KFalse%
REM' Set Flag to true so screen is redrawn
NewFlag%=KTrue%
REM' Set current page value
CurrentPage%=KSelectPortPage%
REM' Set the Toolbar buttons
ToolBarButt:(CurrentPage%)


REM' Copy passed Port record number
CurPort%=PortRec%

OF:(1,0)
  REM' Read the current Port in the file
  OldPort%=A.PR%
CLOSE

REM' If passed record is zero then use the Port from the file
If CurPort%=0
  CurPort%=OldPort%
endif


REM'Read number of user ports
OF:(6,0)
  UserPorts%=COUNT
CLOSE

REM' Find the Total number of Ports
TotalPorts%=kIPORT%+UserPorts%


REM' Show the title
ti:("Select Port")

REM'Set invert text mode
gTMODE 2
PortName$=""
PortNumber$=""
PortLat=0
PortLon=0
REM' Show the current Port with Position and ATT Number
ShowPort:(PortNumber$,PortName$,PortLat,PortLon)



REM' Loop until the exit flag is set
WHILE ExitFlag%=KFalse%
  REM'
  REM' Set current page value
  CurrentPage%=KSelectPortPage%
  REM'
  REM' Redraw screen if required
  If NewFlag%=KTrue%
  	REM' Reset the Flag
    NewFlag%=KFalse%
    REM'Set invert text mode
    gTMODE 2
    REM' Blank out the current Port text
    ShowPort:(PortNumber$,PortName$,PortLat,PortLon)
	REM'
    REM' Read the current Port Details from File
    If CurPort%<=kIPORT%
      REM' Open Inbuilt File as B
      OF:(2,0)
  	    POSITION CurPort%
        PortName$=B.N$
        PortNumber$=B.PN$
        PortLat=B.LAT
        PortLon=B.LON
        REM' ALERT("Sport No of Ports=",GEN$(COUNT,10))
      CLOSE
    REM' Else Open User Ports File
    ELSE
      REM' Open User Ports File as B
      OF:(6,0)
  	    POSITION (CurPort%-kIPORT%)
        PortName$=B.N$
        PortNumber$=B.PN$
        PortLat=B.LAT
        PortLon=B.LON
      CLOSE
    ENDIF    
    REM'
    REM'Set invert text mode
    gTMODE 2
    REM' Show the current Port with Position and ATT Number
    ShowPort:(PortNumber$,PortName$,PortLat,PortLon)
    REM'Set text mode to normal
    gTMODE 0
    REM'
    REM'Show screen buttons at base of screen
    ShowButtons:
  endif
  REM'  
  REM' Reset Butclick%
  ButClick%=0
  REM'Wait for an Event
  Retevent:(KFalse%)
  REM'
  REM' If a Toolbar button was clicked then evaluate it
  If GButChoice%<>0
    REM' Search Ports
    If GButChoice%=1
      MenuChoice%=%f
  	Endif
  Endif
  REM'
  REM' If the Event was a Pointer Event on the current screen then evaluate it
  if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
    REM' NOTE:Can also trap pen touching (evType&=KEvPtrEnter&) or leaving screen (evType&=KEvPtrExit&) but these DO NOT return x,y coords 
    REM'
    REM' Get the Pen coords
	xCoord%=event&(KEvAPtrScreenPosX%)
    yCoord%=event&(KEvAPtrScreenPosY%)
    REM' Evaluate if it was a button click
	ButClick%=TestButtons:(xCoord%,yCoord%)
  endif
  REM'
  REM'
  REM' If the Event was a Keypress then evaluate it
  if ((evType& AND &400)=0)
    KeyCode%=event&(1)	
    REM' ALERT("You pressed a key","Code="+GEN$(KeyCode%,10))
    REM' Evaluate the Keypress
    if KeyCode%=%b
	  ButClick%=1
    elseif KeyCode%=%n
	  ButClick%=2
    elseif KeyCode%=KKeyEnter%
	  ButClick%=3
    elseif KeyCode%=KKeyEsc%
	  ButClick%=4
    endif	
  endif
  REM'
  REM' If it was a valid Menu choice then carry out the required action
  if MenuChoice%<>0
  	REM' Close
	if MenuChoice%=ExitHK%
	  REM' Set button click to save choice and exit proc	
	  ButClick%=3	
    REM' Help Menu  
    REM' Help
    ElseIf MenuChoice%=%H
      cmdHelp:
    REM' About
    ElseIf MenuChoice%=%A
      cmdAbout:
    REM'
    REM' Tools Menu
    REM' Search Ports
    ElseIf MenuChoice%=%f
	  TempPort%=SearchPorts:
      REM' ALERT("Port No Found= ",GEN$(TempPort%,10))
      REM' If a Port was found then make it the current Port
      if TempPort%<>0
      	CurPort%=TempPort%
        REM' Set Flag for screen redraw
        NewFlag%=KTrue%
      endif  
	endif
    REM'
  endif
  REM'
  REM'Show PREVIOUS Port
  IF ButClick%=1
  	CurPort%=CurPort%-1
    REM' Make sure value is within limts
    If CurPort%<1
      CurPort%=1
    endif
    REM' Set Flag for screen redraw
    NewFlag%=KTrue%
  ENDIF
  REM
  REM'Show next Port
  IF ButClick%=2
  	CurPort%=CurPort%+1
    REM' Make sure value is within limts
    If CurPort%>TotalPorts%
      CurPort%=TotalPorts%
    endif
    REM' Set Flag for screen redraw
    NewFlag%=KTrue%
  ENDIF
  REM
  REM' Set Exit Flag and save Port if changed
  IF ButClick%=3
	ExitFlag%=KTrue%
    REM'
    REM'If the Port has changed then save the Port number to file
    if CurPort%<>OldPort%
	  REM'
      REM' Read the Port Details from File
      If CurPort%<=kIPORT%
        REM' Open Inbuilt File as B
        OF:(2,0)
      	  FIRST
  	      POSITION CurPort%
          PortName$=B.N$
          PortNumber$=B.PN$
        CLOSE
      REM' Else Open User Ports File
      ELSE
        REM' Open User Ports File as B
        OF:(6,0)
      	  FIRST
  	      POSITION (CurPort%-kIPORT%)
          PortNumber$=B.PN$
          PortName$=B.N$
        CLOSE
      ENDIF    
      REM'
      REM'
      REM' ALERT("CurPort%=",GEN$(CurPort%,10))
      REM' ALERT("PortName$=",PortName$)
      REM'
      REM' Open the data file
      OF:(1,0)
        REM' Save the Port record number
        A.PR%=CurPort%
        REM' Save the Port number string
        A.PN$=PortNumber$
        REM' Save the Port Name
        A.P$=PortName$
        REM' Set the Heights calculated flag so a new set are calculated
    	A.HOK%=0
        REM' Update the record
        UPDATE
      CLOSE
    endif
    REM'  
  Endif
  REM'
  REM' Set Exit Flag only
  IF ButClick%=4
	ExitFlag%=KTrue%
  Endif
  REM'
ENDWH
  


RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
ALERT("Sport Error "+GEN$(err,10),err$(err))


ENDP

REM' ==============================================================================================================
PROC GTIDE:
REM'
REM'================================================================
REM'              Graphic Display of Tidal Curve
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'NOTES: 
REM' Uses pre-computed heights for day
REM' Series 5 screen is 640 pixels wide by 240 pixels high
REM' The width of the Toolbar in pixels is available in the public global TbWidth%
REM'================================================================
REM'DECLARE VARIABLES:
Local C$(10)                REM' Spring/Neap indicator
Local P$(30)                REM' Port Name
Local HT%(145)              REM' Tide Heights array
Local ZZ                    REM' User Time Zone
Local I%                    REM' Index
Local MN%,MX%               REM' Maximum and Minimum Heights of Tide
Local SC                    REM' Vertical Scale factor - pixels per metre
Local BV%                   REM' Base Value for drawing graph
Local GI%                   REM' Index for position of graphic "cursor"
Local OGI%                  REM' Old index position of cursor
Local TempGI%               REM' Temporary cursor position Index 
Local MP                    REM' Moonphase
Local NFLAG%                REM' Flag to trigger new display of data
Local ExitFlag%             REM' Flag set to TRUE to exit procedure
Local xCoord%               REM' X coordinate of pen Click
Local yCoord%               REM' Y coordinate of pen Click
Local Keycode%              REM' Key Code of any key pressed
Local xStart%               REM' Start x coord for graph 
Local yStart%               REM' Start y coord for graph 
Local Graphx%               REM' Length of Graph X Axis
Local Graphy%               REM' Length of Graph Y Axis
Local DD,MM,YY              REM' Day,Month,Year 
Local AutoFlag% 			REM' Auto Mode Flag
Local Y                     REM' Y coordinate on Graph 
Local xPlot%                REM' X coordinate on graph
Local dDate$(255)           REM' Date to Display
Local dDays&                REM' Date in Days from 1/1/1900
Local Temp%                 REM' Temporary Integer
Local PR%                   REM' Port Record number
Local DRAFT                 REM' Vessel's Draft (always in METRES)
REM'
EXTERNAL CurrentPage%       REM' Global current Page - governs Menu actions and updating
EXTERNAL event&()           REM' Global Event Value
EXTERNAL evtype&            REM' Global Event Value
EXTERNAL MenuChoice%        REM' Global Menu Item hotkey return code e.g %a
EXTERNAL ExitHK%            REM' Global Exit Key
EXTERNAL GCurrentWin%       REM' Current Window ID
EXTERNAL ScrWid%		    REM' Screen width in pixels
EXTERNAL ScrHght%		    REM' Screen height in pixels
EXTERNAL TbWidth%           REM' Global Toolbar Width
EXTERNAL HA,HO              REM' Global Astronomical Values
EXTERNAL GButChoice%        REM' Global Button number chosen or Zero
EXTERNAL GTimerComp%        REM' Global Timer completed Flag - set to KTrue% if Timer completed
EXTERNAL MF%                REM' Global Tide height output units - set to 0 for Metres or 1 for feet
EXTERNAL IA,IO              REM' Global Lat, Long


REM' Set Error Trapping
ONERR ErrorTrap::


REM'DEFINE VARIABLES:
MN%=1000
MX%=0
REM'Set GI% for current clock time - add 1 as 0000 is HT(1)
GI%=(HOUR*6)+INT(MINUTE/10.0)+1
OGI%=GI%
REM'Set flag to trigger intital display
NFLAG%=-1
REM' Set Exit Flag to default false
ExitFlag%=KFalse%
REM' Set start position for graph
xStart%=150
yStart%=210
REM' Set graph dimensions (Length and Height)
graphx%=400
graphy%=160



REM'Loop until Exit Flag is true
WHILE ExitFlag%=KFalse%
  REM' Set current page
  CurrentPage%=KGraphPage%
  REM'
  REM'If required then Draw Graphic Screen & update all info
  IF NFLAG%
    REM'Retrieve Current user data
    OF:(1,0)
      P$=A.P$
      ZZ=A.Z
      MP=A.W
      DD=A.D
      MM=A.M
      YY=A.Y
      AutoFlag%=A.X
      MF%=A.MF%
      PR%=A.PR%
      DRAFT=A.DRAFT
    CLOSE
    REM'
    REM'Retrieve Port Lat and Long into globals IA and IO for Sunrise/Set prediction
    IF PR%<=kIPORT%
      OF:(2,0)
      POSITION PR%
    ELSEIF PR%>kIPORT%
      OF:(6,0)
      POSITION (PR%-kIPORT%)
    ENDIF
      IA=B.LAT
      IO=B.LON
    CLOSE
	REM'
    REM' Calculate Tides if required
    CalcTide:(AutoFlag%)
    REM'
    REM'Get Springs/Neaps indicator
    C$=SPNEAP$:(MP)
    REM'Set the Toolbar buttons
    ToolBarButt:(KGraphPage%)
    REM'Clear Screen & Show Port & Indicator
    ti:(P$+"  "+C$)
    REM'
    REM' Find Date in Days since 1/1/1900
    dDays&=DAYS(DD*1,MM*1,YY*1)
    REM' Find Date as a string
    dDate$=FindDate$:(dDays&)
    REM'Show Date and Time Zone on top line
    gAT 10,35
    gPRINT dDate$;"   Time Zone: ";GEN$(ZZ,4);
    REM' Add Auto Indicator if set and set time on screen
    If AutoFlag%=KTrue%
      gPRINT "   (Auto)"
      REM'Set GI% for current clock time - add 1 as 0000 is HT(1)
      GI%=(HOUR*6)+INT(MINUTE/10.0)+1
      OGI%=GI%
    ENDIF  
	REM'
    REM' Show High and Low Waters on left side of graph
    ShowHighLow:
    REM'
    REM'Show Sunrise & Sunset times
    PM:(DD,MM,YY,ZZ)
    gAT 1,145
    gPRINT "Sunrise:";O$:(HA,8)
    gAT 1,165
    gPRINT " Sunset:";O$:(HO,8)
    REM'
    REM'Open pre-computed heights (144* 10 minute intervals)
    OF:(4,0)
    I%=1
    REM'Read all 145 records into array
    WHILE I%<146 
      POSITION I%
      REM'Read record
      HT%(I%)=B.HT%
      REM'Find Maximum and Minimum Heights (all * 100) in array
      IF HT%(I%)<MN%
        MN%=HT%(I%)
      ENDIF
      IF HT%(I%)>MX%
        MX%=HT%(I%)
      ENDIF
      REM'Increment Index
      I%=I%+1
    ENDWH
    REM'Close file
    CLOSE
    REM'
    REM'Set Vertical Scale Factor 
    SC=Graphy%/((MX%-MN%)/100.0)
    REM'Limit scaling for small range ports such as KOBENHAVN
    IF SC>Graphy%
      SC=Graphy%
    ENDIF
    REM' Set base value for drawing graph as minimum tidal height
    BV%=MN%
    REM'Plot Graph
    REM'Draw Graph Sides
    gAT xStart%,yStart%
    REM'
	REM' Set the Drawing Pen Width
 	gSetPenWidth  3
    REM'Draw Horizontal axis
    gAT xStart%,yStart%
    gLINEBY graphx%,0
    REM'Draw Vertical axis
    gAT xStart%,yStart%
    gLINEBY 0,-graphy%
    REM'Draw Vertical axis at end of graph
    gAT (xStart%+graphx%),yStart%
    gLINEBY 0,-graphy%
	REM'
	REM' Set the Drawing Pen Width
 	gSetPenWidth  1
    REM'
    REM'Show Vessel's Draft if it is within the range
    if (DRAFT>=(MN%/100.0)) AND (DRAFT<(MX%/100.0))
      REM' Find Y position in pixels
      Y=(((DRAFT*100.0)-BV%)/100.0)+0.1
      Y=yStart%-(Y*SC)
      REM' Draw horizontal draught line
      gAT xStart%,Y
      gLINEBY graphx%,0
	endif
	REM'
    REM'Label horizontal (time) axis with hours & indicators
    I%=0
    DO
      REM' Show Hours every 2 hours
      IF ((INT(I%/2))*2)=I%
        gAT xStart%+(graphx%*I%/24.0),(yStart%+20)
        gPRINT GEN$(I%,4)
      ENDIF  
      REM' Show Indicator
      gAT xStart%+(graphx%*I%/24.0),yStart%
      gLINEBY 0,8
      REM' Increment Index
      I%=I%+1
    UNTIL I%>24
    REM'
    REM'Draw Graph points (Item (1) of array is actually at 0000 hrs )
    gAT xStart%,yStart%
    I%=1
    WHILE I%<146
      REM' Find Y position in pixels
      Y=((HT%(I%)-BV%)/100.0)+0.1
      Y=yStart%-(Y*SC)
      REM'Find X position - Subtract 1 from I% so first line gets drawn at 0000 hours
      xPlot%=((I%-1)*(graphx%/145.0))+xStart%
      REM'Draw Line
      gLINETO xPlot%,Y
      REM' Debug
      REM'ALERT ("xPlot% "+GEN$(I%,10),GEN$(xPlot%,10))
      REM'ALERT ("HT=",GEN$(HT%(I%),10))
      REM'ALERT ("Y=",GEN$(Y,10))
      REM'Increment Index
      I%=I%+1
    ENDWH
    REM'Show Graphic "Cursor" at current time and text values
    REM'Set invert text mode & graphic mode
    gTMODE 2
    gGMODE 2
    SPOINT:(HT%(GI%),GI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
    REM'Reset OGI%
    OGI%=GI%
    REM'Reset flag
    NFLAG%=0
    REM'
  ENDIF
  REM'
	REM' Set the Pointer Filter to discard Drag and Enter/Exit events as these are not wanted in this application
    REM' N.B This MUST be initialised each time
    POINTERFILTER (KPointerFilterDrag%+KPointerFilterEnterExit%),(KPointerFilterDrag%+KPointerFilterEnterExit%)
    REM'
  	REM' Wait for the next Event or for the timer to expire in AUTO mode
	Retevent:(AutoFlag%)
    REM'
	REM' Use the current screen for graphics output
	gUse GCurrentWin%
	REM'
    REM'IF AUTO Mode set then update cursor position/redraw as required
    IF AutoFlag%=KTrue%
      REM' If the Timer completed then check if the Tides need to be updated
	  If GTimerComp%=KTrue%
        REM'Find GI% for current clock time - add 1 as 0000 is HT(1)
        TempGI%=(HOUR*6)+INT(MINUTE/10.0)+1
        REM' If it has changed then redraw cursor etc
        If TempGI%<>GI%
          OGI%=GI%
          GI%=TempGI%      
          REM'Set invert text mode & graphic mode
          gTMODE 2
          gGMODE 2
          REM'Blank out old cursor & Text
          SPOINT:(HT%(OGI%),OGI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
          REM
          REM'Draw new cursor & Text
          SPOINT:(HT%(GI%),GI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
          REM'Set normal text & graphics mode
          gTMODE 0
          gGMODE 0
          REM'Reset OGI%
          OGI%=GI%
		EndIf
		REM'
        REM' Calculate Tides and set redraw flag if required
        If CalcTide:(AutoFlag%)
          NFLAG%=-1
        ENDIF
        REM'  
	  ENDIF
	ENDIF
    REM'
    REM' Set the appropriate Menu choice if a button was pressed
    if GButChoice%<>0
      REM' ALERT("Button pressed=",GEN$(GButChoice%,10))	
	  REM'
      REM' Next Day
      if GButChoice%=1
        MenuChoice%=%n
      REM' Previous Day
      elseif GButChoice%=2
        MenuChoice%=%b
      REM' Nearest Port
      elseif GButChoice%=3
        MenuChoice%=%N
      REM' Close
      elseif GButChoice%=4
        MenuChoice%=ExitHK%
      Endif  	
    endif
    REM'
    REM' If it was a valid Menu Choice then select proc to call for required menu option
    if MenuChoice%<>0
      REM'
      REM'
      REM' Files Menu
      REM' Exit  
      If MenuChoice%=ExitHK%
        REM' Set Exit Flag to true
        ExitFlag%=KTrue%
      REM'
	  REM' Print File Cascade menu
      REM' Page setup
      ElseIf MenuChoice%=%U
        cmdPageSetup:
      REM'
      REM' Print setup
      ElseIf MenuChoice%=%P
        cmdPrintSetup:
      REM'
      REM' Print preview
      ElseIf MenuChoice%=%V
        PRTIDE:(2,P$,DD,MM,YY,ZZ,C$,HA,HO,-1)
      REM'
      REM' Print File       
      ElseIf MenuChoice%=%p
        PRTIDE:(1,P$,DD,MM,YY,ZZ,C$,HA,HO,-1)
 	  REM'
      REM' Help Menu  
      REM' Help
      ElseIf MenuChoice%=%H
        cmdHelp:
      REM' About
      ElseIf MenuChoice%=%A
        cmdAbout:
      REM'
      REM' Data - Date & Time Zone
      ElseIf MenuChoice%=%d
        IF AutoFlag%<>KTrue%
          DA:(1)
        ENDIF
        NFLAG%=-1
      REM'
      REM' Data - Output Units
      ElseIf MenuChoice%=%u
        DA:(3)
        NFLAG%=-1
      REM'
      REM' Data - Next Day
      ElseIf MenuChoice%=%n
        IF AutoFlag%<>KTrue%
          ChangeDay:(1)
  		ENDIF
        NFLAG%=-1
      REM'
      REM' Data - Previous Day
      ElseIf MenuChoice%=%b
        IF AutoFlag%<>KTrue%
          ChangeDay:(-1)
        ENDIF  
        NFLAG%=-1
      REM'
      REM' Data - Port & Date
      ElseIf MenuChoice%=%D
        REM' Show Port Selector
        ti:("Select Port & Date")
        SPORT:(0)
        REM' Select Date & Time Zone
        IF AutoFlag%<>KTrue%
          DA:(1)
        ENDIF  
        NFLAG%=-1
      REM'
      REM' Data - Nearest Port
      ElseIf MenuChoice%=%N
        REM' Get Lat & Long & Calculate nearest Port index P%
        NPORT:
        NFLAG%=-1
      REM'
      REM' Mode - Manual/AUTO
      ElseIf MenuChoice%=%m
        DA:(2)
        NFLAG%=-1
      REM'
      Endif            
      REM'
	endif
	REM'
    REM' If the Event was a Pointer Event on the current screen then evaluate it
	if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
	  REM' Ignore immediately repeated Pen events
      REM' NOTE:Can also trap pen touching (evType&=KEvPtrEnter&) or leaving screen (evType&=KEvPtrExit&) but these DO NOT return x,y coords 
      REM'
      REM' Get the Pen coords
	  xCoord%=event&(KEvAPtrScreenPosX%)
      yCoord%=event&(KEvAPtrScreenPosY%)
	  REM' xCoord%=event&(KEvAPtrPositionX%)
      REM' yCoord%=event&(KEvAPtrPositionY%)
      REM' 
      REM' Temp%=event&(KEvAPtrType%)
      REm' ALERT("Pen Event Type=",GEN$(Temp%,10))
	  REM'
	  REM' If the Pointer was within the Graph then move the cursor
	  if (xcoord%>xStart%) AND (xcoord%<=(xStart%+graphx%))
        IF AutoFlag%<>KTrue%
		  REM' ALERT("xCoord%=",GEN$(xCoord%,10))
          REM'Set invert text mode & graphic mode
          gTMODE 2
          gGMODE 2
          REM'Blank out old cursor & Text
          SPOINT:(HT%(GI%),GI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
	      REM' Find the new value of GI%
		  GI%=((xCoord%-xStart%)/(graphx%/145.0))+1
          REM'Draw new cursor & Text
          SPOINT:(HT%(GI%),GI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
          REM'Set normal text & graphics mode
          gTMODE 0
          gGMODE 0
        ENDIF  
 	  endif
	  REM'
    endif  
    REM'
    REM'
    REM' If the Event was a Keypress then evaluate it
    if ((evType& AND &400)=0)
      KeyCode%=event&(1)	
      REM' ALERT("You pressed a key","Code="+GEN$(KeyCode%,10))
      REM' Carry out any actions required for a valid key
	  REM
      REM'If AUTO mode not set and LEFT/RIGHT or UP/DOWN arrows pressed then scroll through curve
      IF AutoFlag%<>KTrue%
        REM'Left & Right keys move in intervals of 1 hour,, up & down in 10 min intervals
        if KeyCode%=4106 OR KeyCode%=4105 OR KeyCode%=4103 OR KeyCode%=4104
		  REM'Set invert text mode & graphic mode
          gTMODE 2
          gGMODE 2
          REM'Blank out old cursor & Text
          SPOINT:(HT%(GI%),GI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
          REM'Increment GI% for keypress 
          REM'Left & right arrow keys - 1 hour move
          IF KeyCode%=4103 OR KeyCode%=4104 
            GI%=GI%-6 
            IF KeyCode%=4104
              GI%=GI%+12
            ENDIF
          ENDIF
          REM'Up & Down arrow keys - 10 minute move
          IF KeyCode%=4105 OR KeyCode%=4106 
            GI%=GI%-1 
            IF KeyCode%=4106
              GI%=GI%+2
            ENDIF
          ENDIF
          REM'Make sure GI% is in range
          IF GI%<1 
            GI%=1
          ELSEIF GI%>145
            GI%=145
          ENDIF
          REM'Draw new cursor & Text
          SPOINT:(HT%(GI%),GI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
          REM'Set normal text & graphics mode
          gTMODE 0
          gGMODE 0
        ENDIF
      ENDIF
      REM'
	endif
	REM'
ENDWH 


RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
ALERT("Gtide Error "+GEN$(err,10),err$(err))

ENDP
REM' ==============================================================================================================
PROC SPOINT:(HT%,GI%,BV%,SC,xStart%,yStart%,Graphx%,Graphy%)
REM'================================================================
REM'              Plot Point on Tidal curve & show text values
REM
REM'ENTERED WITH: 
REM'             HT% - Height in metres * 100
REM'             GI% - Index to position of cursor & time 
REM'             BV% - Base value; subtracted to show better curve
REM'             SC  - Scale Factor
REM'        xStart%  - Start x Coord for graph
REM'        yStart%  - Start y Coord for graph
REM'        Graphx%  - Length of X axis of graph
REM'        Graphy%  - Length of Y axis of graph
REM
REM'RETURNS: NIL
REM
REM'================================================================
REM' DECLARE VARIABLES:
Local Y            REM' Y coordinate for plot point
Local LX%          REM' Length of lower part of cross from origin to just below base line
REM'
EXTERNAL MF%       REM' Global Tide height output units - set to 0 for Metres or 1 for feet




REM'Calculate Point to start plotting at
Y=((HT%-BV%)/100.0)+0.1
Y=yStart%-(Y*SC)
gAT (((GI%-1)*(graphx%/145.0))+xStart%),Y


REM'Show graphics cross
REM'Draw Vertical part - sized  to extend to just below base line of graph
LX%=yStart%+4-Y
gMOVE 0,LX%
gLINEBY 0,-(LX%+10)
gMOVE 0,10
REM'Draw Horizontal part
gMOVE -10,0
gLINEBY 20,0
gMOVE -10,0

REM'gPRINT "+"

REM'Show text values of Tide time & Height
REM' Set the Font to use
gfont KFontTimesNormal15&
REM' Set the Text Style (Bold, Underlined etc)
gStyle (KgStyleBold%+KgStyleDoubleHeight%)
REM'
REM'Show Time
gAT 5,200
gPRINT "   TIME: ";O$:((((GI%-1)*10)/60.0),8)
REM'Show Height
gAT 5,230
gPRINT "HEIGHT: ";O$:((HT%/100.0),(9+MF%))
REM'
REM' Set the Font Back to Normal
gfont KFontTimesNormal15&
REM' Set the Text Style (Bold, Underlined etc)
gStyle KgStyleBold%


ENDP
REM' ==============================================================================================================
PROC NPORT:
REM'=========================================================================
REM'            Find Nearest Port for User's Entered Lat & Long
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'=========================================================================
REM'DECLARE VARIABLES:
Local C%,CP%,ERFLAG%,FFLAG%,I%,N%,PD,SL,W%,WW%
REM'CP% - Record number of chosen Port
REM'WW% - Window number
REM'SL - Search limit in degrees
REM'I% - GP Index
REM'FFLAG% - Port found flag
REM'
EXTERNAL IA,IO   REM' Global Lat & Long
EXTERNAL DT		 REM' Global Distance


REM'DEFINE VARIABLES:
REM'Set PD to 6000 miles
PD=6000
REM'Get current Port
OF:(1,0)
  CP%=A.PR%
CLOSE


REM'Show title etc
ti:("Find Nearest Port")

REM'get Position type - Waypoint or Latlong
dINIT ("Search Position"),KDlgFillScreen%
dCHOICE C%,"Type","Waypoint,Lat & Long"
REM' Show OK & Cancel buttons
dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
REM' If user pressed Enter then continue
If DIALOG=KDButtonEnter%
  REM'If Waypoint selected then select a waypoint
  IF C%=1
    REM'Input start waypoint record number
    W%=WC:("Search Waypoint",0,0)
    REM' If no number returned then exit as user selected Cancel
    If W%=0
      RETURN
    ENDIF  
    REM'Read details of Waypoint; Lat & Long returned in IA & IO globals
    N%=WR:(W%)
  ENDIF
  REM'If Lat & Long selected then input a position
  IF C%=2
    gv:(("Search Position"),3)
    N%=0
  ENDIF
  REM
  REM'If input position OK then Search for nearest Port
  IF ERFLAG%<>-1
    I%=1
    FFLAG%=0
    REM'Loop until Port Found or all limits exhausted
    WHILE ((FFLAG%=0) AND (I%<5))
      REM'Show title etc
      ti:("Find Nearest Port")
      REM'Set initial search to 0.5 degs of Lat & Long
      IF I%=1
        SL=0.5
      REM'If 2nd search required then set search limits to 1 deg
      ELSEIF I%=2
        SL=1
      REM'If 3rd search required then set search limits to 2 degs
      ELSEIF I%=3
        SL=2
      REM'If 4th search required then set search limits to 100 degs
      ELSEIF I%=4
        SL=100
      ENDIF
      REM'Compare position of each stored Port
      REM'Open Internal Ports File as B
      OF:(2,0)
      REM'Show busy message
      BUSY "Searching #1"
      WHILE NOT EOF
        REM'If Port reasonably close then calculate distance
        IF ABS(B.LAT-IA)<SL AND ABS(B.LON-IO)<SL
          REM'Get distance in global DT
          CD:(IA,IO,B.LAT,B.LON)
          REM'If Nearer than stored values save new value
          IF DT<PD
            CP%=POS
            PD=DT
            FFLAG%=-1
          ENDIF
        ENDIF
        REM'Read next Port
        NEXT
      ENDWH
      REM'Close Ports file
      CLOSE
      REM'Turn busy off
      BUSY OFF
      REM
      REM'Open User Ports File as B
      OF:(6,0)
      REM'Show busy message
      BUSY "Searching #2"
      WHILE NOT EOF
        REM'If Port reasonably close then calculate distance
        IF ABS(B.LAT-IA)<SL AND ABS(B.LON-IO)<SL
          REM'Get distance in global DT
          CD:(IA,IO,B.LAT,B.LON)
          REM'If Nearer than stored values save new value
          IF DT<PD
            CP%=POS
            PD=DT
            FFLAG%=-1
          ENDIF
        ENDIF
        REM'Read next Port
        NEXT
      ENDWH
      REM'Close Ports file
      CLOSE
      REM'Increment I%
      I%=I%+1
    ENDWH  
    REM'Turn busy off
    BUSY OFF
    REM' Debug
    REM' ALERT ("PORT=",GEN$(CP%,20))
    REM'If no Port was found then alert the user
    IF FFLAG%=0
      GIPRINT "No Port Found"
	ENDIF
    REM'
    REM'If a Port was found then show it
    IF FFLAG%=-1
      REM'Show Nearest Port
      ti:("Nearest Port")
      SPORT:(CP%)
      REM'Show Date & Time Zone
      DA:(1)
    ENDIF  
    REM'  
  ENDIF
ENDIF  
  


ENDP
REM' ==============================================================================================================
PROC gv:(T$,X%)
REM'=====================================================================
REM
REM'Get a common value entered by the user, (with error checking)
REM
REM'Entered with:
REM'T$ - Title for input
REM'X% - Index to value required
REM'     3 for input of Position - Latitude & Longitude
REM
REM'RETURNS: ERFLAG% - Set to -1 if User pressed Esc/Cancel or error occurred
REM
REM'=====================================================================
REM' DECLARE VARIABLES:
Local D&,ERFLAG%,ALT$(7),LAT$(10),LON$(10),V
REM'ERFLAG% - Flag set to -1 (True) if entered value not correct
REM'V - Converted value of input or -999 if Esc pressed
REM'
EXTERNAL IA,IO   REM' Global Lat & Long


REM'DEFINE VARIABLES:
REM' Set error flag to default to true
ERFLAG%=-1


REM'Loop until entered value is correct
DO
  REM'Set Error Flag to false
  ERFLAG%=0
  REM'Select operation for index
  REM
  REM'Latitude & Longitude input
  IF X%=3
    REM'Convert Lat & long to strings
    LAT$=O$:(IA,3)
    LON$=O$:(IO,4)
    REM'Open Dialog
    dINIT T$,KDlgFillScreen%
    dPOSITION 0,1
    REM'Latitude
    dEDIT LAT$,"Latitude",10
    REM'Longitude
    dEDIT LON$,"Longitude",10
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
	REM' If user pressed Enter then continue
    If DIALOG=KDButtonEnter%
      REM'Convert latitude & longitude
      REM'Latitude
      V=in:(LAT$,3)
      REM'If error code of -999 returned then alert user & set flag
      IF V=-999
        ERFLAG%=-1
        ALERT("Your value of "+LAT$,"Is not correct.")
        ELSE
          IA=V
          ERFLAG%=0
        ENDIF
      REM'Longitude
      V=in:(LON$,4)
      REM'If error code of -999 returned then alert user & set flag
      IF V=-999
        ERFLAG%=-1
        ALERT("Your value of "+LON$,"Is not correct.")
      ELSE
        IO=V
        ERFLAG%=0
      ENDIF
      REM'
    ENDIF
    REM'
  ENDIF
UNTIL ERFLAG%=0

REM'Return Error Flag
RETURN ERFLAG%

ENDP
REM' ==============================================================================================================
PROC in:(E$,Z%)
REM'==================================================================
REM'          Convert input strings into numbers and checks validity
REM
REM'ENTERED WITH:
REM'E$ - String value to convert
REM'Z% - Indicator for value type:-
REM'Z%=1 for input of time
REM'Z%=2 for input of Altitude/Longitude interval
REM'Z%=3 for input of Latitude
REM'Z%=4 for input of Longitude
REM'Z%=5 for input of any number
REM'Z%=7 For Input of Course/Bearing - Magnetic bearings converted to TRUE
REM
REM'RETURNS:
REM'Numeric value B or error code -999 if invalid or out of range
REM
REM'==================================================================
REM'DECLARE VARIABLES:
Local A$(14),B$(1),B,C,D$(16),M$(8),S%,X%
REM'
EXTERNAL VY()     REM' Global settings


REM'DEFINE VARIABLES:
REM'Swap input values into local variables
A$=E$

REM'Set error handler
ONERR erhand

REM'*************************
REM'Input of Time (Range check only -already converted using DIALOG routine)
IF Z%=1
  REM'Convert to number
  B=VAL(A$)
  REM'Check if value in range
  IF B<0 OR B>24
    B=-999
  ENDIF
ENDIF
REM'*************************
REM'Input of Altitude
IF Z%=2
  REM'Convert numeric part
  REM'Find out if there is a space delimiter in the string
  X%=LOC(A$," ")
  REM'Get degree string D$ and minutes string M$
  D$=A$ :M$="0"
  REM'If space exists then read degrees ahead of it and minutes after it
  IF X%<>0
    D$=LEFT$(A$,(X%-1))
    M$=RIGHT$(A$,(LEN(A$)-X%))
  ENDIF
  REM'Get whole degrees
  B=VAL(D$)
  REM'Get minutes & convert to decimal degrees
  C=VAL(M$) :C=C/60
  REM'Remake decimal degrees
  B=INT(B)+C
  REM'Check if value in range
  IF B<0 OR B>90
    B=-999
  ENDIF
ENDIF
REM'*************************
REM'Convert Lat/Long dd.mmmmN/S/E/W to decimal degrees dd.dd
IF Z%=3 OR Z%=4
  REM'Get Sign in upper case
  S%=1 :B$=RIGHT$(A$,1) :B$=UPPER$(B$) :IF B$="S" OR B$="W" :S%=-1 :ENDIF
  REM'Remove end character
  A$=LEFT$(A$,(LEN(A$)-1))
  REM'Convert numeric part
  REM'Find out if there is a space delimiter in the string
  X%=LOC(A$," ")
  REM'Get degree string D$ and minutes string M$- use space if one exists
  D$=A$ :M$="0" :IF X%<>0 :D$=LEFT$(A$,(X%-1)) :M$=RIGHT$(A$,(LEN(A$)-X%)) :ENDIF
  REM'Get whole degrees
  B=VAL(D$)
  REM'Get minutes & convert to decimal degrees
  C=VAL(M$) :C=C/60
  REM'Remake decimal degrees
  B=INT(B)+C
  B=B*S%
    REM'Check if value in range
    REM'Latitude
    IF Z%=3 AND ABS(B)>90 :B=-999 :ENDIF
    REM'Longitude
    IF Z%=4 AND ABS(B)>180 :B=-999 :ENDIF
    REM'Check that a letter is appended (N,S,E,W)
    IF B$<>"N" AND B$<>"S" AND B$<>"E" AND B$<>"W"
    B=-999
    ENDIF
ENDIF
REM'********************
REM'Input of any number
IF Z%=5
  B=VAL(A$)
ENDIF
REM'*************************
REM'Input of Course/bearing
IF Z%=7
  REM'Strip end char (ie T or M) off end of string if required
  IF RIGHT$(A$,1)="T" OR RIGHT$(A$,1)="M"
    A$=LEFT$(A$,(LEN(A$)-1))
  ENDIF
  REM'Convert A$ to a numeric value
  B=VAL(A$)
  REM'Check it is in 0-360 limits
  IF B<0 OR B>360
    B=-999
  ENDIF
  REM'Convert Magnetic Bearings to True
  IF VY(1)=0 :B=B+VY(17) :ENDIF
ENDIF
REM'*************************

REM'Return Value B to calling Proc
ONERR OFF
RETURN B

REM'**Error Handler** - Return -999 to signal error
erhand::
ONERR OFF
RETURN -999
ENDP
REM' ==============================================================================================================
PROC CD:(LA,LO,NA,NO)
REM'================================================================
REM'Find course & distance from any Lat/Long to another
REM
REM'Entered with: 
REM'             LA,LO - Lat & Long of start position
REM'             NA,NO - Lat & Long of destination position
REM
REM'RETURNS:
REM'Return Course(True) & Dist in AZ (DEGREES) and DT(MILES) globals
REM
REM'NOTES:
REM'Mercator/Parallel sailing selected automatically
REM'================================================================
REM' DECLARE VARIABLES:
Local E,F,G,H,I,J,K
REM'
EXTERNAL AZ
EXTERNAL DT

REM' DEFINE VARIABLES:
REM'G=Dlat
G=NA-LA
REM'I=dlong
I=NO-LO
REM'If Dlong > 180 take shortest route
J=ABS(I)
IF J >180
  I=(-360*(I/J)+I)
ENDIF
REM' Convert Dlong into minutes
I=I*60

REM'Parallel Sailing
IF ABS(G)<1E-8
  DT=ABS(I*COS(RAD(LA)))
  AZ=90
  IF I<0
    AZ=270
  ENDIF
  REM' Exit proc
  RETURN
ENDIF


REM'Mercator Sailing
REM'Tan Course=Dlong/DMP
REM'Dist=Dlat * Sec course
REM'Find mercator parts (E)for starting Lat LA
REM'By calling MP:(Latitude in degrees)
E=MP:(LA)
REM'Find Mercator parts for destination Latitude NA
F=MP:(NA)
REM'Find DMP(H)
J=1
IF LA<0
  J=-1
ENDIF
K=1
IF NA<0
  K=-1
ENDIF
H=F*K-E*J

REM'Find Course
AZ=ATAN(I/H)
IF G<0
  AZ=AZ+PI
ENDIF
IF AZ<0
  AZ=AZ+(2*PI)
ENDIF

REM'Find Distance
DT=ABS((G*60)/COS(AZ))
AZ=DEG(AZ)

ENDP
REM' ======================================================================================
PROC TTABLE:
REM'==================================================================================
REM'          Display Low & High Water times and heights
REM
REM'ENTERED WITH: 
REM'             DD,MM,YY - Day, Month, Year.
REM
REM'RETURNS: NIL
REM
REM'NOTES: Uses pre-computed HW & LWs for day
REM'==================================================================================
REM'DECLARE VARIABLES:
Local A$(1),k%,AutoFlag%,P$(30),ZZ
Local I%,X%,TOK%,HOK%,NFLAG%,PR%
Local AC&,CH%,CHANGE%(5),CT(5),CHT(5)
Local C$(20),H$(5),MP,DD,MM,YY
Local ExitFlag%             REM' Exit Flag
Local dDate$(255)           REM' Date to Display
Local dDays&                REM' Date in Days from 1/1/1900
REM'P$ - Port Name
REM'ZZ - User Time Zone
REM'I% - Index
REM'C% - Change index
REM'CHANGE%(5) - Change type - 0=LW, 1=HW
REM'CT(5) & CHT(5) - Change Times and Heights ( 1 extra to flag unreliability)
REM'C$ - "LW" or "HW"
REM'X% - GP Index
REM'MP - Moonphase
REM'A$,k%,X% - Menu variables
REM'AutoFlag% - Auto mode variable
REM'TOK%,HO% - TAfs & Tides calculated variables
REM'NFLAG% - New calculation required flag
REM'CH% - Flag for date change
REM'DD,MM,YY - Current day month & year
REM'PR% - Port Record number
REM'
EXTERNAL CurrentPage%    REM' Global current Page - governs Menu actions and updating
EXTERNAL MenuChoice%     REM' Global Menu Item hotkey return code e.g %a
EXTERNAL ExitHK%         REM' Global Exit Key
EXTERNAL IA,IO           REM' Global Lat&Long
EXTERNAL HA,HO           REM' Global Astro Values
EXTERNAL MF%             REM' Metres/Feet Flag
EXTERNAL gCurrentWin%    REM' Global ID of current Screen Window 
EXTERNAL GButChoice%     REM' Global Button number chosen or Zero
EXTERNAL DFLAG%          REM' Global variablle set if Tides or TAFS updated  
EXTERNAL GTimerComp%	 REM' Global Flag set to KTrue% if TImer completed

REM'DEFINE VARIABLES:
REM'Set flag for initial display
NFLAG%=-1
REM' Set Exit Flag to Initial False
ExitFlag%=KFalse%



REM'Loop until Exit Flag is True
WHILE ExitFlag%=KFalse%
  REM'	
  REM'If required then Draw Screen & update all info
  IF NFLAG%
    REM'Retrieve Current user data
    OF:(1,0)
      P$=A.P$
      ZZ=A.Z
      PR%=A.PR%
      TOK%=A.TAF%
      HOK%=A.HOK%
      DD=A.D
      MM=A.M
      YY=A.Y
      MP=A.W
      AutoFlag%=A.X
      MF%=A.MF%
    CLOSE
    REM'
    REM' Set current page value for Menus
    CurrentPage%=KTideTablePage%
    REM'Set the Toolbar buttons
    ToolBarButt:(CurrentPage%)
    REM' Calculate Tides if required
    CalcTide:(AutoFlag%)
    REM'
    REM'Show data
    REM'Show Springs/Neaps & Port
    C$=SPNEAP$:(MP)
    REM'Show Port & Indicator
    ti:(P$+"  "+C$)
    REM'Retrieve Port Lat and Long into globals IA and IO
    IF PR%<=kIPORT%
      OF:(2,0)
      POSITION PR%
    ELSEIF PR%>kIPORT%
      OF:(6,0)
      POSITION (PR%-kIPORT%)
    ENDIF
      IA=B.LAT
      IO=B.LON
    CLOSE
    REM'
    REM' Find Date in Days since 1/1/1900
    dDays&=DAYS(DD*1,MM*1,YY*1)
    REM' Find Date as a string
    dDate$=FindDate$:(dDays&)
    REM'Show Date and Time Zone on top line
    gAT 10,40
    gPRINT dDate$;"   Time Zone: ";GEN$(ZZ,4);
    REM' Add Auto Indicator if set
    If AutoFlag%=KTrue%
      gPRINT "   (Auto)"
    ENDIF  
    REM
    REM'Show Sunrise & Sunset times
    PM:(DD,MM,YY,ZZ)
    gAT 10,90
    gPRINT "Sunrise:";O$:(HA,8)
    gAT 320,90
    gPRINT "Sunset:";O$:(HO,8)
    REM
    REM'Retrieve HW & LW data
    OF:(7,0)
      I%=1
      WHILE I%<6
        CHANGE%(I%)=A.CH
        CHT(I%)=A.HT
        CT(I%)=A.TM
        I%=I%+1
        NEXT
      ENDWH
    CLOSE
    REM'ALERT("CT1=",GEN$(CT(1),10))
    REM'Display High and Low waters
    I%=1 
    WHILE I%<5
      REM'Only show if LW/HW found
      IF CHANGE%(I%)<>0
        H$="LW"
        IF CHANGE%(I%)=1
          H$="HW"
        ENDIF
        REM'Select position to print at
        IF I%=1
          gAT 10,115
        ELSEIF I%=2
          gAT 320,115
        ELSEIF I%=3
          gAT 10,140
        ELSEIF I%=4
          gAT 320,140
        ENDIF
        gPRINT H$;": ";O$:(CT(I%),8);"  ";O$:((CHT(I%)/100.0),(9+MF%))
      ENDIF
      REM'Increment I%
      I%=I%+1
    ENDWH
    REM'If an extra HW/LW found then alert user to unreliability
    REM'ALERT("CT5=",GEN$(CT(5),10))
    REM'IF CT(5)<>0
      REM'BUSY "3 HW/LW FOUND",2
    REM'ENDIF
    REM'Reset flag
    NFLAG%=0
  ENDIF
  REM'
  REM'
  REM' Set the Pointer Filter to discard Drag and Enter/Exit events as these are not wanted in this application
  REM' N.B This MUST be initialised each time
  POINTERFILTER (KPointerFilterDrag%+KPointerFilterEnterExit%),(KPointerFilterDrag%+KPointerFilterEnterExit%)
  REM'
  REM' Wait for the next Event
  Retevent:(AutoFlag%)
  REM'
  REM' Use the current screen for graphics output
  gUse GCurrentWin%
  REM'
  REM'IF AUTO Mode set then update the Tides if the Date has changed
  IF AutoFlag%=KTrue%
    REM' If the Timer completed then check if the Tides need to be updated
    If GTimerComp%=KTrue%
      REM' Calculate Tides if required and set redraw flag
      if CalcTide:(AutoFlag%)
      	NFLAG%=-1
      ENDIF
      REM'  
	ENDIF
  ENDIF  
  REM'
  REM' Set the appropriate Menu choice if a button was pressed
  if GButChoice%<>0
    REM' ALERT("Button pressed=",GEN$(GButChoice%,10))	
    REM' Next Day
    if GButChoice%=1
      MenuChoice%=%n
    REM' Previous Day
    elseif GButChoice%=2
      MenuChoice%=%b
    REM' Nearest Port
    elseif GButChoice%=3
      MenuChoice%=%N
    REM' Close
    elseif GButChoice%=4
      MenuChoice%=ExitHK%
    Endif  	
  endif
  REM'
  REM'
  REM' If it was a valid Menu Choice then select proc to call for required menu option
  if MenuChoice%<>0
    REM'
    REM'
    REM' Files Menu
    REM' Exit  
    If MenuChoice%=ExitHK%
      REM' Set Exit Flag to true
      ExitFlag%=KTrue%
    REM'
    REM' Print File Cascade menu
    REM' Page setup
    ElseIf MenuChoice%=%U
      cmdPageSetup:
    REM'
    REM' Print setup
    ElseIf MenuChoice%=%P
      cmdPrintSetup:
    REM'
    REM' Print preview
    ElseIf MenuChoice%=%V
      PRTIDE:(2,P$,DD,MM,YY,ZZ,C$,HA,HO,-1)
    REM'
    REM' Print File       
    ElseIf MenuChoice%=%p
      PRTIDE:(1,P$,DD,MM,YY,ZZ,C$,HA,HO,-1)
 	REM'
    REM' Help Menu  
    REM' Help
    ElseIf MenuChoice%=%H
      cmdHelp:
    REM' About
    ElseIf MenuChoice%=%A
      cmdAbout:
    REM'
    REM' Data - Date & Time Zone
    ElseIf MenuChoice%=%d
      IF AutoFlag%<>KTrue%
        DA:(1)
        NFLAG%=-1
      ENDIF  
    REM'
    REM' Data - Output Units
    ElseIf MenuChoice%=%u
      DA:(3)
      NFLAG%=-1
    REM'
    REM' Data - Next Day
    ElseIf MenuChoice%=%n
      IF AutoFlag%<>KTrue%
        ChangeDay:(1)
        NFLAG%=-1
      ENDIF  
    REM'
    REM' Data - Previous Day
    ElseIf MenuChoice%=%b
      IF AutoFlag%<>KTrue%
        ChangeDay:(-1)
        NFLAG%=-1
      ENDIF  
    REM'
    REM' Data - Port & Date
    ElseIf MenuChoice%=%D
      REM' Show Port Selector
      ti:("Select Port & Date")
      SPORT:(0)
      REM' Select Date & Time Zone
      IF AutoFlag%<>KTrue%
        DA:(1)
      ENDIF  
      NFLAG%=-1
    REM'
    REM' Data - Nearest Port
    ElseIf MenuChoice%=%N
      REM' Get Lat & Long & Calculate nearest Port index P%
      NPORT:
      NFLAG%=-1
    REM'
    REM' Mode - Manual/AUTO
    ElseIf MenuChoice%=%m
      DA:(2)
      NFLAG%=-1
    REM'
    Endif            
    REM'
  endif
  REM'
ENDWH

REM'If message shown then turn it off
REM'IF CT(5)<>0
  REM'BUSY OFF
REM'ENDIF


ENDP
REM' ==============================================================================================================
PROC PRTIDE:(OP%,P$,DD,MM,YY,ZZ,C$,HA,HO,DH%)
REM'======================================================================
REM'            Print Tides to the Printer Object
REM
REM
REM'ENTERED WITH:
REM' OP% - Index to output required; 1=Straight to Printer, 2=Print Preview
REM' P$ - Port Name
REM' DD,MM,YY - Day,Month,Year
REM' ZZ - Time Zone
REm' C$ - Spring/Neaps Indicator
REM' HA,HO - Sunrise & Sunset Times
REM' DH% - Set to -1 if Hts@ 10 min intervals required too
REM
REM'RETURNS: NIL
REM
REM'======================================================================
REM' DECLARE VARIABLES:
Local C%              REM' Counter for number of items per line
Local I%			  REM' Index
Local T				  REM' Time
Local X				  REM' Temporary variable
Local CHANGE%(5)	  REM' Type of change
Local CT(5)           REM' Time of change
Local CHT(5)		  REM' Height of change
Local H$(5)           REM' Temporary string
Local Temp$(255)      REM' Temporary string
REM'
EXTERNAL MF%          REM' Metres/Feet Flag

REM'DEFINE VARIABLES:

REM'Set error trap
ONERR ErrorTrap::

REM' Tell the User what is happening
BUSY "Arranging Pages"

REM' Delete anything already in the Print buffer
RESETPRINTING:


REM'Retrieve HW & LW data from file
OF:(7,0)
  I%=1
  WHILE I%<6
    CHANGE%(I%)=A.CH
    CHT(I%)=A.HT
    CT(I%)=A.TM
    I%=I%+1
    NEXT
  ENDWH
CLOSE


REM' Send the headings to the Printer
REM' Set Heading Text
SetParagraph:(KArial$,KPrintCenterAlign%,KStrokeWeightBold%,KUnderlineOff%,KPostureUpright%,KPrinterHeading%)
SendLine:("VoyageMaster 5")


REM' Set Normal Text
SetParagraph:(KArial$,KPrintLeftAlign%,KStrokeWeightNormal%,KUnderlineOff%,KPostureUpright%,KPrinterNormal%)

REM'Send Day,Month,Year,TimeZone
Temp$="Day: "+GEN$(DD,4)+"   "+"Month: "+GEN$(MM,4)
SendLine:(Temp$)
Temp$="Year: "+GEN$(YY,4)+"   "+"Your Time Zone: "+GEN$(ZZ,4)
SendLine:(Temp$)


REM'Port & Sp/NP indicator
Temp$=P$+"    "+C$
SendLine:(Temp$)

REM'Print HW & LW Times
I%=1 
WHILE I%<5
  REM'Only show if LW/HW found
  IF CHANGE%(I%)<>0
    REM'Set title
    H$="LW"
    IF CHANGE%(I%)=1
      H$="HW"
    ENDIF
    REM'Print text string
    Temp$=H$+": "+O$:(CT(I%),8)+"  "+O$:((CHT(I%)/100.0),(9+MF%))
    SendLine:(Temp$)
  ENDIF
  REM'Increment I%
  I%=I%+1
ENDWH


REM'Print Sunrise & Sunset
Temp$="Sunrise:"+O$:(HA,8)+"   "+"Sunset:"+O$:(HO,8)
SendLine:(Temp$)


REM'If required, Print All Heights @ 10 minute intervals
IF DH%=-1
  REM'Open pre-computed heights (144* 10 minute intervals) & find HWs & LWs
  OF:(4,0)
    I%=1
    C%=1
    REM'Print all 145 records into array
    WHILE I%<146 
      POSITION I%
      REM'Get time & record height
      T=((I%-1)*10.0)/60.0
      X=(B.HT%/100.0)
      REM'Print out time & height - 3 per line
      REM'1st & 2nd item in line
      IF C%<3
        Temp$=Temp$+O$:(T,8)+"  "+O$:(X,(9+MF%))+"   "
      REM'Last item in line
      ELSE  
        Temp$=Temp$+O$:(T,8)+"  "+O$:(X,(9+MF%))
        SendLine:(Temp$)
        C%=0
        Temp$=""
      ENDIF
      REM'Increment Index & items counter
      I%=I%+1
      C%=C%+1
    ENDWH
  REM'Close file
  CLOSE
ENDIF


REM'Turn busy message off
BUSY OFF

REM' Debug
REM' ALERT("Chars in Print Buffer=",GEN$(PRINTERDOCLENGTH&:,10))


REM' Preview or Print file as directed by user
REM' Show Print Dialog
If OP%=1
  REM' Show Normal Print Dialog
  PRINTDIALOG:
ElseIf OP%=2
  REM' Show the Preview and option buttons
  PRINTPREVIEWDIALOG:
Endif


REM' Delete anything in the Print buffer - in case the User did not Print
RESETPRINTING:



RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
if err=-1
  ALERT("ERROR - Please check that Print Setup is correct and Remote Link is OFF")
  else	
  ALERT("PrTide Error "+GEN$(err,10),err$(err))
endif

REM' Delete anything in the Print buffer - in case the User did not Print
RESETPRINTING:


ENDP
REM'======================================================================================
PROC OPORT:
REM
REM'======================================================================
REM'            Own Ports - Database of user-entered Ports
REM'             - Inspect,Enter or Delete stored Ports
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'======================================================================
REM'DEFINE VARIABLES:
Local B%                    REM' Copy of POS record position
Local X%                    REM' Copy of POS record position
Local ERFLAG%               REM' Input error flag
Local LAT$(10),LON$(10)     REM' LAT$ & LON$ - Position strings
Local X                     REM' Checking variable
Local ExitFlag%             REM' Exit Flag
Local PN$(10),N$(30)        REM' Port ATT Number,Name
Local TZ,A,B                REM' Port Timezone,Lat,Long
Local C,D,E,F,G,H,I,J,K,L,M REM' Port Harmonic constants.
Local xCoord%               REM' X coordinate of pen Click
Local yCoord%               REM' Y coordinate of pen Click
Local Keycode%              REM' Key Code of any key pressed
Local Butclick%	      	    REM' Number of button clicked

REM'
EXTERNAL CurrentPage%    REM' Global current Page - governs Menu actions and updating
EXTERNAL MenuChoice%     REM' Global Menu Item hotkey return code e.g %a
EXTERNAL ExitHK%         REM' Global Exit Key
EXTERNAL gCurrentWin%    REM' Global ID of current Screen Window 
EXTERNAL event&()        REM' Global Event Value
EXTERNAL evtype&         REM' Global Event Value


REM'DEFINE VARIABLES:
REM' Set exit flag to default false
ExitFlag%=KFalse%
REM' Set current page value for Menus
CurrentPage%=KOwnPortPage%
REM' Set the Toolbar buttons
ToolBarButt:(CurrentPage%)



REM' Set Error Trapping
ONERR ErrorTrap::


REM'Open Own Ports file as B
OF:(6,0)
  REM'Select first record
  FIRST


REM'Loop until exit flag is set
WHILE ExitFlag%=KFalse%
  REM'Show title etc
  ti:("Own Ports")
  REM
  REM'
  REM'Show Port
  REM'Show ATT Number string
  gAT 10,40
  gPRINT "ATT No: ";B.PN$;
  REM'Show name
  gAT 10,65
  gPRINT "Name: ";B.N$
  REM'Show Time Zone
  gAT 10,90
  gPRINT "Time Zone: ";B.TZ
  REM'Show Latitude & Longitude
  gAT 10,115
  gPRINT "Latitude: ";O$:(B.LAT,3)
  gAT 10,140
  gPRINT "Longitude: ";O$:(B.LON,4)
  REM
  REM'Show NEXT PREVIOUS and OK buttons 
  ShowButtons:
  REM' Reset Butclick%
  ButClick%=0
  REM'Wait for an Event
  Retevent:(KFalse%)
  REM'
    REM'Exit this function
    If MenuChoice%=ExitHK%
      REM' Set Exit Flag to true
      ExitFlag%=KTrue%
	endif
    REM'
    REM'Delete record
    IF MenuChoice%=%d
      REM'Check user wants to delete
      IF YN:("Delete")
        ERASE
        REM'Set pointer back to first record
        FIRST
      ENDIF
    ENDIF
    REM'
    REM'Find Port number string
    IF MenuChoice%=%f
      REM'Open Dialog for number
      N$=""
      dINIT "Find ATT Number",KDlgFillScreen%
      dEDIT N$,"ATT Number #",10
      REM' Show OK & Cancel buttons
      dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
      REM' If user pressed Enter then continue
      If DIALOG=KDButtonEnter%
        REM'Find number
        B%=0
        X%=POS
        REM'Set pointer to first record
        FIRST
        REM'Loop through file until EOF or number found
        WHILE NOT EOF
          REM'If number found then save position and break loop
          IF N$=B.PN$
            B%=POS
            BREAK
          ENDIF
          NEXT
        ENDWH
        REM'If number found make record current,else reset to present record
        IF B%<>0
          POSITION B%
        ELSE
          POSITION X%
          GIPRINT "Not Found"
        ENDIF
      ENDIF
    ENDIF
    REM'
    REM'Find string in Port Name
    IF MenuChoice%=%t
      REM'Open Dialog for string
      LAT$=""
      dINIT "Find Text"
      dEDIT LAT$,"Find",10
      REM' Show OK & Cancel buttons
      dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
      REM' If user pressed Enter then continue
      If DIALOG=KDButtonEnter%
        REM'Save number of current record, set position to 1st record
        B%=0
        X%=POS
        FIRST
        REM'Find string in record
        B%=DbFind&:("*"+LAT$+"*")
        REM'If string found make record current,else reset to present record
        IF B%<>0
          POSITION B%
        ELSE
          POSITION X%
          GIPRINT "Not Found"
        ENDIF
      ENDIF
    ENDIF
    REM
    REM'New Port and Edit Port and records stored
    IF MenuChoice%=%n OR (MenuChoice%=%E AND COUNT>0)
      REM'Initialise variables for new Port
      IF MenuChoice%=%n
        PN$=""
        N$=""
        LAT$=O$:(0.0,3)
        LON$=O$:(0.0,4)
        TZ=0.0
        A=0.0 :B=0.0 :C=0.0 :D=0.0 :E=0.0 :F=0.0 :G=0.0 :H=0.0
        I=0.0 :J=0.0 :K=0.0 :L=0.0 :M=0.0
      ENDIF
      REM'Initialise variables for Edit Port
      IF MenuChoice%=%E
        PN$=B.PN$
        N$=B.N$
        LAT$=O$:(B.LAT,3)
        LON$=O$:(B.LON,4)
        TZ=B.TZ
        A=B.A%/100.0 
        B=B.B% 
        C=B.C%/100.0  
        D=B.D% 
        E=B.E%/100.0 
        F=B.F% 
        G=B.G%/100.0  
        H=B.H%
        I=B.I%/100.0  
        J=B.J% 
        K=B.K%/1000.0  
        L=B.L% 
        M=B.M%/1000.0 
      ENDIF
      REM'Loop until valid values entered
      DO
        ERFLAG%=0
        IF MenuChoice%=%n
          REM'Open Dialog for new Port
          dINIT "New Port",KDlgFillScreen%
        ELSE
          dINIT "Edit Port",KDlgFillScreen%
        ENDIF
        REM'Port Details
        REM'ATT Number
        dEDIT PN$,"ATT Number#:",10
        REM'Name
        dEDIT N$,"Name:",35
        REM'Time Zone
        dFLOAT TZ,"Time Zone:",-14,14
        REM'Latitude
        dEDIT LAT$,"Latitude:",10
        REM'Longitude
        dEDIT LON$,"Longitude:",10
        REM'Mean Level
        dFLOAT A,"Mean Level Zo:",0,10
        REM' Show OK & Cancel buttons
        dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
        REM' If user pressed Enter then continue
        If DIALOG=KDButtonEnter%
          dINIT ("Constants ATT No# "+PN$),KDlgFillScreen%
          dFLOAT B,"g M2:",0,360
          dFLOAT C,"H.m M2:",0,7
          dFLOAT D,"g S2:",0,360
          dFLOAT E,"H.m S2:",0,7
          dFLOAT F,"g K1:",0,360
          dFLOAT G,"H.m K1:",0,7
          REM' Show OK & Cancel buttons
          dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
          REM' If user pressed Enter then continue
          If DIALOG=KDButtonEnter%
            dINIT ("Constants ATT No# "+PN$),KDlgFillScreen%
            dFLOAT H,"g O1:",0,360
            dFLOAT I,"H.m O1:",0,7
            dFLOAT J,"f4:",0,360
            dFLOAT K,"F4:",0,7
            dFLOAT L,"f6:",0,360
            dFLOAT M,"F6:",0,7
            REM
            REM' Show OK & Cancel buttons
            dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
            REM' If user pressed Enter then continue
            If DIALOG=KDButtonEnter%
              REM'Check if valid input - ERFLAG% set <>0 if invalid
              REM'Check Lat
              X=in:(LAT$,3)
              REM'If error code of -999 returned then alert user & set flag
              IF X=-999
                ERFLAG%=-1
                ALERT("Your value of "+LAT$,"Is not correct.")
              ENDIF
              REM'Check Long
              X=in:(LON$,4)
              REM'If error code of -999 returned then alert user & set flag
              IF X=-999
                ERFLAG%=-1
                ALERT("Your value of "+LON$,"Is not correct.")
              ENDIF
              REM'If valid input then add record to file
              IF NOT ERFLAG%
                REM'Assign values
                B.PN$=PN$
                B.N$=N$
                B.LAT=IN:(LAT$,3)
                B.LON=IN:(LON$,4)
                B.TZ=TZ
                B.A%=A*100.0 
                B.B%=B 
                B.C%=C*100.0  
                B.D%=D 
                B.E%=E*100.0 
                B.F%=F 
                B.G%=G*100.0  
                B.H%=H
                B.I%=I*100.0  
                B.J%=J 
                B.K%=K*1000.0  
                B.L%=L 
                B.M%=M*1000.0 
                REM'IF new Port then append record
                IF MenuChoice%=%n
                  APPEND
                REM'If edited Port then update present record
                ELSE
                  UPDATE
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      UNTIL ERFLAG%=0
    ENDIF
  REM'
  REM'
  REM' If the Event was a Pointer Event on the current screen then evaluate it
  if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
    REM' NOTE:Can also trap pen touching (evType&=KEvPtrEnter&) or leaving screen (evType&=KEvPtrExit&) but these DO NOT return x,y coords 
    REM'
    REM' Get the Pen coords
	xCoord%=event&(KEvAPtrScreenPosX%)
    yCoord%=event&(KEvAPtrScreenPosY%)
    REM' Evaluate if it was a button click
	ButClick%=TestButtons:(xCoord%,yCoord%)
  endif
  REM'
  REM'
  REM' If the Event was a Keypress then evaluate it
  if ((evType& AND &400)=0)
    KeyCode%=event&(1)	
    REM' ALERT("You pressed a key","Code="+GEN$(KeyCode%,10))
    REM' Evaluate the Keypress
    if KeyCode%=%b
	  ButClick%=1
    elseif KeyCode%=%n
	  ButClick%=2
    elseif (KeyCode%=KKeyEnter%)
	  ButClick%=3
    elseif (KeyCode%=KKeyEsc%)
	  ButClick%=4
    endif	
  endif
  REM'
  REM'Show PREVIOUS Port
  IF ButClick%=1
    REM'Check current record position; see if pointer at first record
    B%=POS
    REM'Show previous Waypoint
    BACK
    REM'If previously at start of file then show last record
    IF B%=1
      LAST
    ENDIF
  ENDIF
  REM
  REM'Show next Port
  IF ButClick%=2
    NEXT
    REM'If EOF then show first Port
    IF EOF
      FIRST
    ENDIF
  ENDIF
  REM
  REM Set Exit Flag
  IF ButClick%=3 OR ButClick%=4
	ExitFlag%=KTrue%
  endif
REM'End loop if user selects Exit
ENDWH
REM'Close file
CLOSE

RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
ALERT("Oport Error "+GEN$(err,10),err$(err))
REM' Try and close the file
TRAP CLOSE


ENDP
REM'======================================================================================
PROC ShowButtons:
REM'========================================================================================
REM'               Show buttons for required operation
REM'
REM'ENTERED WITH: NIL
REM'
REM'RETURNS: NIL
REM'
REM' NOTE: Change TESTBUTTONS proc if button position or size is changed in this proc
REM'========================================================================================
REM'DECLARE VARIABLES:
Local ButWidth%(4),ButHt%(4)   REM' Button Dimensions
Local Butx%(4),Buty%(4)        REM' Coordinates to start drawing top left of button at
Local Tempx%                   REM' Temporary Integer 
Local Tempy%                   REM' Temporary Integer 
REM'
EXTERNAL ScrWid%		 REM' Screen width in pixels
EXTERNAL ScrHght%		 REM' Screen height in pixels



REM'DEFINE VARIABLES:
ButWidth%(1)=80
ButHt%(1)=30
ButWidth%(2)=80
ButHt%(2)=30
ButWidth%(3)=80
ButHt%(3)=30
ButWidth%(4)=80
ButHt%(4)=30


REM' Calculate coordinates for buttons
Tempx%=(ScrWid%-ButWidth%(1))/5
Tempy%=ScrHght%-ButHt%(1)-3
Butx%(1)=Tempx%*1
Buty%(1)=Tempy%
Butx%(2)=Tempx%*2
Buty%(2)=Tempy%
Butx%(3)=Tempx%*3
Buty%(3)=Tempy%
Butx%(4)=Tempx%*4
Buty%(4)=Tempy%



REM' Show BACK Button
REM' Position button start for drawing (top left corner of button)
gAT Butx%(1),Buty%(1)
gBUTTON "BACK",KButtS5%,ButWidth%(1),ButHt%(1),KButtS5Raised%

REM' Show NEXT Button
REM' Position button start for drawing (top left corner of button)
gAT Butx%(2),Buty%(2)
gBUTTON "NEXT",KButtS5%,ButWidth%(2),ButHt%(2),KButtS5Raised%

REM' Show OK Button
REM' Position button start for drawing (top left corner of button)
gAT Butx%(3),Buty%(3)
gBUTTON "OK",KButtS5%,ButWidth%(3),ButHt%(3),KButtS5Raised%

REM' Show CANCEL Button
REM' Position button start for drawing (top left corner of button)
gAT Butx%(4),Buty%(4)
gBUTTON "CANCEL",KButtS5%,ButWidth%(4),ButHt%(4),KButtS5Raised%


ENDP
REM' ==============================================================================================================
PROC TestButtons:(Clickx%,Clicky%)
REM'========================================================================================
REM'               Test if a ShowButtons button has been clicked
REM'
REM'ENTERED WITH: Clickx% - x coordinate of pen click
REM'              Clicky% - y coordinate of pen click
REM'
REM'RETURNS: Butclick% - 0 or 1 for BACK, 2 for NEXT or 3 for OK or 4 for CANCEL button clicked
REM'
REM'========================================================================================
REM'DECLARE VARIABLES:
Local ButWidth%(4),ButHt%(4)   REM' Button Dimensions
Local Butx%(4),Buty%(4)        REM' Coordinates to start drawing top left of button at
Local Tempx%                   REM' Temporary Integer 
Local Tempy%                   REM' Temporary Integer 
Local Butclick%				   REM' Number of button clicked
REM'
EXTERNAL ScrWid%		 REM' Screen width in pixels
EXTERNAL ScrHght%		 REM' Screen height in pixels



REM'DEFINE VARIABLES:
ButWidth%(1)=80
ButHt%(1)=30
ButWidth%(2)=80
ButHt%(2)=30
ButWidth%(3)=80
ButHt%(3)=30
ButWidth%(4)=80
ButHt%(4)=30
REM' Set button clicked to default zero
ButClick%=0


REM' Calculate coordinates for buttons
Tempx%=(ScrWid%-ButWidth%(1))/5
Tempy%=ScrHght%-ButHt%(1)-3
Butx%(1)=Tempx%*1
Buty%(1)=Tempy%
Butx%(2)=Tempx%*2
Buty%(2)=Tempy%
Butx%(3)=Tempx%*3
Buty%(3)=Tempy%
Butx%(4)=Tempx%*4
Buty%(4)=Tempy%



REM' See if a button was clicked
If clicky%>Tempy%
  REM'BACK Button
  if (Clickx%>Butx%(1)) AND (Clickx%<(Butx%(1)+ButWidth%(1)))
    ButClick%=1
  endif
  REM'NEXT Button
  if (Clickx%>Butx%(2)) AND (Clickx%<(Butx%(2)+ButWidth%(2)))
    ButClick%=2
  endif
  REM'OK Button
  if (Clickx%>Butx%(3)) AND (Clickx%<(Butx%(3)+ButWidth%(3)))
    ButClick%=3
  endif
  REM'CANCEL Button
  if (Clickx%>Butx%(4)) AND (Clickx%<(Butx%(4)+ButWidth%(4)))
    ButClick%=4
  endif
endif
 
REM' ALERT("Button clicked=",GEN$(ButClick%,10))

RETURN ButClick%


ENDP
REM' ==============================================================================================================
PROC YN:(M$)
REM'=====================================================================
REM'                     Yes/No procedure
REM
REM'Entered with: M$ - Message
REM
REM'Returns: -1 for YES,0 for NO
REM'=====================================================================
REM'DECLARE VARIABLES:
Local YN%,X%
REM'YN% - YES/NO index
REM'X% - DIALOG variable; indicates if Esc pressed

REM'Define Variables
YN%=1
X%=1

REM'Put up dialog
dINIT
dPOSITION 0,1
dCHOICE YN%,M$+"?","Yes,No"
X%=DIALOG
REM'Examine choice
REM'Yes
IF YN%=1
  YN%=-1
ENDIF
REM'No or Esc
IF YN%=2 OR X%=0
  YN%=0
ENDIF

RETURN YN%
ENDP
REM' ==============================================================================================================
PROC Waypoints:
REM'=========================================================================
REM'            Inspect,Enter or Delete stored Waypoints
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'=========================================================================
REM'DECLARE VARIABLES:
Local B%,ERFLAG%,k%,LAT$(10),LON$(10),F$(35),SFLAG%,S$(35),N&
Local X,X%
REM'LAT$ & LON$ - Position strings
REM'F$ & S$ - First & Second description strings
REM'N& - Long integer for number
REM'ERFLAG% - Input error flag
REM'SFLAG% - Flag showing file requires to be sorted
Local ExitFlag%             REM' Exit Flag
Local xCoord%               REM' X coordinate of pen Click
Local yCoord%               REM' Y coordinate of pen Click
Local Keycode%              REM' Key Code of any key pressed
Local Butclick%	      	    REM' Number of button clicked
Local RecNum%               REM' Number of current record shown
Local NoWpts%               REM' Number of Waypoints in file
Local OkFlag%               REM' Flag for free number found
REM'
EXTERNAL CurrentPage%    REM' Global current Page - governs Menu actions and updating
EXTERNAL MenuChoice%     REM' Global Menu Item hotkey return code e.g %a
EXTERNAL ExitHK%         REM' Global Exit Key
EXTERNAL gCurrentWin%    REM' Global ID of current Screen Window 
EXTERNAL event&()        REM' Global Event Value
EXTERNAL evtype&         REM' Global Event Value
EXTERNAL IA,IO           REM' Global Lat & Long
EXTERNAL GButChoice%	 REM' Global number of button clicked


REM'DEFINE VARIABLES:
REM' Set exit flag to default false
ExitFlag%=KFalse%
REM' Set current page value for Menus
CurrentPage%=KWaypointPage%
REM' Set the record to show to 1
RecNum%=1

REM' Set Error Trapping
ONERR ErrorTrap::



REM'Loop until user selects exit
WHILE ExitFlag%=KFalse%
  REM'Open Waypoints file
  OF:(5,0)
  	REM' Read the number of Waypoints in the file
    NoWpts%=COUNT
    REM'Show title etc
    ti:("Waypoints ("+GEN$(NoWpts%,10)+")")
    REM'
    REM'Select the required record
    Position RecNum%
    REM'Show Waypoint
    REM'Show Number
    gAT 10,40
    gPRINT "Number #: ";A.A%;
    REM'Show name/description on 2 lines
    gAT 10,65
    gPRINT "Name: ";A.B$
    gAT 10,90
    gPRINT "Notes: ";A.E$
    REM'Show Latitude & Longitude
    gAT 10,115
    gPRINT "Latitude: ";O$:(A.C,3)
    gAT 10,140
    gPRINT "Longitude: ";O$:(A.D,4)
  REM' Close File  
  CLOSE  
  REM'
  REM'Show NEXT PREVIOUS and OK buttons 
  ShowButtons:
  REM' Reset Butclick%
  ButClick%=0
  REM' Set the Toolbar buttons
  ToolBarButt:(KWaypointPage%)
  REM'
  REM' Set the Pointer Filter to discard Drag and Enter/Exit events as these are not wanted in this application
  REM' N.B This MUST be initialised each time
  POINTERFILTER (KPointerFilterDrag%+KPointerFilterEnterExit%),(KPointerFilterDrag%+KPointerFilterEnterExit%)
  REM'
  REM'Wait for an Event
  Retevent:(KFalse%)
  REM'
  REM
  REM' Use the current screen for graphics output
  gUse GCurrentWin%
  REM'
  REM' ALERT("GButChoice%=",GEN$(GButChoice%,10))
  REM' If a Toolbar button was clicked then evaluate it
  If GButChoice%<>0
    REM' Find Number
    If GButChoice%=1
      MenuChoice%=%f
  	Endif
    REM' Find Text
    If GButChoice%=2
      MenuChoice%=%t
  	Endif
  Endif
  REM'
  REM'Exit this function
  If MenuChoice%=ExitHK%
    REM' Set Exit Flag to true
    ExitFlag%=KTrue%
  endif
  REM'
  REM' Page setup
  If MenuChoice%=%U
    cmdPageSetup:
  endif  
  REM'
  REM' Print setup
  If MenuChoice%=%P
    cmdPrintSetup:
  endif  
  REM'
  REM' Print preview
  If MenuChoice%=%V
    PrintWayp:(2)
  endif  
  REM'
  REM' Print File       
  If MenuChoice%=%p
    PrintWayp:(1)
  endif  
  REM'
  REM'Delete record
  IF MenuChoice%=%d
    REM'Check user wants to delete
    IF YN:("Delete")
      OF:(5,0)
        REM'Select the required record
        Position RecNum%
        ERASE
        REM'Set pointer back to first record
        RecNum%=1
      CLOSE  
    ENDIF
  ENDIF
  REM
  REM'Find Waypoint number
  IF MenuChoice%=%f
    REM'Open Dialog for number
    N&=1
    dINIT "Find Number",KDlgFillScreen%
    dLONG N&,"Number #",1,1000
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
    REM' If user pressed Enter then continue
    if DIALOG=KDButtonEnter%
      REM'Find number
      OF:(5,0)
        B%=0
        REM'Set pointer to first record
        FIRST
        REM'Loop through file until EOF or number found
        WHILE NOT EOF
          REM'If number found then save position and break loop
          IF A.A%=N&
            B%=POS
            BREAK
          ENDIF
          NEXT
        ENDWH
        REM'If number found make record current,else reset to present record
        IF B%<>0
          RecNum%=B%
        ELSE
          GIPRINT "Not Found"
        ENDIF
      REM' Close File
      CLOSE  
    ENDIF
  ENDIF
  REM'Find string in Waypoint
  IF MenuChoice%=%t
    REM'Open Dialog for string
    LAT$=""
    dINIT "Find Text",KDlgFillScreen%
    dEDIT LAT$,"Find",10
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
    REM' If user pressed Enter then continue
    If DIALOG=KDButtonEnter%
      OF:(5,0)
        REM'Select the required record
        Position RecNum%
        REM'Save number of current record, set position to 1st record
        B%=0
        FIRST
        REM'Find string in record
        B%=DbFind&:("*"+LAT$+"*")
        REM'If string found make record current,else reset to present record
        IF B%<>0
          RecNum%=B%
        ELSE
          GIPRINT "Not Found"
        ENDIF
      REM'Close File
      CLOSE 
    ENDIF
  ENDIF
  REM
  REM'New Waypoint and Edit Waypoint and Insert Waypoint
  IF MenuChoice%=%n OR MenuChoice%=%E OR MenuChoice%=%i
    REM'Initialise variables for new Waypoint
    IF MenuChoice%=%n OR MenuChoice%=%i
      F$=""
      S$=""
      LAT$=O$:(0.0,3)
      LON$=O$:(0.0,4)
      REM'Find next available waypoint number
      BUSY "Searching"
      REM' Open file
      OF:(5,0)
        REM'Increment number until a free number is found
        B%=0
		REM' Loop until a free number is found
		OkFlag%=KFalse%
        WHILE OkFlag%=KFalse%
          REM' Set flag to default true
          OkFlag%=KTrue%
          REM' Increment number
          B%=B%+1
          REM'
          REM' Examine each record
          REM' Select first record	
          FIRST
          WHILE NOT EOF
            REM'If number in use then set flag
            IF B%=A.A%
              OkFlag%=KFalse%
            ENDIF
            REM' Select next record  	
            NEXT
         ENDWH
        ENDWH
      REM' Close File
      CLOSE
      BUSY OFF  
      REM'Set number to free one found
      N&=B%
    ENDIF
    REM'Initialise variables for Edit Waypoint
    IF MenuChoice%=%E
      OF:(5,0)
        REM'Select the required record
        Position RecNum%
		N&=A.A%
        LAT$=O$:(A.C,3)
        LON$=O$:(A.D,4)
        F$=A.B$
        S$=A.E$
      REM' Close File
      CLOSE  
    ENDIF
    REM'Loop until valid values entered
    DO
      ERFLAG%=0
      IF MenuChoice%=%n
        REM'Open Dialog for Waypoint
        dINIT "New Waypoint",KDlgFillScreen%
      ELSEIF MenuChoice%=%E
        dINIT "Edit Waypoint",KDlgFillScreen%
      ELSEIF MenuChoice%=%i
        dINIT "Insert Waypoint",KDlgFillScreen%
      ENDIF
      REM'Number
      dLONG N&,"Number #",1,1000
      REM'First description string
      dEDIT F$,"Name",35
      REM'Second description string
      dEDIT S$,"Notes",35
      REM'Latitude
      dEDIT LAT$,"Latitude",10
      REM'Longitude
      dEDIT LON$,"Longitude",10
      REM'
      REM' Show OK & Cancel buttons
      dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
      REM' If user pressed Enter then continue
      If DIALOG=KDButtonEnter%
        REM'Convert latitude & longitude
        REM'Latitude
        X=in:(LAT$,3)
        REM'If error code of -999 returned then alert user & set flag
        IF X=-999
          ERFLAG%=-1
          ALERT("Your value of "+LAT$,"Is not correct.")
          ELSE IA=X
        ENDIF
        REM'Longitude
        X=in:(LON$,4)
        REM'If error code of -999 returned then alert user & set flag
        IF X=-999
          ERFLAG%=-1
          ALERT("Your value of "+LON$,"Is not correct.")
          ELSE IO=X
        ENDIF
        REM'Check Waypoint number
        IF MenuChoice%=%n OR MenuChoice%=%i
          OF:(5,0)
            B%=0
            REM'Set pointer to first record
            FIRST
            REM'Loop through file until EOF or number found
            WHILE NOT EOF
              REM'If number found then save position and break loop
              IF N&=A.A%
                B%=POS
                BREAK
              ENDIF
            NEXT
            ENDWH
          REM' Close FIle
          CLOSE  
          REM'If number found then alert user & set flag
          IF B%<>0
            ERFLAG%=-1
            ALERT("Your Waypoint number is already in use.")
          ENDIF
        ENDIF
        REM'If valid input then append record to file
        IF NOT ERFLAG%
          REM' If Insert then add a blank record at EOF
          if MenuChoice%=%i
          	REM' Open the file and add a blank record
            OF:(5,0)
    	      REM' Begin Transaction
              BEGINTRANS
                INSERT	
				PUT
       	      REM' Commit the changes to the file
              COMMITTRANS
            REM' Close the File  so it now has an extra record
            CLOSE
          ENDIF
          REM'  
          REM' Open File	
          OF:(5,0)
            REM'Select the required record
            Position RecNum%
    	    REM' Begin Transaction
            BEGINTRANS
            REM'If new waypoint then append a blank record at end of file
            IF MenuChoice%=%n
              INSERT	
            ENDIF
            REM' If Insert then move all the old record values down by one
            if MenuChoice%=%i
              WaypInsert:
              FIRST
              Position RecNum%
            endif  
			REM'
		    REM' If Edit or Insert then set the mode to modify so the current record is not moved
            IF MenuChoice%=%E OR MenuChoice%=%i
              MODIFY
            ENDIF
            REM'Write to the Fields in WYPTS=Number,Name,Latitude,Longtitude,Note
            A.A%=N&
            A.B$=F$
            A.C=IA
            A.D=IO
            A.E$=S$
		    REM' Write the record
		    PUT
       	    REM' Commit the changes to the file
            COMMITTRANS
          REM' Close File
          CLOSE  
          REM'Set sort flag
          SFLAG%=-1
        ENDIF
      ENDIF
    UNTIL ERFLAG%=0
  ENDIF
  REM'
  REM' If the Event was a Pointer Event on the current screen then evaluate it
  if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
    REM' NOTE:Can also trap pen touching (evType&=KEvPtrEnter&) or leaving screen (evType&=KEvPtrExit&) but these DO NOT return x,y coords 
    REM'
    REM' Get the Pen coords
	xCoord%=event&(KEvAPtrScreenPosX%)
    yCoord%=event&(KEvAPtrScreenPosY%)
    REM' Evaluate if it was a button click
	ButClick%=TestButtons:(xCoord%,yCoord%)
  endif
  REM'
  REM'
  REM' If the Event was a Keypress then evaluate it
  if ((evType& AND &400)=0)
    KeyCode%=event&(1)	
    REM' ALERT("You pressed a key","Code="+GEN$(KeyCode%,10))
    REM' Evaluate the Keypress
    if KeyCode%=KKeyEnter%
	  ButClick%=3
    elseif KeyCode%=%b
	  ButClick%=1
    elseif KeyCode%=%n
	  ButClick%=2
    endif	
  endif
  REM'
  REM'Show PREVIOUS Waypoint
  IF ButClick%=1
    RecNum%=RecNum%-1
    if Recnum%<1
      Recnum%=NoWpts%
    endif  	
  ENDIF
  REM
  REM'
  REM'Show NEXT Waypoint
  IF ButClick%=2
    RecNum%=RecNum%+1
    REM'If EOF then show first Waypoint
    IF RecNum%>NoWpts%
      RecNum%=1	
    ENDIF
  ENDIF
  REM'
  REM' Set Exit Flag
  IF (ButClick%=3) OR (ButClick%=4)
	ExitFlag%=KTrue%
  endif
  REM'
REM'End loop if Exit selected
ENDWH

REM'If Flag set then sort File
REM' IF SFLAG%
REM'   BUSY "Sorting"
REM'   FS:(5)
REM'   BUSY OFF
REM' ENDIF

RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
ALERT("WP Error "+GEN$(err,10),err$(err))
REM' Try and close the file
TRAP CLOSE


ENDP
REM' ==============================================================================================================
PROC FS:(F%)
REM'===================================================================
REM'          Reverse Bubble Sort Data file into numerical order
REM
REM'Entered with: F%
REM'5 = Waypoints File.
REM'= Routes File.
REM
REM'Returns: NIL
REM
REM'NOTES:                  ***Design of sort.***
REM'Ex page 105 of series 3 programming manual
REM'===================================================================
REM'DECLARE VARIABLES:
Local last%,e%,lpos%,X%

REM'Open File
OF:(F%,0)

REM'Set pointer to last record
LAST
REM'Record number of last record
last%=POS
REM'Sort file if not empty
IF COUNT>0
  REM'Loop until last record read
  WHILE last%<>0
    POSITION last%
    e%=POS
    X%=A.A%
    REM'For each record
    DO
      IF A.A%<X%
        X%=A.A%
        e%=POS
      ENDIF
      lpos%=POS
      BACK
    UNTIL POS=1 AND lpos%=1
    POSITION e%
    REM'PRINT X%
    UPDATE
    REM'Decrement last%
    last%=last%-1
  ENDWH
ENDIF
CLOSE

ENDP
REM' ==============================================================================================================
PROC dr:(C,D,SA,SO)
REM'================================================================
REM'Calculate New DR,given course(C) and distance(D) and
REM
REM'Entered with:
REM'Starting decimal Lat SA and Long SO
REM
REM'RETURNS:
REM'Lat&Long in IA&IO globals
REM
REM'Mercator/Paralell sailing selected automatically
REM'================================================================
REM'DECLARE VARIABLES:
Local A,B,E,F,G,H,I,J%,K%
REM'
EXTERNAL IA,IO   REM' Global Lat & Long

A=SA
B=SO
E=RAD(A)
G=RAD(C)

REM'Parallel Sailing
IF ABS(COS(G))<1E-10
  H=1
  IF SIN(G)<0
    H=-1
  ENDIF
  I=D/(60*COS(E))*H
  IA=A
  IO=B+I
  REM'Check IO(Long) not >180
  B=ABS(IO)
  IF B>180
    IO=(IO/B)*(-360+B)
  ENDIF
  RETURN
ENDIF

REM'Mercator Sailing
REM'Tan Course=Dlong/DMP
REM'Dist=Dlat * Sec course

REM'Find new Lat
H=D*COS(G)
IA=A+H/60

REM'Find new long
REM'Find mercator parts(F) for NEW Lat
F=MP:(IA)
REM'Find mercator parts (E)for old Lat
E=MP:(A)
REM'Find DMP(I)
K%=1 :IF IA<0 :K%=-1 :ENDIF
J%=1 :IF A<0 :J%=-1 :ENDIF
I=ABS(E*J%-F*K%)
REM'Dlong=TAN Co*DMP
I=ABS(TAN(G))*I
REM'If SIN Course is negative then apply westbound dlong
IF SIN(G)<0 :I=I*-1. :ENDIF
REM'If Distance is a negative then reverse sign of dlong
IF D<0 :I=I*-1. :ENDIF
IO=B+I/60
REM'Check IO(Long) not >180
B=ABS(IO)
IF B>180
  IO=(IO/B)*(-360+B)
ENDIF

ENDP
REM' ==============================================================================================================
PROC ShowPort:(PortNumber$,PortName$,PortLat,PortLon)
REM' =========================================================================================
REM'                     Show Port for SPORT function
REM'
REM' ENTERED WITH: PortNumber$,PortName$,PortLat,PortLon - Port Details
REM'
REM'
REM' RETURNS: NIL
REM'
REM' =========================================================================================
    
REM' Set Screen Updating Off
gUpdate off

REM'Show ATT Number string
gAT 10,40
gPRINT "ATT No: ";PortNumber$

REM'Show name
gAT 10,65
gPRINT "Name: ";PortName$

REM'Show Latitude & Longitude
gAT 10,90
gPRINT "Latitude: ";O$:(PortLat,3)
gAT 10,115
gPRINT "Longitude: ";O$:(PortLon,4)

REM' Set Screen Updating ON
gUpdate ON


ENDP
REM' ==============================================================================================================
PROC WR:(R%)
REM'===================================================================
REM'                  Read details of a Waypoint
REM
REM'ENTERED WITH:
REM'R% - Number of Waypoint RECORD (NOT the waypoint number)
REM
REM'Returns:
REM'Number in N%
REM'Latitude in IA
REM'Longitude in IO
REM
REM'===================================================================
REM'DECLARE VARIABLES:
Local N%
REM'
EXTERNAL IA,IO   REM' Global Lat& Long


REM'Open Waypoints File
OF:(5,0)
REM'Read record
POSITION R%
  N%=A.A%
  IA=A.C
  IO=A.D
REM'Close File
CLOSE


REM'Return Number
RETURN N%

ENDP
REM' ==============================================================================================================
PROC WC:(M$,O%,A%)
REM'=====================================================================
REM'                           Waypoint Choose
REM
REM'ENTERED WITH:
REM'M$=Message to precede waypoint choice
REM'O%=Old/Present Waypoint No
REM'A%=Array No of waypoint in Route file record
REM
REM'RETURNS:
REM'Chosen waypoint RECORD number in B% or Zero if Cancel/Close selected
REM
REM'
REM'=====================================================================
REM' DECLARE VARIABLES:
Local B%,N&,X%,L$(10),OW%,WW%
REM'OW% - Original window Id
REM'WW% - This window's id
Local xCoord%            REM' X coordinate of pen Click
Local yCoord%            REM' Y coordinate of pen Click
Local Keycode%           REM' Key Code of any key pressed
Local Butclick%	      	 REM' Number of button clicked
Local ExitFlag%          REM' Flag set for exit proc 
REM'
EXTERNAL CurrentPage%    REM' Global current Page - governs Menu actions and updating
EXTERNAL MenuChoice%     REM' Global Menu Item hotkey return code e.g %a
EXTERNAL ExitHK%         REM' Global Exit Key
EXTERNAL gCurrentWin%    REM' Global ID of current Screen Window 
EXTERNAL event&()        REM' Global Event Value
EXTERNAL evtype&         REM' Global Event Value
  

REM'DEFINE VARIABLES:
REM' Set Exit Flag to Initial False
ExitFlag%=KFalse%
REM' Set current page value for Menus
CurrentPage%=KWaypChoosePage%
REM' Set the Toolbar buttons
ToolBarButt:(KNullPage%)


REM'Open Waypoints file
OF:(5,0)
REM'Select first record
FIRST


REM'Loop until Exit Flag is True
WHILE ExitFlag%=KFalse%
  REM'Show title etc
  ti:(M$)
  REM
  REM'Show Waypoint
  REM'Show Number
  gAT 10,40
  gPRINT "Number #: ";A.A%;
  REM'Show name/description on 2 lines
  gAT 10,65
  gPRINT "Name: ";A.B$
  gAT 10,90
  gPRINT "Notes: ";A.E$
  REM'Show Latitude & Longitude
  gAT 10,115
  gPRINT "Latitude: ";O$:(A.C,3);"  Longitude: ";O$:(A.D,4)
  REM
  REM'Show NEXT PREVIOUS and OK buttons 
  ShowButtons:
  REM' Reset Butclick%
  ButClick%=0
  REM'Wait for an Event
  Retevent:(KFalse%)
  REM'
  REM'Exit this function
  If MenuChoice%=ExitHK%
    REM' Set Button choice to 4 (CANCEL)
    ButClick%=4
  endif
  REM'
  REM'Find Waypoint number
  IF MenuChoice%=%f
    REM'Open Dialog for number
    N&=1
    dINIT "Find Number",KDlgFillScreen%
    dLONG N&,"Number #",1,1000
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
    REM' If user pressed Enter then continue
    If DIALOG=KDButtonEnter%
      REM'Find number
      B%=0
      X%=POS
      REM'Set pointer to first record
      FIRST
      REM'Loop through file until EOF or number found
      WHILE NOT EOF
        REM'If number found then save position and break loop
        IF A.A%=N&
          B%=POS
          BREAK
        ENDIF
        NEXT
      ENDWH
      REM'If number found make record current,else reset to present record
      IF B%<>0
        POSITION B%
      ELSE
        POSITION X%
        GIPRINT "Not Found"
      ENDIF
    ENDIF
    REM'
  ENDIF
  REM'Find string in Waypoint
  IF MenuChoice%=%t
    REM'Open Dialog for string
    L$=""
    dINIT "Find Text",KDlgFillScreen%
    dEDIT L$,"Find",10
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
    REM' If user pressed Enter then continue
    If DIALOG=KDButtonEnter%
      REM'Find string
      B%=0
      X%=POS
      REM'Set pointer to first record
      FIRST
      B%=DbFind&:("*"+L$+"*")
      REM'If string found make record current,else reset to present record
      IF B%<>0
        POSITION B%
      ELSE
        POSITION X%
        GIPRINT "Not Found"
      ENDIF
    ENDIF
  ENDIF
  REM
  REM'
  REM' If the Event was a Pointer Event on the current screen then evaluate it
  if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
    REM' NOTE:Can also trap pen touching (evType&=KEvPtrEnter&) or leaving screen (evType&=KEvPtrExit&) but these DO NOT return x,y coords 
    REM'
    REM' Get the Pen coords
	xCoord%=event&(KEvAPtrScreenPosX%)
    yCoord%=event&(KEvAPtrScreenPosY%)
    REM' Evaluate if it was a button click
	ButClick%=TestButtons:(xCoord%,yCoord%)
  endif
  REM'
  REM'
  REM' If the Event was a Keypress then evaluate it
  if ((evType& AND &400)=0)
    KeyCode%=event&(1)	
    REM' ALERT("You pressed a key","Code="+GEN$(KeyCode%,10))
    REM' Evaluate the Keypress
    if KeyCode%=%b
	  ButClick%=1
    elseif KeyCode%=%n
	  ButClick%=2
    elseif KeyCode%=KKeyEnter%
	  ButClick%=3
    elseif KeyCode%=KKeyEsc%
	  ButClick%=4
    endif	
  endif
  REM'
  REM'Show PREVIOUS Waypoint
  IF ButClick%=1
    REM'Check current record position; see if pointer at first record
    B%=POS
    REM'Show previous Waypoint
    BACK
    REM'If previously at start of file then show last record
    IF B%=1
      LAST
    ENDIF
  ENDIF
  REM
  REM'
  REM'Show NEXT Waypoint
  IF ButClick%=2
    NEXT
    REM'If EOF then show first Waypoint
    IF EOF
      FIRST
    ENDIF
  ENDIF
  REM'
  REM' If OK clicked then Set Exit Flag and set number of record chosen
  IF ButClick%=3
	ExitFlag%=KTrue%
    REM'Save current record number in B%
    B%=POS
  endif
  REM'
  REM' If CANCEL clicked then Set Exit Flag and set record to 0 to signal abort
  IF ButClick%=4
	ExitFlag%=KTrue%
    REM'Set number to Zero
    B%=0
  endif
  REM'
REM'End loop if Waypoint selected
ENDWH


REM'Close file
CLOSE

REM' ALERT("Waypoint Record Chosen=",GEN$(B%,10))

REM'Return record number selected
RETURN B%

ENDP
REM' ==============================================================================================================
PROC ShowHighLow:
REM' ==============================================================================================================
REM'         Show High and Low Water Times and Heights on Graphic Tide Display
REM'
REM'
REM' ENTERED WITH: NIL
REM'
REM'
REM'RETURNS: NIL
REM'
REM'
REM' ==============================================================================================================
REM' DECLARE VARIABLES:
Local CHANGE%(5),CT(5),CHT(5) REM' Change Tide data
Local I%     REM' Index
Local H$(10) REM' HW/LW string
REM'
EXTERNAL MF% REM'Metres/Feet output Flag


REM'Retrieve HW & LW data
OF:(7,0)
  I%=1
  WHILE I%<6
    CHANGE%(I%)=A.CH
    CHT(I%)=A.HT
    CT(I%)=A.TM
    I%=I%+1
    NEXT
  ENDWH
CLOSE



REM'Display High and Low waters
I%=1 
WHILE I%<5
  REM'Only show if LW/HW found
  IF CHANGE%(I%)<>0
    H$="LW"
    IF CHANGE%(I%)=1
      H$="HW"
    ENDIF
    REM'Select position to print at
    IF I%=1
      gAT 1,60
    ELSEIF I%=2
      gAT 1,80
    ELSEIF I%=3
      gAT 1,100
    ELSEIF I%=4
      gAT 1,120
    ENDIF
    REM' Show it
    gPRINT H$;" ";O$:(CT(I%),8);"  ";O$:((CHT(I%)/100.0),(9+MF%))
  ENDIF
  REM'
  REM'Increment I%
  I%=I%+1
ENDWH


ENDP
REM' ==============================================================================================================
PROC ToolBarButt:(ChoicePage%)
REM' ==============================================================================================================
REM'                 Initialise the Toolbar Buttons
REM'
REM'ENTERED WITH: ChoicePage% - Set to the constants defined for the calling page e.g KMainPage%
REM'
REM'
REM'RETURNS: NIL
REM'
REM'
REM' NOTES: It is not necessary to refresh the screen after this proc; the buttons change immediately
REM' (Note: Stub procedures must be provided for each button hot key eg proc cmde%: for Close)
REM' Add a chr$(10) if button text required on 2 lines e.g GButtontext$(3)="Save"+chr$(10)+"file"
REM' BITMAPS stored in GBarBit&() and corresponding GBarMask&() Are:
REM' (1) Binoculars (FIND)
REM' (2) Return Arrow (CLOSE)
REM' (3) Tidal Graph (For Tidal Graph Display)
REM' (4) Tide Table
REM' (5) SAVE AS
REM' (6) +1 DAY
REM' (7) -1 DAY
REM' (8) BLANK
REM'
REM'
REM' ==============================================================================================================
REM' DECLARE VARIABLES:
Local BarBit&(4)
Local BarMask&(4)
Local Index%
REM'
EXTERNAL GButtonkey%()	  REM' Global Button Hot key ASCII codes
EXTERNAL GButtontext$()   REM' Global Button Titles    
EXTERNAL ExitHK%          REM' Exit Hot key 
REM'
EXTERNAL GBarBit&()        REM' Toolbar Icon IDs
EXTERNAL GBarMask&()       REM' Toolbar Mask IDs


REM'DEFINE VARIABLES:
REM' Make sure all Bitmask IDs are set to the Blank Bitmap
Index%=1
Do
  BarBit&(Index%)=GBarBit&(8)
  BarMask&(Index%)=GBarMask&(8)
  Index%=Index%+1
Until Index%>4


REM' Set Error Trapping
ONERR ErrorTrap::



REM' Main screen Page
if ChoicePage%=KMainPage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)="Tide"+chr$(10)+"Graph"
  GButtonkey%(1)=%n
  GButtontext$(2)="Tide"+chr$(10)+"Table"
  GButtonkey%(2)=%b
  GButtontext$(3)="Save"+chr$(10)+"As"
  GButtonkey%(3)=%s
  GButtontext$(4)="Close"
  GButtonkey%(4)=ExitHK%
  REM' Set any bitmap Icon Bitmaps
  BarBit&(1)=GBarBit&(3)
  BarMask&(1)=GBarMask&(3)
  BarBit&(2)=GBarBit&(4)
  BarMask&(2)=GBarMask&(4)
  BarBit&(3)=GBarBit&(5)
  BarMask&(3)=GBarMask&(5)
  BarBit&(4)=GBarBit&(2)
  BarMask&(4)=GBarMask&(2)
endif

REM' Tide Table Page
if ChoicePage%=KTideTablePage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)="+"+chr$(10)+"1 Day"
  GButtonkey%(1)=%n
  GButtontext$(2)="-"+chr$(10)+"1 Day"
  GButtonkey%(2)=%b
  GButtontext$(3)="Nearest"+chr$(10)+"Port"
  GButtonkey%(3)=%s
  GButtontext$(4)="Close"
  GButtonkey%(4)=ExitHK%
  REM' Set any bitmap Icon Bitmaps
  BarBit&(1)=GBarBit&(6)
  BarMask&(1)=GBarMask&(6)
  BarBit&(2)=GBarBit&(7)
  BarMask&(2)=GBarMask&(7)
  BarBit&(3)=GBarBit&(1)
  BarMask&(3)=GBarMask&(1)
  BarBit&(4)=GBarBit&(2)
  BarMask&(4)=GBarMask&(2)
endif
  
REM' Graphic Tide page
if ChoicePage%=KGraphPage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)="+"+chr$(10)+"1 Day"
  GButtonkey%(1)=%n
  GButtontext$(2)="-"+chr$(10)+"1 Day"
  GButtonkey%(2)=%b
  GButtontext$(3)="Nearest"+chr$(10)+"Port"
  GButtonkey%(3)=%s
  GButtontext$(4)="Close"
  GButtonkey%(4)=ExitHK%
  REM' Set any bitmap Icon Bitmaps
  BarBit&(1)=GBarBit&(6)
  BarMask&(1)=GBarMask&(6)
  BarBit&(2)=GBarBit&(7)
  BarMask&(2)=GBarMask&(7)
  BarBit&(3)=GBarBit&(1)
  BarMask&(3)=GBarMask&(1)
  BarBit&(4)=GBarBit&(2)
  BarMask&(4)=GBarMask&(2)
endif

REM' Own Ports page
if ChoicePage%=KOwnPortPage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)=""
  GButtonkey%(1)=%n
  GButtontext$(2)=""
  GButtonkey%(2)=%b
  GButtontext$(3)=""
  GButtonkey%(3)=%s
  GButtontext$(4)=""
  GButtonkey%(4)=ExitHK%
endif

REM'Select Port page
if ChoicePage%=KSelectPortPage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)="Search"+chr$(10)+"Ports"
  GButtonkey%(1)=%n
  GButtontext$(2)=""
  GButtonkey%(2)=%b
  GButtontext$(3)=""
  GButtonkey%(3)=%s
  GButtontext$(4)=""
  GButtonkey%(4)=ExitHK%
  REM' Set any bitmap Icon Bitmaps
  BarBit&(1)=GBarBit&(1)
  BarMask&(1)=GBarMask&(1)
endif

REM' Waypoints page
if ChoicePage%=KWaypointPage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)=""
  GButtonkey%(1)=%n
  GButtontext$(2)=""
  GButtonkey%(2)=%b
  GButtontext$(3)=""
  GButtonkey%(3)=%s
  GButtontext$(4)=""
  GButtonkey%(4)=ExitHK%
endif

REM' Route page
if ChoicePage%=KRoutePage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)=""
  GButtonkey%(1)=%n
  GButtontext$(2)=""
  GButtonkey%(2)=%b
  GButtontext$(3)=""
  GButtonkey%(3)=%s
  GButtontext$(4)=""
  GButtonkey%(4)=ExitHK%
endif


REM' Null Page (no menus or available buttons)
if ChoicePage%=KNullPage%
  REM' Define the Toolbar Buttons
  GButtontext$(1)=""
  GButtonkey%(1)=%n
  GButtontext$(2)=""
  GButtonkey%(2)=%b
  GButtontext$(3)=""
  GButtonkey%(3)=%s
  GButtontext$(4)=""
  GButtonkey%(4)=ExitHK%
endif



REM' Initialise the Toolbar buttons for Shortcut key,Order,Title,State,bitmap,mask,flags
REM' TBarButt:(chr$(GButtonkey%(1)),1,GButtontext$(1),0,&0,&0,0)
TBarButt:(chr$(GButtonkey%(1)),1,GButtontext$(1),0,BarBit&(1),BarMask&(1),0)
TBarButt:(chr$(GButtonkey%(2)),2,GButtontext$(2),0,BarBit&(2),BarMask&(2),0)
TBarButt:(chr$(GButtonkey%(3)),3,GButtontext$(3),0,BarBit&(3),BarMask&(3),0)
TBarButt:(chr$(GButtonkey%(4)),4,GButtontext$(4),0,BarBit&(4),BarMask&(4),0)

RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
ALERT("ToolBarButt Error "+GEN$(err,10),err$(err))


ENDP
REM' ==============================================================================================================
PROC ChangeDay:(NoDays%)
REM' ==============================================================================================================
REM'                  Move Stored Date by a required Number of Days
REM'
REM'
REM'ENTERED WITH: NoDays% - Number of Days to change Date by e.g -1, +1,+2 etc
REM'
REM'
REM'RETURNS: NIL (New Date saved in user data file)
REM'
REM'
REM' ==============================================================================================================
REM' DECLARE VARIABLES:
Local DD,MM,YY           REM' Day,Month,Year 
Local Year%				 REM'Integer Year
Local Month%             REM'Integer Month
Local Day%               REM'Integer Day 
Local DateDays&          REM'Date in Days since 1/1/1900


REM' DEFINE VARIABLES:
REM'Retrieve the Current date
OF:(1,0)
  DD=A.D
  MM=A.M
  YY=A.Y
CLOSE


REM' Find the number of Days since 1/1/1900
DateDays&=DAYS(DD*1,MM*1,YY*1)

REM' Change Number of Days as required
DateDays&=DateDays&+NoDays%

REM' Convert the Days to Day,Month,Year
DAYSTODATE DateDays&,Year%,Month%,Day%


REM' Save to File
OF:(1,0)
  A.D=Day%
  A.M=Month%
  A.Y=Year%
  REM' Set the Flags so Tafs and Heights are calculated
  A.TAF%=0
  A.HOK%=0
  REM' Update the record
  UPDATE
CLOSE


ENDP
REM' ==============================================================================================================
PROC SearchPorts:
REM' ==============================================================================================================
REM'						 Input a string and Search the Ports Files for it
REM'
REM' ENTERED WITH: NIL
REM'
REM'
REM' RETURNS: FoundPort% - The Record number of the Port found or Zero if no match found
REM'
REM'
REM' ==============================================================================================================
REM' DECLARE VARIABLES:
Local Index%        REM' Index
Local FoundPort%    REM' Record number of Port found
Local Search$(20)	REM' Search string


REM' DEFINE VARIABLES:
REM' Set found Port record to zero
FoundPort%=0


REM'Input the search string
dINIT "Search Ports",KDlgFillScreen%
REM' Position the Dialog
dPOSITION -1,-1
REM' Get the string
dEDIT Search$,"Text to Find:",20
REM'
REM' Show OK & Cancel buttons
dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
REM'
REM' If user pressed Enter then search for the string
If DIALOG=KDButtonEnter%
  REM'
  REM' Make the text upper case
  Search$=UPPER$(Search$)
  REM'
  REM' Open the inbuilt Ports file and search through it
  REM' Open File as B
  OF:(2,0)
  	FIRST
    Index%=1
    REM' Loop until the file has been searched
    WHILE NOT EOF
      REM' if found then set return value	
      IF  LOC(B.N$,SEARCH$)
      	FoundPort%=Index%
      ENDIF
      REM' Increment Index
      Index%=Index%+1	
      REM' Increment Record
      NEXT
    ENDWH	
    REM'
  REM' Close the File
  CLOSE  
  REM'
  REM' If not found then Open the User Ports file and search through it
  If FoundPort%=0
    REM' Open File as B
    OF:(6,0)
  	  FIRST
      REM' Loop until the file has been searched
      WHILE NOT EOF
        REM' if found then set return value	
        IF  LOC(B.N$,SEARCH$)
      	  FoundPort%=Index%
        ENDIF
        REM' Increment Index
        Index%=Index%+1	
        REM' Increment Record
        NEXT
      ENDWH	
      REM'
    REM' Close the File
    CLOSE  
    REM'
  ENDIF  
  REM'
  REM' If the string was not found then tell the User
  If FoundPort%=0
    GIPRINT "NOT FOUND"
  Endif
  REM'
Endif

REM' ALERT("FoundPort%=",GEN$(FoundPort%,10))

REM' Return the Found Port record Number
RETURN FoundPort%


ENDP
REM' ==============================================================================================================
PROC Route:
REM'======================================================================
REM'                  Show a Waypoint File as a Route Plan
REM'
REM'ENTERED WITH: NONE
REM'
REM'RETURNS: NONE  
REM'
REM'NOTES: 
REM'======================================================================
REM'DECLARE VARIABLES:
Local Keycode%              REM' Key Code of any key pressed
Local Butclick%	      	    REM' Number of button clicked
Local xCoord%,yCoord%       REM' x,y position for button click
Local ExitFlag%             REM' Flag set to TRUE to exit procedure
Local Rtpos%                REM' Current Waypoint number in Route
Local RtFile$(255)          REM' Route File Name
Local N%                    REM' Record Number
Local X                     REM' Total Distance 
Local E,F                   REM' Temporary values
Local G$(35)				REM' Name of Waypoint
Local N&                    REM' Number of Waypoint 
Local DestLat,DestLon       REM' Destination Lat & Long
Local DestNum&              REM' Number of Destination Waypoint 
Local DestName$(35)         REM' Name of Destination Waypoint
Local NoWypts%              REM' Number of Waypoints
REM'
EXTERNAL AZ,DT           REM' Global Course and Distance values
EXTERNAL CurrentPage%    REM' Global current Page - governs Menu actions and updating
EXTERNAL MenuChoice%     REM' Global Menu Item hotkey return code e.g %a
EXTERNAL ExitHK%         REM' Global Exit Key
EXTERNAL gCurrentWin%    REM' Global ID of current Screen Window 
EXTERNAL GButChoice%     REM' Global Button number chosen or Zero
EXTERNAL event&()        REM' Global Event Value
EXTERNAL evtype&         REM' Global Event Value
EXTERNAL ProgFile$       REM' GLobal Filename


REM' Set error trapping
ONERR ER


REM'DEFINE VARIABLES
REM' Set Exit flag to default False
ExitFlag%=KFalse%
REM'Set Waypoint Index number
Rtpos%=0
REM' Set current page value for Menus
CurrentPage%=KRoutePage%
REM' Set the Toolbar buttons
ToolBarButt:(CurrentPage%)


REM' Get the current Waypoints Filename
Rtfile$=getDoc$


REM'Show Title
ti:("Plan Route")



REM'Show busy
BUSY "Calculating"

REM' Calculate Total Distance
REM'Reset record number etc
X=0
N%=1
REM' Open the current Waypoints File as A
OF:(5,0)
  REM' Get number of Waypoints in file
  NoWypts%=COUNT
  REM'
  REM'Calculate total distance - loop until all Waypoints read
  DO
    REM'Read Waypoint FROM
    POSITION N%
    REM'Read Lat & Long
    E=A.C
    F=A.D
    REM'If not EOF then read Waypoint TO
    POSITION(N%+1)
    IF NOT EOF
      REM' Read destination Lat&long
      DestLat=A.C
      DestLon=A.D	
      REM'Calculate Rhumb Line course & distance
  	  CD:(E,F,DestLat,DestLon)
  	  REM'Add to Total distance
  	  X=X+DT
    ENDIF
    REM'
    REM'Increment Index N%
    N%=N%+1
  UNTIL EOF
REM' Close File
CLOSE  
  
REM'Switch busy off
BUSY OFF


REM'Set first leg to show to 1
N%=1


REM'Loop until user selects exit
WHILE ExitFlag%=KFalse%
  REM'Show Title
  ti:("Plan Route")
  REM'
  REM' Open the current Waypoints File as A
  OF:(5,0)
    REM'Show each leg as required
    REM'Read Waypoint FROM
    POSITION N%
    REM'Read Lat & Long
    E=A.C
    F=A.D
    REM'Read Name & Number
    G$=A.B$
    N&=A.A%
    REM'
    REM'If not EOF then read Waypoint TO
    POSITION(N%+1)
    IF NOT EOF
      REM' Read destination Lat&long
      DestLat=A.C
      DestLon=A.D	
      DestNum&=A.A%
      DestName$=A.B$
      REM'Calculate Rhumb Line course & distance
      CD:(E,F,DestLat,DestLon)
	  REM'
	  REM'Show Waypoint from
	  gAT 10,40
	  gPRINT "FROM Wpt#";GEN$(N&,10);" ";G$
	  gAT 10,65
	  gPRINT "Latitude:";O$:(E,3);"  Longitude:";O$:(F,4)
	  REM'Show Waypoint to
	  gAT 10,90
	  gPRINT "TO Wpt#";GEN$(DestNum&,10);" ";DestName$
	  gAT 10,115
	  gPRINT "Latitude:";O$:(DestLat,3);"  Longitude:";O$:(DestLon,4)
	  REM'Show course & distance
	  gAT 10,140
	  gPRINT "RL Course=";O$:(AZ,5);"  RL Distance=";O$:(DT,6)
    ENDIF
  REM'Close Route File
  CLOSE
  REM'
  REM'Show Total distance
  gAT 10,165
  gPRINT "Total Distance in miles=";O$:(X,6)
  REM'
  REM'Show NEXT PREVIOUS and OK buttons 
  ShowButtons:
  REM' Reset Butclick%
  ButClick%=0
  REM'Wait for an Event
  Retevent:(KFalse%)
  REM'
  REM' If it was a valid Menu Choice then select proc to call for required menu option
  if MenuChoice%<>0
    REM'
    REM'
    REM' Files Menu
    REM' Exit  
    If MenuChoice%=ExitHK%
      REM' Set Exit Flag to true
      ExitFlag%=KTrue%
    REM'
    REM' Print File Cascade menu
    REM' Page setup
    ElseIf MenuChoice%=%U
      cmdPageSetup:
    REM'
    REM' Print setup
    ElseIf MenuChoice%=%P
      cmdPrintSetup:
    REM'
    REM' Print preview
    ElseIf MenuChoice%=%V
      PrintRoute:(2,X)
    REM'
    REM' Print File       
    ElseIf MenuChoice%=%p
      PrintRoute:(1,X)
    REM'
    Endif
  Endif  
  REM'
  REM' If the Event was a Pointer Event on the current screen then evaluate it
  if (evType&=KEvPtr&) AND (event&(KEvAPtrWindowId%)=GCurrentWin%)
    REM' NOTE:Can also trap pen touching (evType&=KEvPtrEnter&) or leaving screen (evType&=KEvPtrExit&) but these DO NOT return x,y coords 
    REM'
    REM' Get the Pen coords
	xCoord%=event&(KEvAPtrScreenPosX%)
    yCoord%=event&(KEvAPtrScreenPosY%)
    REM' Evaluate if it was a button click
	ButClick%=TestButtons:(xCoord%,yCoord%)
  endif
  REM'
  REM'
  REM' If the Event was a Keypress then evaluate it
  if ((evType& AND &400)=0)
    KeyCode%=event&(1)	
    REM' ALERT("You pressed a key","Code="+GEN$(KeyCode%,10))
    REM' Evaluate the Keypress
    if KeyCode%=%b
	  ButClick%=1
    elseif KeyCode%=%n
	  ButClick%=2
    elseif KeyCode%=KKeyEnter%
	  ButClick%=3
    elseif KeyCode%=KKeyEsc%
	  ButClick%=4
    endif	
  endif
  REM'
  REM'Show next leg
  if ButClick%=2
    REM'Increment leg
    N%=N%+1
    REM' Check Result is in range
    if N%>=NoWypts%
      N%=NoWypts%-1
    endif
	IF N%<1
	  N%=1
	ENDIF
  ENDIF  
  REM'
  REM'Show PREVIOUS Leg
  if ButClick%=1
    N%=N%-1
    REM'Check result does not go back past first record
	IF N%<1
	  N%=1
	ENDIF
  ENDIF
  REM'
  REM' Exit Loop for OK/CANCEL
  if (ButClick%=3) OR (ButClick%=4)
  	ExitFlag%=KTrue%
  endif
  REM'
  REM'
REM'End main proc loop if Exit selected
ENDWH




REM'Return
RETURN
REM'-------------------------------------
REM'Error Handler
ER::
ONERR OFF
ALERT(("ERROR "+"Route"+" "+GEN$(ERR,5)),ERR$(ERR))
REM'Try closing any open files
TRAP CLOSE


ENDP
REM' ==============================================================================================================
PROC PrintRoute:(OP%,TotalDist)
REM'======================================================================
REM'            Print Route to the Printer Object
REM'
REM'
REM'ENTERED WITH: 
REM'             OP%       - Index to output required; 1=Straight to Printer, 2=Print Preview
REM'             TotalDist - Total Distance in miles
REM'
REM'RETURNS: NIL
REM'
REM'
REM'======================================================================
REM' DECLARE VARIABLES:
Local C%                    REM' Counter for number of items per line
Local Temp$(255)            REM' Temporary string
Local N%                    REM' Record Number
Local X                     REM' Total Distance 
Local E,F                   REM' Temporary values
Local G$(35)				REM' Name of Waypoint
Local N&                    REM' Number of Waypoint 
Local DestLat,DestLon       REM' Destination Lat & Long
Local DestNum&              REM' Number of Destination Waypoint 
Local DestName$(35)         REM' Name of Destination Waypoint
Local NoWypts%              REM' Number of Waypoints
Local File$(255)            REM' Name of current file                  
REM'
EXTERNAL AZ,DT           REM' Global Course and Distance values


REM'DEFINE VARIABLES:


REM'Set error trap
ONERR ErrorTrap::

REM' Tell the User what is happening
BUSY "Arranging Pages"

REM' Delete anything already in the Print buffer
RESETPRINTING:

REM' Get the current document Name
file$=getdoc$

REM' Send the headings to the Printer
REM' Set Heading Text
SetParagraph:(KArial$,KPrintCenterAlign%,KStrokeWeightBold%,KUnderlineOff%,KPostureUpright%,KPrinterHeading%)
SendLine:("VoyageMaster 5")

REM' Set Normal Text
SetParagraph:(KArial$,KPrintLeftAlign%,KStrokeWeightNormal%,KUnderlineOff%,KPostureUpright%,KPrinterNormal%)

REM'Show filename
Temp$="Document:"+File$
SendLine:(Temp$)

REM'Show Total distance
Temp$="Total Distance in miles="+O$:(TotalDist,6)
SendLine:(Temp$)


REM' Open the current Waypoints File as A
OF:(5,0)
  REM' Get total Number of Waypoints
  NoWypts%=COUNT
  REM'
  REM' Set Initial Record Number to 1
  N%=1
  REM' Loop and print each leg
  WHILE N%<NoWypts%
	REM'
    REM'Read Waypoint FROM
    POSITION N%
    REM'Read Lat & Long
    E=A.C
    F=A.D
    REM'Read Name & Number
    G$=A.B$
    N&=A.A%
    REM'
    REM'If not EOF then read Waypoint TO
    POSITION(N%+1)
    IF NOT EOF
      REM' Read destination Lat&long
      DestLat=A.C
      DestLon=A.D	
      DestNum&=A.A%
      DestName$=A.B$
      REM'Calculate Rhumb Line course & distance
      CD:(E,F,DestLat,DestLon)
	  REM'
	  REM'Show Waypoint from
	  Temp$="FROM Wpt#"+GEN$(N&,10)+" "+G$
      SendLine:(Temp$)
	  Temp$="Latitude:"+O$:(E,3)+"  Longitude:"+O$:(F,4)
      SendLine:(Temp$)
      REM'
	  REM'Show Waypoint to
	  Temp$="TO Wpt#"+GEN$(DestNum&,10)+" "+DestName$
	  SendLine:(Temp$)
	  Temp$="Latitude:"+O$:(DestLat,3)+"  Longitude:"+O$:(DestLon,4)
      SendLine:(Temp$)
	  REM'Show course & distance
	  Temp$="RL Course="+O$:(AZ,5)+"  RL Distance="+O$:(DT,6)
      SendLine:(Temp$)
    ENDIF
    REM'
    REM' Increment Record Number
    N%=N%+1
  ENDWH
  REM'
REM'Close Route File
CLOSE



REM'Turn busy message off
BUSY OFF

REM' Debug
REM' ALERT("Chars in Print Buffer=",GEN$(PRINTERDOCLENGTH&:,10))

REM' MYEDIT

REM' Preview or Print file as directed by user
REM' Show Print Dialog
If OP%=1
  REM' Show Normal Print Dialog
  PRINTDIALOG:
ElseIf OP%=2
  REM' Show the Preview and option buttons
  PRINTPREVIEWDIALOG:
Endif


REM' Delete anything in the Print buffer - in case the User did not Print
RESETPRINTING:



RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
if err=-1
  ALERT("ERROR - Please check that Print Setup is correct and Remote Link is OFF")
  else	
  ALERT("PrintRoute Error "+GEN$(err,10),err$(err))
endif

REM' Try and Close any open files
TRAP CLOSE
REM' Delete anything in the Print buffer - in case the User did not Print
RESETPRINTING:


ENDP
REM' ======================================================================================
PROC PrintWayp:(OP%)
REM'======================================================================
REM'            Print Waypoints to the Printer Object
REM'
REM'
REM'ENTERED WITH: 
REM'             OP%       - Index to output required; 1=Straight to Printer, 2=Print Preview
REM'
REM'RETURNS: NIL
REM'
REM'
REM'======================================================================
REM' DECLARE VARIABLES:
Local C%                    REM' Counter for number of items per line
Local Temp$(255)            REM' Temporary string
Local N%                    REM' Record Number
Local X                     REM' Total Distance 
Local E,F                   REM' Temporary values
Local G$(35)				REM' Name of Waypoint
Local Note$(128)			REM' Notes for Waypoint
Local N&                    REM' Number of Waypoint 
Local NoWypts%              REM' Number of Waypoints
Local File$(255)           REM' Name of file
REM'
EXTERNAL AZ,DT           REM' Global Course and Distance values


REM'DEFINE VARIABLES:


REM'Set error trap
ONERR ErrorTrap::

REM' Tell the User what is happening
BUSY "Arranging Pages"

REM' Delete anything already in the Print buffer
RESETPRINTING:

REM' Get filename
File$=GetDoc$


REM' Send the headings to the Printer
REM' Set Heading Text
SetParagraph:(KArial$,KPrintCenterAlign%,KStrokeWeightBold%,KUnderlineOff%,KPostureUpright%,KPrinterHeading%)
SendLine:("VoyageMaster 5")


REM' Set Normal Text
SetParagraph:(KArial$,KPrintLeftAlign%,KStrokeWeightNormal%,KUnderlineOff%,KPostureUpright%,KPrinterNormal%)

REM'Show filename
Temp$="Document:"+File$
SendLine:(Temp$)

REM' Open the current Waypoints File as A
OF:(5,0)
  REM' Get total Number of Waypoints
  NoWypts%=COUNT
  REM'
  REM' Set Initial Record Number to 1
  N%=1
  REM' Loop and print each Waypoint
  WHILE N%<=NoWypts%
	REM'
    REM'Read Waypoint
    POSITION N%
    REM'Read Lat & Long
    E=A.C
    F=A.D
    REM'Read Name & Number
    G$=A.B$
    N&=A.A%
    REM' Read Notes
    Note$=A.E$
	REM'
	REM'Show Waypoint
	Temp$="Waypoint#: "+GEN$(N&,10)
    SendLine:(Temp$)
	Temp$="Name: "+G$
    SendLine:(Temp$)
	Temp$="Notes: "+Note$
    SendLine:(Temp$)
	Temp$="Latitude:"+O$:(E,3)+"  Longitude:"+O$:(F,4)
    SendLine:(Temp$)
    REM'
    REM' Increment Record Number
    N%=N%+1
  ENDWH
  REM'
REM'Close Waypoints File
CLOSE



REM'Turn busy message off
BUSY OFF

REM' Debug
REM' ALERT("Chars in Print Buffer=",GEN$(PRINTERDOCLENGTH&:,10))

REM' MYEDIT

REM' Preview or Print file as directed by user
REM' Show Print Dialog
If OP%=1
  REM' Show Normal Print Dialog
  PRINTDIALOG:
ElseIf OP%=2
  REM' Show the Preview and option buttons
  PRINTPREVIEWDIALOG:
Endif


REM' Delete anything in the Print buffer - in case the User did not Print
RESETPRINTING:



RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
if err=-1
  ALERT("ERROR - Please check that Print Setup is correct and Remote Link is OFF")
  else	
  ALERT("PrintWayp Error "+GEN$(err,10),err$(err))
endif

REM' Try and Close any open files
TRAP CLOSE
REM' Delete anything in the Print buffer - in case the User did not Print
RESETPRINTING:


ENDP
REM'======================================================================================
PROC WaypInsert:
REM'=========================================================================
REM'   Move all Waypoints down by one, to leave the current Waypoint record "blank"
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'
REM' NOTES: 
REM' Must be entered with the Waypoint file opened and the selected record as current
REM'=========================================================================
REM'DECLARE VARIABLES:
Local F$(35),S$(35)        REM' First & Second description strings
Local N&                   REM' Long integer for number
Local Lat,Lon              REM' Lat,Long
Local OLDF$(35),OLDS$(35)  REM' First & Second description strings
Local OLDN&                REM' Long integer for number
Local OLDLat,OLDLon        REM' Lat,Long



REM' Set Error Trapping
ONERR ErrorTrap::


REM' Read the current Waypoint values - Fields in WYPTS=Number,Name,Latitude,Longtitude,Note
N&=A.A%
F$=A.B$
Lat=A.C
Lon=A.D
S$=A.E$


REM' Loop until all records have been moved down by one
WHILE NOT EOF
  REM' Select the next record
  NEXT
  REM' If not EOF then read the next Waypoint values and write the current values to it
  IF NOT EOF
  	 REM' Read the present values
     OLDN&=A.A%
     OLDF$=A.B$
     OLDLat=A.C
     OLDLon=A.D
     OLDS$=A.E$
     REM' Write the current values to it
     MODIFY
     A.A%=N&
     A.B$=F$
     A.C=Lat
     A.D=Lon
     A.E$=S$
     PUT
  	 REM' Swop the values so ready to write them to next record
     N&=OLDN&
     F$=OLDF$
     Lat=OLDLat
     Lon=OLDLon
     S$=OLDS$
  ENDIF
ENDWH


RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
ALERT("WaypInsert Error "+GEN$(err,10),err$(err))
REM' Try and close the file
TRAP CLOSE


ENDP
REM' ==============================================================================================================
PROC iocheck%:(p%,code%)
REM' ==================================================================================
REm'              Open Timer Channels etc - show error if command failed
REM'
REM' ENTERED WITH: CODE% - If non-zero then error occurred in IO... function
REm'
REM' RETURNS: NIL
REM' ==================================================================================

IF code%
  ALERT("Iocheck ERROR",GEN$(p%,10))
  REM' Cleanup and exit program
  cleanup%:(code%)
  REM' Exit programm
  STOP
ENDIF


ENDP
REM' ==============================================================================================================
PROC STimer%:
REM' ==================================================================================
REM'                           Start a relative timer
REM'
REM' ENTERED WITH:
REM'          GTimerChan%       REM' Global Timer Channel ID
REM'
REM' RETURNS: 
REM'          GTimerStat%       REM' Global Asynchronous Timer request status word 
REM'          GTimerReqFlag%    REM' Global Flag set to KTrue% if request for Timer has been made
REM'
REM' NOTES: The Timer Channel MUST be opened first
REM' =================================================================================
REM' DECLARE VARIABLES:
Local Timeout&    REM' Timeout in tenths of a second
REM'
EXTERNAL GTimerReqFlag%    REM' Global Flag set to KTrue% if request for Timer has been made
EXTERNAL GTimerChan%       REM' Global Timer Channel ID
EXTERNAL GTimerStat%       REM' Global Asynchronous Timer request status word 


REM' DEFINE VARIABLES:
REM' Define Timeout in tenths of a second
Timeout&=50


REM' Only Start Timer if it is not already running
IF GTimerReqFlag%=KFalse%
  REM' Start relative timer (Chan%,1) which will complete in Tout& tenths of a second
  REM' - use Chan%,2 for an absolute timer
  iocheck%:(4,IOA(GTimerChan%,1,GTimerStat%,Timeout&,#0))
  REM' Set the Timer requested Flag to True
  GTimerReqFlag%=KTrue%
ENDIF

ENDP
REM' ==============================================================================================================
PROC EnTimer%:
REM' ====================================================================================
REM'             If a Timer request is outstanding then cancel it
REM'
REM' ENTERED WITH:
REM'
REM' RETURNS:
REM'
REm' ====================================================================================
EXTERNAL GTimerReqFlag%    REM' Global Flag set to KTrue% if request for Timer has been made
EXTERNAL GTimerChan%       REM' Global Timer Channel ID
EXTERNAL GTimerStat%       REM' Global Asynchronous Timer request status word 

REm' Only cancel Timer if a request is outstanding
IF GTimerReqFlag%=KTrue%
  IOW(GTimerChan%,4,#0,#0)
  IOWAITSTAT GTimerStat%
  REM' Set the requested flag to false
  GTimerReqFlag%=KFalse%
ENDIF

ENDP
REM' ==============================================================================================================
PROC SOpenTimChan:
REM' ==================================================================================
REM'                           Open a Timer Channel
REM'
REM' ENTERED WITH: NIL
REM'
REM' RETURNS: 
REM'          GTimerChan%       REM' Global Timer Channel ID
REM'
REM' =================================================================================
REM' DECLARE VARIABLES:
REM'
EXTERNAL GTimerReqFlag%    REM' Global Flag set to KTrue% if request for Timer has been made
EXTERNAL GTimerChan%       REM' Global Timer Channel ID

REM' Only Open a Channel if a Timer if it is not already running
IF GTimerReqFlag%=KFalse%
  iocheck%:(2,IOOPEN(GTimerChan%,"TIM:",-1))
ENDIF


ENDP
REM' ==============================================================================================================
PROC SCloseTimChan:
REM'======================================================================================
REM'                                Close Relative Timer channel
REM'
REM' ENTERED WITH: 
REM'          GTimerChan%       REM' Global Timer Channel ID
REM'
REM'RETURNS: NIL
REM'
REM'======================================================================================
REM' DECLARE VARIABLES:
REM'
EXTERNAL GTimerChan%       REM' Global Timer Channel ID

REM' Close the Timer Channel
IOCLOSE(GTimerChan%)


ENDP
REM' ==============================================================================================================
PROC cleanup%:(er1%)
REM' ==================================================================================
REM' If iocheck Error then Cleanup any outstanding Event/Timer requests before exiting
REM'
REM' ENTERED WITH:
REM'
REM' RETURNS: NIL
REM'
REM' ==================================================================================
REM' DECLARE VARIABLES:
REM'
EXTERNAL GTimerReqFlag%    REM' Global Flag set to KTrue% if request for Timer has been made
EXTERNAL GEventReqFlag%    REM' Global Flag set to KTrue% if request for event has been made
EXTERNAL GEventStat%       REM' Global Asynchronous Event request status word 
	

REM' Event Request outstanding
If GEventReqFlag%=KTrue%
  GETEVENTC(GEventStat%)
  GEventReqFlag%=KFalse%
ENDIF

REM' Relative Timer Request oustanding
If GTimerReqFlag%=KTrue%
  REM' End Timer
  EnTimer%:
  REM' Close the Timer Channel
  SCloseTimChan:
ENDIF


REM' Raise Error if one occurred
REM' IF er1%
REM'  RAISE er1%
REM'ENDIF
  
ENDP
REM' ==============================================================================================================
PROC FindPos:
REM'======================================================================
REM'                 Find Position
REM
REM'ENTERED WITH: Global Variables
REM
REM'RETURNS: NIL
REM
REM'======================================================================
REM'DECLARE VARIABLES:
Local C,C%,C$(10),D,ERFLAG%,N%,R,S,W%,X%
REM'A$ - Menu choice letter
REM'X% - Menu choice code
REM'ERFLAG% - Error Flag
REM'
EXTERNAL VY()         REM'Global Voyage Data
EXTERNAL IA,IO        REM'Global Lat& Long
EXTERNAL CurrentPage% REM' Global current Page - governs Menu actions and updating


REM' Show Title
ti:("Find Position")

REM' Set buttons to nulls
CurrentPage%=KNullPage%
REM' Set the Toolbar buttons
ToolBarButt:(KNullPage%)



REM'Ask user if start posn is Waypoint or Lat&Long
C%=1
dINIT ("Select Position From")
dCHOICE C%,"Type","Waypoint,Lat & Long"
REM' Show OK & Cancel buttons
dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%

REM' If user pressed Enter then continue
If DIALOG=KDButtonEnter%
  REM'If Waypoint selected then select a waypoint
  IF C%=1
    REM'Input start waypoint record number
    W%=WC:("From Waypoint",0,0)
    REM' If Waypoint record is 0 then user pressed cancel, so exit
    If W%=0
      RETURN
    ENDIF  
    REM'Read details of Waypoint; Lat & Long returned in IA & IO globals
    N%=WR:(W%)
  ENDIF
  REM'If Lat & Long selected then input a position
  IF C%=2
    gv:("From Position",3)
    N%=0
  ENDIF
  REM'
  REM' Show Title to clear screen
  ti:("Find Position")
  REM'Show start position
  REM'Show Waypoint number (if any) and Lat & Long
  gAT 10,40
  gPRINT "From:";
  IF N%<>0 :gPRINT "Waypoint Number # ";N% :ENDIF
  gAT 10,65
  gPRINT "Latitude:";O$:(IA,3);"  Longitude:";O$:(IO,4)
  REM'
  REM'Initialise Course
  C$=O$:(VY(4),5)
  REM'Loop until valid course input
  DO
    ERFLAG%=0
    REM'Open Dialog
    dINIT "Course & Distance"
    REM'Course
    dEDIT C$,"Course"
    REM'Distance
    dFLOAT D,"Distance",0,9900
    REM' Show OK & Cancel buttons
    dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
	REM' If user pressed Enter then continue
    If DIALOG=KDButtonEnter%
      REM'Convert & check course
      C=IN:(C$,7)
      REM'If error code of -999 returned then alert user & set flag
      IF C=-999 :ERFLAG%=-1 :ALERT("Your value of "+C$,"Is not correct.") :ENDIF
    ENDIF  	
  UNTIL ERFLAG%=0
  REM'Show course and distance
  gAT 10,90
  gPRINT "Course:";O$:(C,5);"  Distance:";O$:(D,6)
  REM'
  REM'Call DR to find new Lat&Long
  DR:(C,D,IA,IO)
  REM'
  REM'Display new Lat&Long
  gAT 10,115
  gPRINT "Latitude=";O$:(IA,3)
  gAT 10,140
  gPRINT "Longitude=";O$:(IO,4)
  REM'
  REM'Wait for Event/Keypress or Click on OK button
  WaitForOK:
ENDIF  


ENDP
REM' ==============================================================================================================
PROC CoDist:
REM ===================================================================
REM'   SAiling routine; Course & Distance by Mercator Sailing
REM
REM'ENTERED WITH: NIL
REM
REM'RETURNS: NIL
REM
REM'===================================================================
REM'DECLARE VARIABLES:
Local C%,E,F,N%,T$(10),W%,X%
REM'T$ - "From" or "To"
REM'C% - Choice indicator for type of position
REM'E - Latitude variable
REM'F - Longitude variable
REM'Z - RAD(Start Lat)
REM'Q - RAD(Dest Lat)
REM'L - User entered Longitude interval
Local DestN%  REM' Destination Waypoint Number
REM'
EXTERNAL VY()         REM'Global Voyage Data
EXTERNAL IA,IO        REM'Global Lat& Long
EXTERNAL AZ,DT        REM'Global Azimuth and Distance
EXTERNAL CurrentPage% REM' Global current Page - governs Menu actions and updating


REM' Show Title
ti:("Course & Distance")

REM' Set buttons to nulls
CurrentPage%=KNullPage%
REM' Set the Toolbar buttons
ToolBarButt:(KNullPage%)


REM'Ask user if start posn is Waypoint or Lat&Long
C%=1
dINIT ("Select Position From")
dCHOICE C%,"Type","Waypoint,Lat & Long"
REM' Show OK & Cancel buttons
dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
REM' If user pressed Enter then continue
if DIALOG=KDButtonEnter%
  REM'If Waypoint selected then select a waypoint
  IF C%=1
    REM'Input start waypoint record number
    W%=WC:("From Waypoint",0,0)
    REM' If Waypoint record is 0 then user pressed cancel, so exit
    If W%=0
      RETURN
    ENDIF  
    REM'Read details of Waypoint; Lat & Long returned in IA & IO globals
    N%=WR:(W%)
  ENDIF
  REM'If Lat & Long selected then input a position
  IF C%=2
    gv:((T$+" Position"),3)
    N%=0
  ENDIF
ENDIF
  
REM'Save Lat & Long
E=IA
F=IO
REM' Show Title to clear screen
ti:("Course & Distance")

REM' Get Destination Position
REM'Ask user if posn is Waypoint or Lat&Long
C%=1
dINIT ("Select Position To")
dCHOICE C%,"Type","Waypoint,Lat & Long"
REM' Show OK & Cancel buttons
dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
REM' If user pressed Enter then continue
if DIALOG=KDButtonEnter%
  REM'If Waypoint selected then select a waypoint
  IF C%=1
    REM'Input start waypoint record number
    W%=WC:("To Waypoint",0,0)
    REM' If Waypoint record is 0 then user pressed cancel, so exit
    If W%=0
      RETURN
    ENDIF  
    REM'Read details of Waypoint; Lat & Long returned in IA & IO globals
    DestN%=WR:(W%)
  ENDIF
  REM'If Lat & Long selected then input a position
  IF C%=2
    gv:((T$+" Position"),3)
    DestN%=0
  ENDIF
ENDIF

REM' Show Title to clear screen
ti:("Course & Distance")

REM'Show Waypoint number (if any) and Lat & Long for both Positions
REM' From Pos
gAT 10,40
gPRINT "From:";
IF N%<>0
  gPRINT "Waypoint Number #:";GEN$(N%,10)
ENDIF
gAT 10,65
gPRINT "Latitude:";O$:(E,3);"  Longitude:";O$:(F,4)
REM'
REM'To Pos
gAT 10,115
gPRINT "To:";
IF DestN%<>0
  gPRINT "Waypoint Number #:";GEN$(DestN%,10)
ENDIF
gAT 10,140
gPRINT "Latitude:";O$:(IA,3);"  Longitude:";O$:(IO,4)

REM'Call CD to find mercator course & distance
CD:(E,F,IA,IO)

REM'Show result
gAT 10,170
gPRINT "Course=";O$:(AZ,5);"  Distance=";O$:(DT,6)

REM'Wait for Event/Keypress or Click on OK button
WaitForOK:


ENDP
REM' ==============================================================================================================
PROC SpeedCoMg:
REM' ==============================================================================================================
REM'                   Calculate Course & Speed Made Good
REM'
REM' ENTERED WITH: NIL
REM'
REM'
REM' RETURNS: NIL
REM'
REM'
REM' ==============================================================================================================
REM'DECLARE VARIABLES:
Local C,C%,C$(10),D,ERFLAG%,N%,R,S,W%,X%
REM'A$ - Menu choice letter
REM'X% - Menu choice code
REM'ERFLAG% - Error Flag
REM'
EXTERNAL VY()         REM'Global Voyage Data
EXTERNAL IA,IO        REM'Global Lat& Long
EXTERNAL AZ,DT        REM'Global Azimuth and Distance
EXTERNAL CurrentPage% REM' Global current Page - governs Menu actions and updating


REM' Show Title
ti:("Course & Speed made good")

REM' Set buttons to nulls
CurrentPage%=KNullPage%
REM' Set the Toolbar buttons
ToolBarButt:(KNullPage%)



REM'Input course C & speed D
REM'Initialise variables
REM'Course
C$=O$:(VY(4),5)


REM'Loop until valid course input
DO
  ERFLAG%=0
  REM'Open Dialog
  dINIT "Course & Speed"
  REM'Course
  dEDIT C$,"Course"
  REM'Speed
  dFLOAT D,"Speed",0,99
  REM' Show OK & Cancel buttons
  dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
  REM' If user pressed Enter then continue
  If DIALOG=KDButtonEnter%
    REM'Convert & check course
    C=IN:(C$,7)
    REM'
    REM'If error code of -999 returned then alert user & set flag
    IF C=-999 :ERFLAG%=-1 :ALERT("Your value of "+C$,"Is not correct.") :ENDIF
  ENDIF  	
UNTIL ERFLAG%=0


REM'Show course and speed
gAT 10,40
gPRINT "Course:";O$:(C,5)
gAT 10,65
gPRINT "Speed:";O$:(D,6)


REM'Input Set S & rate R knots
C$=O$:(0.0,5)
REM'Loop until valid set input
DO
  ERFLAG%=0
  REM'Open Dialog
  dINIT "Current Set & Rate"
  REM'Set
  dEDIT C$,"Set"
  REM'Rate
  dFLOAT R,"Rate",0,99
  REM' Show OK & Cancel buttons
  dBUTTONS "OK",KDButtonEnter%,"Cancel",KDButtonEsc%
  REM' If user pressed Enter then continue
  If DIALOG=KDButtonEnter%
    REM'Convert & check set
    S=IN:(C$,7)
    REM'If error code of -999 returned then alert user & set flag
    IF S=-999 :ERFLAG%=-1 :ALERT("Your value of "+C$,"Is not correct.") :ENDIF
  ENDIF
UNTIL ERFLAG%=0


REM'Show Set and Rate
gAT 10,90
gPRINT "Set:";O$:(S,5)
gAT 10,115
gPRINT "Rate:";O$:(R,6)

REM'Call DR with Course & speed
DR:(C,D,0.,0.)

REM'Call DR with previous position, set & rate
DR:(S,R,IA,IO)

REM'Call CD to find course & speed made good
CD:(0.,0.,IA,IO)

REM'Show course & speed made good
gAT 10,140
gPRINT "Course made good=";O$:(AZ,5)
gAT 10,165
gPRINT "Speed made good=";O$:(DT,6)

REM'Wait for Event/Keypress or Click on OK button
WaitForOK:

ENDP
REM' ==============================================================================================================
Proc Check$:
REM' ==============================================================================================================
REM'               Read and Check the Machine's Unique ID
REM'
REM'
REM' ENTERED WITH: NIL
REM'
REM' RETURNS: Check$ - Machine UID
REM'  
REM' NOTES:
REM' Requires SYSTEM.OXH header
REM' The High and low parts of the UID are returned as long integers
REM' On the Series 5 the Machine Unique ID can be seen by choosing Machine - Information;
REM' On the Machine the value is shown in Hex rather than as long integers, with a "-"between each 4 characters
REM' e.g 1000-007B-AD47-5D22
REM' Using this proc with the WINS emulator will return "00" as no UID is present in the emulator
REM' ==============================================================================================================
REM' DECLARE VARIABLES:
Local Low&,High&    REM' Low and High parts of machine's UID
Local Check$(128)   REM' Machine's UID in Hex String form
Local MachUID$(128) REM' UID of Machine that program is installed to


REM' Read the current machine's UID
MACHINEUNIQUEID:(High&,Low&)

REM' Make up the UID into a string
Check$=HEX$(High&)+HEX$(Low&)

REM' Debug
REM' ALERT("High&=",GEN$(High&,20))
REM' ALERT("High Hex=",HEX$(High&))
REM' ALERT("Low&=",GEN$(Low&,20))
REM' ALERT("Low Hex=",HEX$(Low&))
REM' ALERT("Check$=",Check$)


REM' Read the installed UID from file


REM' Check that the program is running on the emulator or the correct machine
If (Check$<>"00") AND (Check$<>MachUID$)
  ALERT("Main Error","-999")
  STOP
ENDIF

REM' Return UID String
RETURN Check$


endp
REM' ==============================================================================================================
PROC LoadToolBitMaps:
REM' ==============================================================================================================
REM'               Load the ToolBar Bitmaps so they can be used as Icons on the Toolbar
REM'
REM'
REM' ENTERED WITH: NIL
REM'
REM' RETURNS:The loaded Bitmap IDs in the global ID& Variables
REM'  
REM' NOTES:
REM' Requires the BMP.OXH header and the file VOY5BAR.MBM in the program's directory
REM' ==============================================================================================================
REM' DECLARE VARIABLES:
Local BitMapFile$(255)  REM' Bitmap File to load Toolbar button Icons from
Local Index%            REM' Index
Local NoOfIcons%        REM' Number of Icons 
REM'
EXTERNAL GBarBit&()      REM' Toolbar Icon IDs
EXTERNAL GBarMask&()     REM' Toolbar Mask IDs


REM'DEFINE VARIABLES:
REM' Set Directory for User Data Files e.g Data etc
BitMapFile$=KFileDirectory$+"\Voy5Bar.mbm"
REM' Set Number of Icons
NoOfIcons%=8


REM' Set Error Trapping
ONERR ErrorTrap::


REM' Load the Toolbar bitmaps (1st bitmap in file is number 0)
Index%=1
DO
  GBarBit&(Index%)=BITMAPLOAD&:(BitMapFile$,(Index%-1)*2)
  GBarMask&(Index%)=BITMAPLOAD&:(BitMapFile$,(Index%-1)*2+1)
  REM' Increment Index
  Index%=Index%+1
UNTIL Index%>NoOfIcons%

REM' Unload the BitMaps
REM' BITMAPUNLOAD:(GBarBit&(1))
REM' BITMAPUNLOAD:(GBarMask&(1))


RETURN
REM' Error Trapping
ErrorTrap::
ONERR OFF
ALERT("LoadToolBitMaps Error "+GEN$(err,10),err$(err))

endp
REM' ==============================================================================================================
PROC ReadTextPortFile:
REM'=================================================================================
REM' OPL Utility Program to read Own Ports in text format into VOYAGEMASTER 5 file
REM'
REM' Written by Mike Harrison. Dolphin Maritime Software Ltd 
REM
REM' Version 1.0 STARTED: 20/09/98. FINISHED: 20/09/98
REM' UPDATES:
REM' 
REM'
REM'
REM'NOTES:
REM'For reading Waypoints see the ReadTextFile proc in Sightmaster 5
REM'The program reads Text files ex Voyagemaster 3 etc produced by the PortText program
REM'but may be adapted to read any form of text string.
REM'The maximum text line length is 256 chars.
REM
REM'=================================================================================
REM'DECLARE VARIABLES:
Local TFILE$(255)   REM'Name of text file to read from
Local WFILE$(255)   REM'Name of Own Ports file to write to
Local Tempf$(255)   REM'Name of Temporary file
Local C%            REM'Number of records in text file
Local I%            REM'Index and Item counter
Local W$(250)       REM'Item description string read from text file
Local RET%          REM'Return code from calls
Local H%            REM'File Handle for text file
Local FieldsRead%   REM'Number of Fields Read
REM'
Local PN$(250)   REM'ATT Number
Local N$(25)     REM'Name
Local TZ         REM'Timezone
Local LAT        REM'Lat
Local LON        REM'Long
Local HA%,HB%,HC%,HD%,HE%,HF%,HG%,HH%,HI%,HJ%,HK%,HL%,HM% REM'Harmonic constants



REM'DEFINE VARIABLES:
REM'Define search string for text file
TFILE$="C:\"+"OWNPORTS"+".TXT"
REM'Set Number of Ports converted to zero
I%=0


REM'Get text filename to read from
REM' Get the New Filename from the User
Tempf$=OpenFileDialog$:(TFILE$,0,0,0)
REM' If the user did not press Esc then continue
if len(Tempf$)>0
  REM
  REM'Open text file to read from in text format (each line ends in CR+LF)
  REM'Uses Mode=$0000 (existing file) ORed with File format=$0020 (Text File)
  RET%=IOOPEN(H%,Tempf$,32)
  REM'Abort if Open file is unsuccessful
  IF RET%<0
    RAISE RET%
    STOP
  ENDIF
  REM'
  FieldsRead%=0
  REM'
  REM'LOOP and read each sentence from text file into variables
  WHILE RET%>=0
    REM'Set W$ to null
    W$=""
    REM'Read sentence from text file
    RET%=IOREAD(H%,(ADDR(W$)+1),255)
    REM'If read OK then continue
    IF RET%>0
      REM'Poke length of string returned so W$ returns as normal OPL string
      POKEB ADDR(W$),RET%
      REM'ALERT("Read String W$=",W$)
	  REM'Increment the number of fields read
	  FieldsRead%=FieldsRead%+1
      REM'
      REM'Convert read strings to required Port format
	  If FieldsRead%=1
      	PN$=W$
	  ElseIf FieldsRead%=2
      	N$=W$
	  ElseIf FieldsRead%=3
		TZ=VAL(W$)
	  ElseIf FieldsRead%=4
      	LAT=VAL(W$)
	  ElseIf FieldsRead%=5
      	LON=VAL(W$)
	  ElseIf FieldsRead%=6
      	HA%=VAL(W$)
	  ElseIf FieldsRead%=7
      	HB%=VAL(W$)
	  ElseIf FieldsRead%=8
      	HC%=VAL(W$)
	  ElseIf FieldsRead%=9
      	HD%=VAL(W$)
	  ElseIf FieldsRead%=10
      	HE%=VAL(W$)
	  ElseIf FieldsRead%=11
      	HF%=VAL(W$)
	  ElseIf FieldsRead%=12
      	HG%=VAL(W$)
	  ElseIf FieldsRead%=13
      	HH%=VAL(W$)
	  ElseIf FieldsRead%=14
      	HI%=VAL(W$)
	  ElseIf FieldsRead%=15
      	HJ%=VAL(W$)
	  ElseIf FieldsRead%=16
      	HK%=VAL(W$)
	  ElseIf FieldsRead%=17
      	HL%=VAL(W$)
	  ElseIf FieldsRead%=18
      	HM%=VAL(W$)
	  ENDIF
      REM'
      REM'
      REM'If all fields read then Open the Own Ports file to write to
      If FieldsRead%=18 
        OF:(6,0)
          REM'Write to the Fields
          B.PN$=PN$
          B.N$=N$
          B.TZ=TZ
          B.LAT=LAT
          B.LON=LON
          B.A%=HA%
          B.B%=HB%
          B.C%=HC%
          B.D%=HD%
          B.E%=HE%
          B.F%=HF%
          B.G%=HG%
          B.H%=HH%
          B.I%=HI%
          B.J%=HJ%
          B.K%=HK%
          B.L%=HL%
          B.M%=HM%
          APPEND
          REM'Close the file
        CLOSE
        REM'Increment Index
        I%=I%+1
        REM' Set number of fields read back to zero
        FieldsRead%=0
      ENDIF
      REM'  
    ENDIF
  REM'End of loop
  ENDWH
  REM'
 REM'Tell user how many Waypoints converted
 ALERT(GEN$((I%-1),8),"Ports Converted")
 REM'
 REM'CLOSE files
 REM'Close Text file
 RET%=IOCLOSE(H%)
 REM'End of conversion
ENDIF

ENDP
REM' ==============================================================================================================
