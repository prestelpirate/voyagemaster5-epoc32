	MidText:(32,"VOYAGEMASTER 5",KFontTimesNormal15&,8+1)
	MidText:(64,"Voyage and Tide Planning",KFontTimesNormal15&,8+1)
	MidText:(96,"Version "+KAppVersion$,KFontTimesNormal11&,1)
	MidText:(112,kCountryVer$,KFontTimesNormal11&,1)
	MidText:(128,"Copyright Dolphin Maritime Software Ltd",KFontTimesNormal11&,1)
	MidText:(144,"713 Cameron House, White Cross",KFontTimesNormal11&,1)
	MidText:(160,"LANCASTER LA14XQ, UK",KFontTimesNormal11&,1)
	MidText:(176,"Tel & Fax 01524 841946",KFontTimesNormal11&,1)
    REM' Colin Jones Text
	REM' MidText:(208,"For use by COLIN JONES ONLY",KFontTimesNormal15&,8+1)
	MidText:(224,"Tap the Screen or Press a Key to Continue",KFontTimesNormal15&,1)


	REM' Draw a Border round the screen
	Border:
    

	REM' Colin Jones Test for Date
    REM' if (MONTH>=6) AND (YEAR>=1998)
	REM'   ALERT("Unable to run Program")
    REM'   STOP
    REM' endif  

 endp

REM' ==============================================================================================================
proc initTBar:
	REM' ***************************************************************
	REM' Initialise the Toolbar and Toolbar Title and Buttons
	REM'
	REM' ENTERED WITH: NIL
	REM' RETURNS: NIL
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	EXTERNAL ScrWid%          REM' Global pixel width initially
	EXTERNAL ScrHght%         REM' Global pixel height initially
    EXTERNAL GButtonkey%()	  REM' Global Button Hot key ASCII codes
    EXTERNAL GButtontext$()   REM' Global Button Titles    

	REM' Initialise the Toolbar Title, Width and Height
	TBarInit:(KAppName$,ScrWid%,ScrHght%)


	REM' Set the Toolbar buttons
    ToolBarButt:(1)

endp

REM' ==============================================================================================================
proc RetEvent:(AutoFlag%)
    REM' ========================================================================================
	REM'              Handle Menu and Toolbar events and System commands
    REM'  (Returns other Pointer and Keypress Events to the calling procedure - so they may be handled there)
	REM'
	REM' ENTERED WITH: AutoFlag% - Set to KTrue% if a Timer is to be started and returned
	REM'
	REM' RETURNS:  evType&    - Global value of Event Type 
    REM' 		  event&()    - Global Event values
	REM'		  MenuChoice% - Global Hot Key code if a Menu Item was chosen e.g %s or Zero
    REM'		  GbutChoice% - Numer of Toolbar button pressed (1 to 4) or zero
    REM'
    REM' ========================================================================================
	REM' DECLARE VARIABLES:
	Local command$(255)
	Local cmdLetter$(1)
    REM'
    EXTERNAL HotKMod%      REM' Global Hot Key Modifier
	EXTERNAL event&()      REM' Global Event Values array 
	EXTERNAL evType&	   REM' Event Type
	EXTERNAL GCurrentWin%  REM' Current Window ID
	EXTERNAL MenuChoice%   REM' Global Menu Item hotkey return code e.g %a
	EXTERNAL GButChoice%   REM' Global Button number chosen or Zero
    REM'
    EXTERNAL GEventStat%       REM' Global Asynchronous Event request status word 
    EXTERNAL GEventReqFlag%    REM' Global Flag set to KTrue% if request for event has been made
    EXTERNAL GTimerStat%       REM' Global Asynchronous Timer request status word 
    EXTERNAL GTimerReqFlag%    REM' Global Flag set to KTrue% if request for Timer has been made
    EXTERNAL GTimerChan%       REM' Global Timer Channel ID
	EXTERNAL GTimerComp%       REM' Global Timer completed Flag - set to KTrue% if Timer completed

	REM' DEFINE VARIABLES:
    REM' Set Menu choice to default null
    MenuChoice%=0
	REM' Set button choice to default null
	GButChoice%=0
    REM' Set the Timer completed flag to False
	GTimerComp%=KFalse%
    REM' Set the event request flag to false, so an event is requested
    GEventReqFlag%=KFalse%
    
	REM' Loop continuously
	while 1
    	REM' Wait for a 32 bit Event
        REM' GetEvent32 event&()
        REM'
		REM' If the AutoFlag is set and a Timer has not been requested then start one
        If AutoFlag%=KTrue%
          if GTimerReqFlag%=KFalse%
		    REM' Open the Relative timer channel
            SOpenTimChan:
            REM'Start the relative Timer and set the requested flag to KTrue%
            STimer%:
 	      Endif
          REM'
		Endif
		REM'
        REM' Request an asynchronous event
        If GEventReqFlag%=KFalse%
          GetEventA32 GEventStat%,event&()
          GEventReqFlag%=KTrue%
       	Endif
        REM'Wait for something to happen
        IOWAIT
        

        REM' If a Timer was requested and it was a Timer Event then handle it
        if GTimerReqFlag%=KTrue%
          If GTimerStat%<>KErrFilePending%
            REM' Set the flag to false
            GTimerReqFlag%=KFalse%
            REM' Close the Timer Channel
            SCloseTimChan:
            REM' Cancel any Event Request outstanding
            If GEventReqFlag%=KTrue%
              GETEVENTC(GEventStat%)
              GEventReqFlag%=KFalse%
            ENDIF
            REM'
            REM' Set the Timer completed flag to True
	        GTimerComp%=KTrue%
            REM' Set the Event type to null
		    evType&=0
            REM' Break out of the loop
            break
		    REM'
          ENDIF
          REM'
        ENDIF    

        
        REM' If it was a GETEVENT then handle it
        If GEventStat%<>KErrFilePending%
          REM' Set the flag to false
          GEventReqFlag%=KFalse%
          REM'
          REM' Cancel any Relative Timer Request oustanding
          If GTimerReqFlag%=KTrue%
            REM' End Timer
            EnTimer%:
            REM' Close the Timer Channel
            SCloseTimChan:
          ENDIF
          REM'
          REM' Get the Event Type
		  evType&=event&(KEvaType%)
		  REM'
		  REM' If it is a system command then obey it
          if evType&=KEvCommand&
        	REM' Get the command
			command$=getcmd$
			cmdLetter$=left$(command$,1)
			command$=right$(command$,len(command$)-1)
            REM'
            REM' If exit ("X")  then Exit program
			if cmdLetter$=KGetCmdLetterExit$
			  cmdExit:
            REM' Open File ("O")   
			elseif cmdLetter$=KGetCmdLetterOpen$
			  openFile:(command$)
            REM' Create File ("C")   
			elseif cmdLetter$=KGetCmdLetterCreate$
			  REM' Create the file
			  createFile:(command$)
			  REM' Open the file and show it
			  openFile:(command$)
              REM' Get the Site Details (Name,Date etc)
              REM' UpdateSiteDetails:
			endif
          endif
          REM'    
          REM' If it was a pointer event then ALWAYS offer it to the Toolbar first
		  if evType&=KEvPtr&
            REM' Offer an Event to the Toolbar using Psion code - returns -1 and GButChoice% if used or 0 if not used
		    if TBarOffer%:(event&(KEvAPtrOplWindowId%),event&(KEvAPtrType%),event&(KEvAPtrPositionX%),event&(KEvAPtrPositionY%))
              REM' If used on the Toolbar then set the Event Type to null 
		      evType&=0
            endif  
            REM' Break out of the loop (with GbutChoice% set if a button was clicked)
            break
          endif
          REM'
          REM' If it was a "Pointer Enter" in the program Window thenbreak out of the loop     
		  if evType&=KEvPtrEnter& and (event&(KEvAPtrOplWindowId%)=GCurrentWin%)
           	REM' If not used then break out of the loop
			break
          endif
          REM'     
          REM' If it was a null event then continue the loop
		  if evType&=0 REM' Null event
			continue
          endif    
          REM'
          REM' If it was a Sidebar menu keypress or a keypress then evaluate it
	      if (evType&=KKeySidebarMenu%) or ((evType& and $400)=0)
			if (evType&<>KKeySidebarMenu%) and (evType&<>KKeyMenu%) and ((event&(KEvAKMod%) and HotKMod%)=0)
				break
			endif
          	REM' See if it was a valid Menu command (ret -1 if command, else 0)
            if not offrCmd%:(event&(KEvaType%),event&(KEvAKMod%))
				break
			endif
            REM' If the User chose a Menu Item in OffrCmd% then break out of the loop and return that too in global MenuChoice%
            If MenuChoice%<>0
              REM' Set the Event Type to null 
		      evType&=0
              REM' Break out of the loop
              break
            endif  
          endif
        REM'End of GETEVENT handling
        ENDIF
        REM'
	endwh

endp

REM' ==============================================================================================================
proc processCmdLine:
	REM' ************************************************************************************
	REM'  Process the Command Line Argument passed to the Program and Open file as required
	REM'
	REM' ENTERED WITH: NIL
	REM'
	REM' RETURNS: NIL
	REM'
	REM' ************************************************************************************
	REM' DECLARE VARIABLES:
	Local file$(255)   REM' Filename
	Local command$(1)  REM' Command

	REM' DEFINE VARIABLES:
    REM' Read the System command
	command$=cmd$(3)

	REM' "R"=Run Program from Extras toolbar
	if command$="R"
		REM' See if a last used file exists and is valid
		file$=GetLastUsedFile$:(KUidOplDolphinApp&)
		REM' If the File exists then open it and return
		if file$<>"" and exist(file$)
			openFile:(file$)
			return
		endif
        REM' If No last file but a valid filename was passed in cmd$(2) then set command to open it
		if exist(cmd$(2))
			command$="O"
        REM' Else set a command to create this file    
		else
			command$="C"
		endif
	endif

	REM' get the Filename to Open or Create
	file$=cmd$(2)

	REM' Open or Create the file
	if command$="O"
		OpenFile:(file$)
	elseif command$="C"
		REM' Create the file
		CreateFile:(file$)
        REM' Open the file and show it
		OpenFile:(file$)
	endif

endp

REM' ==============================================================================================================
proc UpdateTBarTitle:
	REM' ***************************************************************
	REM'              Update Tool Bar Title
	REM'
	REM' ENTERED WITH: NIL
	REM' RETURNS: NIL
	REM' ***************************************************************
	REM' DECLARE VARIABLES:
	Local off%(6)
	Local file$(255)

	REM' Get the current document Name
	file$=getdoc$

	REM' Extract the Filename
	file$=parse$(file$,"",off%())

	REM' Set the Tool Bar Title
   	TBarSetTitle:(right$(file$,len(file$)-off%(4)+1))

endp
	

